---
import { defaultLocale } from "@/i18n/config";
import { siteInfo } from "@/data/site";

// 纯静态发布不能依赖服务端重定向；根路径只输出一个 noindex 的立即跳转页，避免生成没有 locale 的第二份首页内容。
const defaultLocaleHref = `/${defaultLocale}/`;
const canonicalUrl = new URL(defaultLocaleHref, siteInfo.url);
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${defaultLocaleHref}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>Redirecting to Fetarute</title>
  </head>
  <body>
    <a href={defaultLocaleHref}>Continue to Fetarute</a>
  </body>
</html>
