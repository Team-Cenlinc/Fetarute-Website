---
import JourneyFooter from "@/components/JourneyFooter.astro";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";

/** 首页仅提供文案和探索线颜色；共享页尾保留滚动交接所需的选择器与动态变量。 */
export interface Props {
  locale: Locale;
  lineColor: string;
}

const { locale, lineColor } = Astro.props;
const copy = getMessages(locale).home.footer;
---

<JourneyFooter
  id="footer"
  title={copy.title}
  description={copy.description}
  lineColor={lineColor}
  returnHref="#home"
  returnLabel={copy.restartLabel}
/>
