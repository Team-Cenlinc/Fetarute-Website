---
import arrowUpIcon from "@phosphor-icons/core/assets/bold/arrow-up-bold.svg?raw";
import arrowUpRightIcon from "@phosphor-icons/core/assets/bold/arrow-up-right-bold.svg?raw";
import fetaruteLogo from "@/assets/fetarute-branding/fetarute-logo.svg?raw";
import { externalDestinations, siteInfo } from "@/data/site";
import { localeMetadata, locales, type Locale } from "@/i18n/config";
import { getLocalizedRelativeUrl } from "@/i18n/links";
import { getMessages } from "@/i18n/messages";

/** 首页铁路叙事页尾属性；探索线颜色由正式线路数据注入，避免页尾另造品牌橙色。 */
export interface Props {
  /** 当前静态路由语言。 */
  locale: Locale;
  /** 与续行正文右轨完全相同的探索线语义色。 */
  lineColor: string;
}

const { locale, lineColor } = Astro.props;
const messages = getMessages(locale);
const footerMessages = messages.home.footer;
const currentYear = new Date().getFullYear();
---

<footer
  class="home-footer"
  id="footer"
  data-home-footer
  style={`--home-footer-line-color: ${lineColor};`}
>
  <span class="home-footer__track" aria-hidden="true"></span>

  <div class="home-footer__content">
    <div class="home-footer__introduction">
      <div class="home-footer__closing-copy">
        <h2>{footerMessages.title}</h2>
        <p class="home-footer__description">{footerMessages.description}</p>
      </div>
      <nav class="home-footer__directions" aria-label={messages.home.onward.serviceGuideLabel}>
        <a
          class="home-footer__direction"
          href={externalDestinations.wiki.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${messages.externalDestinationLabels.wiki} (${messages.externalLinkNewTabHint})`}
        >
          <span>{messages.externalDestinationLabels.wiki}</span>
          <span class="home-footer__direction-icon" aria-hidden="true" set:html={arrowUpRightIcon}></span>
        </a>
        <a class="home-footer__direction home-footer__restart" href="#home">
          <span>{footerMessages.restartLabel}</span>
          <span class="home-footer__direction-icon" aria-hidden="true" set:html={arrowUpIcon}></span>
        </a>
      </nav>
    </div>

    <div class="home-footer__signature">
      <div class="home-footer__brand">
        <span class="home-footer__wordmark" aria-hidden="true" set:html={fetaruteLogo}></span>
        <p class="home-footer__legal">© {currentYear} {siteInfo.name}</p>
      </div>
      <nav class="home-footer__languages" aria-label={messages.languageNavigationLabel}>
        {
          locales.map((alternateLocale) => (
            <a
              href={getLocalizedRelativeUrl(alternateLocale, "", "footer")}
              lang={localeMetadata[alternateLocale].languageTag}
              hreflang={localeMetadata[alternateLocale].languageTag}
              aria-current={alternateLocale === locale ? "page" : undefined}
            >
              {localeMetadata[alternateLocale].label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .home-footer {
    /* 页尾轨道宽度与续行探索线保持同一比例，并在小屏切换为左侧窄轨。 */
    --home-footer-track-width: clamp(36px, 3.23vw, 62px);
    /* 无脚本与减少动态模式默认直接显示最终态；滚动增强只在 Footer 将进入视口时覆写。 */
    --home-footer-content-offset: 0px;
    --home-footer-content-opacity: 1;
    /* 页尾轨道复用续行桌面右轨公式，保证 section 与 footer 在任意桌面宽度都原位接缝。 */
    --home-footer-right-track-x: calc(77.71vw + var(--home-footer-track-width) * 3.01613);
    position: relative;
    /* Footer 是首页网格子项；允许窄屏收缩，避免英文最小内容宽度撑开整页。 */
    min-width: 0;
    min-height: 300px;
    overflow: clip;
    background: var(--palette-text);
    color: var(--palette-surface);
  }

  .home-footer__track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--home-footer-right-track-x);
    width: var(--home-footer-track-width);
    background: var(--home-footer-line-color);
  }

  .home-footer__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: auto;
    min-height: inherit;
    margin-right: calc(100% - var(--home-footer-right-track-x) + 72px);
    padding: 40px 0 24px 7.92vw;
    opacity: var(--home-footer-content-opacity);
    transform: translateY(var(--home-footer-content-offset));
  }

  .home-footer__introduction {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 0.42fr);
    gap: 12px clamp(32px, 4vw, 72px);
    align-items: start;
  }

  /* 结束语是一组独立文案，右侧链接的高度不再拉大标题与说明的行距。 */
  .home-footer__closing-copy {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .home-footer__introduction h2,
  .home-footer__description,
  .home-footer__legal {
    margin: 0;
  }

  .home-footer__introduction h2 {
    font-size: clamp(28px, 2.6vw, 42px);
    font-weight: 700;
    line-height: 1.18;
    text-wrap: balance;
  }

  .home-footer__description {
    max-width: 48ch;
    font-size: clamp(14px, 0.94vw, 17px);
    font-weight: 480;
    line-height: 1.65;
    opacity: 0.76;
  }

  .home-footer__directions {
    display: grid;
    grid-column: 2;
    gap: 12px;
  }

  .home-footer__direction {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    color: inherit;
    font-size: clamp(14px, 1vw, 18px);
    font-weight: 700;
    text-decoration: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.32em;
    min-height: 44px;
    line-height: 1.4;
  }

  .home-footer__direction-icon {
    display: inline-grid;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 12px;
    place-items: center;
    background: var(--palette-fetarute-info);
    color: var(--palette-fetarute-info-text);
    transition: transform 180ms var(--motion-header-standard-spatial);
  }

  .home-footer__restart .home-footer__direction-icon {
    background: var(--palette-fetarute-exit);
    color: var(--palette-fetarute-exit-text);
  }

  .home-footer__direction:hover {
    text-decoration-line: underline;
  }

  .home-footer__direction:focus-visible,
  .home-footer__languages a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .home-footer__direction:active,
  .home-footer__languages a:active {
    opacity: 0.72;
  }

  .home-footer__direction:hover .home-footer__direction-icon {
    transform: translateY(-3px);
  }

  .home-footer__signature {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 2px solid color-mix(in srgb, currentColor 24%, transparent);
  }

  .home-footer__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    min-width: 0;
  }

  .home-footer__wordmark {
    display: block;
    flex: 0 0 120px;
    width: 120px;
    line-height: 0;
  }

  .home-footer__wordmark :global(svg) {
    width: 100%;
    height: auto;
  }

  .home-footer__direction-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-footer__legal {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.72;
  }

  .home-footer__languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    align-items: center;
  }

  .home-footer__languages a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    font-size: 13px;
    font-weight: 480;
    text-decoration: none;
    text-underline-offset: 0.4em;
    white-space: nowrap;
    opacity: 0.76;
  }

  .home-footer__languages a:is([aria-current="page"], :hover) {
    text-decoration: underline;
    opacity: 1;
  }

  @media (max-width: 1023px) {
    .home-footer {
      --home-footer-track-width: clamp(20px, 5.8vw, 30px);
      min-height: 320px;
    }

    .home-footer__track {
      left: 7vw;
    }

    .home-footer__content {
      width: auto;
      margin-right: 0;
      padding: 34px 22px 24px max(calc(7vw + var(--home-footer-track-width) + 50px), 20.9vw);
    }

    .home-footer__introduction {
      display: block;
    }

    .home-footer__introduction h2 {
      max-width: 11ch;
      font-size: clamp(28px, 8vw, 38px);
    }

    .home-footer__description {
      max-width: 27ch;
      margin-top: 10px;
      font-size: clamp(14px, 3.8vw, 17px);
    }

    .home-footer__directions {
      max-width: 340px;
      margin-top: 28px;
    }

    .home-footer__signature {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      margin-top: 28px;
      padding-top: 24px;
    }

    .home-footer__brand {
      flex-direction: column;
      align-items: flex-start;
    }

    .home-footer__wordmark {
      flex-basis: auto;
    }

    .home-footer__languages {
      gap: 0 16px;
    }
  }

  @media (forced-colors: active), (prefers-contrast: more) {
    .home-footer__track {
      border: 2px solid currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-footer__direction-icon,
    .home-footer__direction:hover .home-footer__direction-icon {
      transition: none;
      transform: none;
    }

    .home-footer__content {
      opacity: 1;
      transform: none;
    }
  }
</style>
