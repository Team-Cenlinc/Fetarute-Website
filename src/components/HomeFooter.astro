---
import arrowUpIcon from "@phosphor-icons/core/assets/bold/arrow-up-bold.svg?raw";
import { siteInfo } from "@/data/site";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";

/** 首页铁路叙事页尾属性；探索线颜色由正式线路数据注入，避免页尾另造品牌橙色。 */
export interface Props {
  /** 当前静态路由语言。 */
  locale: Locale;
  /** 与续行正文右轨完全相同的探索线语义色。 */
  lineColor: string;
}

const { locale, lineColor } = Astro.props;
const messages = getMessages(locale);
const footerMessages = messages.home.footer;
const currentYear = new Date().getFullYear();
---

<footer
  class="home-footer"
  id="footer"
  data-home-footer
  style={`--home-footer-line-color: ${lineColor};`}
>
  <span class="home-footer__track" aria-hidden="true"></span>

  <div class="home-footer__content">
    <div class="home-footer__introduction">
      <h2>{footerMessages.title}</h2>
      <p class="home-footer__description">{footerMessages.description}</p>
      <a class="home-footer__restart" href="#home">
        <span>{footerMessages.restartLabel}</span>
        <span aria-hidden="true" set:html={arrowUpIcon}></span>
      </a>
    </div>

    <p class="home-footer__legal">© {currentYear} {siteInfo.name}</p>
  </div>
</footer>

<style>
  .home-footer {
    /* 页尾轨道宽度与续行探索线保持同一比例，并在小屏切换为左侧窄轨。 */
    --home-footer-track-width: clamp(36px, 3.23vw, 62px);
    /* 无脚本与减少动态模式默认直接显示最终态；滚动增强只在 Footer 将进入视口时覆写。 */
    --home-footer-content-offset: 0px;
    --home-footer-content-opacity: 1;
    /* 页尾轨道复用续行桌面右轨公式，保证 section 与 footer 在任意桌面宽度都原位接缝。 */
    --home-footer-right-track-x: calc(77.71vw + var(--home-footer-track-width) * 3.01613);
    position: relative;
    min-height: 232px;
    overflow: clip;
    background: var(--palette-text);
    color: var(--palette-canvas);
  }

  .home-footer__track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--home-footer-right-track-x);
    width: var(--home-footer-track-width);
    background: var(--home-footer-line-color);
  }

  .home-footer__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: min(64vw, 980px);
    min-height: inherit;
    padding: 36px 0 28px 7.92vw;
    opacity: var(--home-footer-content-opacity);
    transform: translateY(var(--home-footer-content-offset));
  }

  .home-footer__introduction {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px clamp(32px, 4vw, 72px);
    align-items: center;
  }

  .home-footer__introduction h2,
  .home-footer__description,
  .home-footer__legal {
    margin: 0;
  }

  .home-footer__introduction h2 {
    grid-column: 1;
    font-size: clamp(28px, 2.4vw, 44px);
    font-weight: 700;
    line-height: 1.08;
    text-wrap: balance;
  }

  .home-footer__description {
    grid-column: 1;
    max-width: 42ch;
    font-size: clamp(14px, 0.94vw, 17px);
    font-weight: 600;
    line-height: 1.45;
  }

  .home-footer__restart {
    display: inline-flex;
    grid-column: 2;
    grid-row: 1 / span 2;
    gap: 0.55em;
    align-items: center;
    color: inherit;
    font-size: clamp(14px, 1vw, 18px);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.32em;
  }

  .home-footer__restart span:last-child {
    display: inline-grid;
    width: 1.15em;
    height: 1.15em;
    place-items: center;
  }

  .home-footer__restart:hover,
  .home-footer__restart:focus-visible {
    color: var(--home-footer-line-color);
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .home-footer__restart:active {
    opacity: 0.72;
  }

  .home-footer__restart span:last-child :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-footer__legal {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.72;
  }

  @media (max-width: 1023px) {
    .home-footer {
      --home-footer-track-width: clamp(20px, 5.8vw, 30px);
      min-height: 286px;
    }

    .home-footer__track {
      left: 7vw;
    }

    .home-footer__content {
      width: auto;
      padding: 34px 22px 24px max(calc(7vw + var(--home-footer-track-width) + 50px), 20.9vw);
    }

    .home-footer__introduction {
      display: block;
    }

    .home-footer__introduction h2 {
      max-width: 11ch;
      font-size: clamp(28px, 8vw, 38px);
    }

    .home-footer__description {
      max-width: 27ch;
      margin-top: 10px;
      font-size: clamp(14px, 3.8vw, 17px);
    }

    .home-footer__restart {
      margin-top: 22px;
    }
  }

  @media (forced-colors: active), (prefers-contrast: more) {
    .home-footer__track {
      border: 2px solid currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-footer__content {
      opacity: 1;
      transform: none;
    }
  }
</style>
