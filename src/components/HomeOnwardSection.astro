---
import qqPortalGroupQr from "@/assets/pages/home/qq-portal-group-qr.svg?raw";
import arrowSquareOutIcon from "@phosphor-icons/core/assets/bold/arrow-square-out-bold.svg?raw";
import arrowUpRightIcon from "@phosphor-icons/core/assets/bold/arrow-up-right-bold.svg?raw";
import bookOpenTextIcon from "@phosphor-icons/core/assets/bold/book-open-text-bold.svg?raw";
import caretDoubleDownIcon from "@phosphor-icons/core/assets/bold/caret-double-down-bold.svg?raw";
import checkIcon from "@phosphor-icons/core/assets/bold/check-bold.svg?raw";
import copyIcon from "@phosphor-icons/core/assets/bold/copy-bold.svg?raw";
import hardHatIcon from "@phosphor-icons/core/assets/bold/hard-hat-bold.svg?raw";
import mouseScrollIcon from "@phosphor-icons/core/assets/bold/mouse-scroll-bold.svg?raw";
import usersThreeIcon from "@phosphor-icons/core/assets/bold/users-three-bold.svg?raw";
import { externalDestinations, onwardDestinations, onwardEntryPoints } from "@/data/site";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";

/** 首页“续行”内容页属性；线路色从正式铁路数据注入，语言控制整页导视。 */
export interface Props {
  /** 当前静态路由语言，保证三种公开版本拥有一致的 PIDS 和入口说明。 */
  locale: Locale;
  /** 从“续行”出站线路数据导出的轨道色，不能在组件内重新猜测。 */
  lineColor: string;
}

const { locale, lineColor } = Astro.props;
const messages = getMessages(locale);
const onwardMessages = messages.home.onward;
const qqPortalGroupNumber = onwardEntryPoints.qqPortalGroupNumber;
const titleId = "home-onward-content-title";
---

<section
  class="home-onward"
  data-home-onward-content
  data-home-onward-locale={locale}
  data-home-onward-board-state="destinations"
  aria-labelledby={titleId}
  style={`--home-onward-line-color: ${lineColor};`}
>
  <!-- 探索线从前一段 Section Breaker 的右侧竖轨原位接续，并在低矮页尾继续贯穿到底。 -->
  <span class="home-onward__route-track" data-home-onward-route-track aria-hidden="true"></span>

  <header class="home-onward__introduction">
    <span class="home-onward__station-marker" aria-hidden="true"></span>
    <div class="home-onward__introduction-copy">
      <p class="home-onward__kicker">{onwardMessages.invitationKicker}</p>
      <h2 id={titleId}>
        <span>{onwardMessages.invitation[0]}</span>{" "}
        <span>{onwardMessages.invitation[1]}</span>
      </h2>
      <p class="home-onward__invitation-description">{onwardMessages.invitationDescription}</p>
    </div>
  </header>

  <div class="home-onward__journey" data-home-onward-journey>
    <div class="home-onward__stage">
      <!-- 桌面支撑柱从 PIDS 背后落到底边；小屏改由探索线本身直接承托两块导视。 -->
      <span class="home-onward__pids-support" aria-hidden="true">
        <span class="home-onward__pids-support-fill"></span>
      </span>

      <div class="home-onward__board-area">
        <div class="home-onward__board-shell">
          <div class="home-onward__board-screen">
            <div
              class="home-onward__board-navigation"
              data-home-onward-board-navigation
              role="group"
              aria-label={onwardMessages.boardNavigationLabel}
              hidden
            >
              <button
                type="button"
                data-home-onward-select-board="destinations"
                aria-pressed="true"
                aria-controls="home-onward-destinations"
              >
                {onwardMessages.destinationsLabel}
              </button>
              <button
                type="button"
                data-home-onward-select-board="help"
                aria-pressed="false"
                aria-controls="home-onward-help"
              >
                {onwardMessages.firstVisitLabel}
              </button>
            </div>
            <section
              id="home-onward-destinations"
              class="home-onward__board home-onward__board--destinations"
              data-home-onward-destination-board
              aria-label={onwardMessages.destinationBoardLabel}
            >
            <table>
              <thead>
                <tr>
                  <th scope="col">{onwardMessages.platformColumn}</th>
                  <th scope="col">{onwardMessages.destinationColumn}</th>
                  <th scope="col">{onwardMessages.actionColumn}</th>
                </tr>
              </thead>
              <tbody>
                {
                  onwardDestinations.map((destination, index) => {
                    const destinationLabel = messages.onwardDestinationLabels[destination.key];

                    return (
                      <tr>
                        <td>{String(index + 1)}</td>
                        <td>{destinationLabel}</td>
                        <td>
                          <a
                            href={destination.href}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`${destinationLabel} · ${onwardMessages.openMapLabel} (${messages.externalLinkNewTabHint})`}
                          >
                            <span>{onwardMessages.openMapLabel}</span>
                            <span aria-hidden="true" set:html={arrowSquareOutIcon}></span>
                          </a>
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
            <button
              class="home-onward__ticker"
              type="button"
              data-home-onward-scroll-hint
            >
              <span aria-hidden="true" set:html={mouseScrollIcon}></span>
              <span>{onwardMessages.destinationTicker}</span>
              <span
                class="home-onward__ticker-arrow"
                aria-hidden="true"
                set:html={caretDoubleDownIcon}
              ></span>
            </button>
            </section>

            <section
              id="home-onward-help"
              class="home-onward__board home-onward__board--help"
              data-home-onward-help-board
              aria-label={onwardMessages.helpTitle}
              aria-hidden="true"
              inert
            >
            <div class="home-onward__help-content">
              <div class="home-onward__help-copy">
                <p class="home-onward__help-title">{onwardMessages.helpTitle}</p>
                <p>{onwardMessages.helpDescription}</p>
              </div>
              <button
                class="home-onward__qq-copy"
                type="button"
                data-home-onward-copy-qq
                data-copy-value={qqPortalGroupNumber}
                data-copy-label={onwardMessages.copyQqGroupLabel}
                data-copied-label={onwardMessages.copiedQqGroupLabel}
                data-copy-failed-label={onwardMessages.copyQqGroupFailedLabel}
              >
                <span
                  class="home-onward__qq-copy-icon"
                  aria-hidden="true"
                  set:html={usersThreeIcon}
                ></span>
                <span class="home-onward__qq-copy-meta">
                  <small>{onwardMessages.qqPortalGroupLabel}</small>
                  <strong>{qqPortalGroupNumber}</strong>
                </span>
                <span class="home-onward__qq-copy-action">
                  <span
                    class="home-onward__qq-copy-action-icon home-onward__qq-copy-action-icon--copy"
                    aria-hidden="true"
                    set:html={copyIcon}
                  ></span>
                  <span
                    class="home-onward__qq-copy-action-icon home-onward__qq-copy-action-icon--done"
                    aria-hidden="true"
                    set:html={checkIcon}
                  ></span>
                  <span data-home-onward-copy-label>{onwardMessages.copyQqGroupLabel}</span>
                </span>
              </button>
              <p
                class="home-onward__copy-feedback"
                role="status"
                aria-live="polite"
                data-home-onward-copy-feedback
              ></p>
            </div>
            <div class="home-onward__qr">
              <span
                class="home-onward__qr-code"
                role="img"
                aria-label={onwardMessages.qqQrCodeLabel}
                set:html={qqPortalGroupQr}
              ></span>
              <span>{onwardMessages.qqQrCodeLabel}</span>
            </div>
            </section>
          </div>
        </div>
      </div>

      <aside class="home-onward__guide">
        <nav class="home-onward__service-links" aria-label={onwardMessages.serviceGuideLabel}>
          <a
            class="home-onward__service-link home-onward__service-link--wiki"
            href={externalDestinations.wiki.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`${messages.externalDestinationLabels.wiki} (${messages.externalLinkNewTabHint})`}
          >
            <span class="home-onward__service-icon" aria-hidden="true" set:html={bookOpenTextIcon}></span>
            <span class="home-onward__service-copy">{onwardMessages.wikiLabel}</span>
            <span class="home-onward__service-arrow" aria-hidden="true" set:html={arrowUpRightIcon}></span>
          </a>
          <div
            class="home-onward__service-link home-onward__service-link--future"
            aria-disabled="true"
          >
            <span class="home-onward__service-icon" aria-hidden="true" set:html={hardHatIcon}></span>
            <span class="home-onward__service-copy">{onwardMessages.moreComingLabel}</span>
          </div>
        </nav>
      </aside>
    </div>
  </div>
</section>

<script>
  import { getHomeOnwardDepartureBoardState } from "@/data/home-route-train";
  import { getHomePageFrameCoordinator } from "@/data/home-route-viewport";

  /** 续行 PIDS 在统一帧 read 阶段锁定、交给 write 阶段提交的状态。 */
  interface HomeOnwardFrameMeasurement {
    /** 手动选择在阅读期间保留；整个行程离开视口后才恢复滚动导览。 */
    journeyVisible: boolean;
    /** 本帧唯一可见的 PIDS 面板。 */
    boardState: "destinations" | "help";
  }

  /** 把每个续行内容页自己的滚动行程映射到 PIDS 状态，不借用前一段 Section Breaker 的列车进度。 */
  const initialiseHomeOnwardContent = (section: HTMLElement) => {
    const journey = section.querySelector<HTMLElement>("[data-home-onward-journey]");
    const destinationBoard = section.querySelector<HTMLElement>(
      "[data-home-onward-destination-board]",
    );
    const helpBoard = section.querySelector<HTMLElement>("[data-home-onward-help-board]");
    const stage = section.querySelector<HTMLElement>(".home-onward__stage");
    const scrollHint = section.querySelector<HTMLButtonElement>("[data-home-onward-scroll-hint]");
    const copyQqButton = section.querySelector<HTMLButtonElement>("[data-home-onward-copy-qq]");
    const copyQqLabel = copyQqButton?.querySelector<HTMLElement>(
      "[data-home-onward-copy-label]",
    );
    const copyFeedback = section.querySelector<HTMLElement>(
      "[data-home-onward-copy-feedback]",
    );
    const boardNavigation = section.querySelector<HTMLElement>(
      "[data-home-onward-board-navigation]",
    );
    const boardButtons = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-home-onward-select-board]"),
    );

    if (!journey || !stage || !destinationBoard || !helpBoard) {
      return;
    }

    let copyResetTimer: number | undefined;
    /** 显式选择优先于滚动进度，避免用户刚返回目的地就被下一帧切回帮助。 */
    let selectedBoard: HomeOnwardFrameMeasurement["boardState"] | null = null;
    let isOnwardActive = true;
    const frameCoordinator = getHomePageFrameCoordinator();

    /** 在统一帧 read 阶段取得路程进度，不改变面板或辅助技术状态。 */
    const readFrame = (): HomeOnwardFrameMeasurement => {
      const journeyRect = journey.getBoundingClientRect();
      const scrollDistance = Math.max(0, journey.offsetHeight - stage.offsetHeight);
      /* 短屏的自然排版没有额外滚动行程，直接用按钮换页，不把一像素滚动误判为读完。 */
      const progress = scrollDistance > 0
        ? Math.min(Math.max(-journeyRect.top / scrollDistance, 0), 1)
        : 0;
      const journeyVisible = journeyRect.top < window.innerHeight && journeyRect.bottom > 0;
      const boardState = (journeyVisible ? selectedBoard : null) ??
        getHomeOnwardDepartureBoardState(progress);

      return { journeyVisible, boardState };
    };

    /** 在统一帧 write 阶段只提交变化后的 PIDS 与可访问性状态。 */
    const writeFrame = ({ journeyVisible, boardState }: HomeOnwardFrameMeasurement) => {
      if (!journeyVisible) {
        selectedBoard = null;
      }
      const showsDestinations = boardState === "destinations";

      if (section.dataset.homeOnwardBoardState !== boardState) {
        section.dataset.homeOnwardBoardState = boardState;
      }
      if (destinationBoard.ariaHidden !== String(!showsDestinations)) {
        destinationBoard.ariaHidden = String(!showsDestinations);
      }
      if (destinationBoard.inert !== !showsDestinations) {
        destinationBoard.inert = !showsDestinations;
      }
      if (helpBoard.ariaHidden !== String(showsDestinations)) {
        helpBoard.ariaHidden = String(showsDestinations);
      }
      if (helpBoard.inert !== showsDestinations) {
        helpBoard.inert = showsDestinations;
      }
      for (const button of boardButtons) {
        const pressed = String(button.dataset.homeOnwardSelectBoard === boardState);
        if (button.getAttribute("aria-pressed") !== pressed) {
          button.setAttribute("aria-pressed", pressed);
        }
      }
    };

    const unregisterFrameParticipant = frameCoordinator.register({
      isActive: () => isOnwardActive,
      read: readFrame,
      write: writeFrame,
    });

    /** 所有连续滚动由首页唯一入口申请；组件事件只声明需要下一帧。 */
    const requestRender = () => {
      frameCoordinator.request();
    };

    /** 在同一块屏内双向切换；焦点停在始终可见的按钮上，不随旧面板进入 inert。 */
    const selectBoard = (state: HomeOnwardFrameMeasurement["boardState"]) => {
      selectedBoard = state;
      const selectedButton = boardButtons.find(
        (button) => button.dataset.homeOnwardSelectBoard === state,
      );
      selectedButton?.focus({ preventScroll: true });
      requestRender();
    };

    /** 使用临时输入框兼容不提供 Clipboard API，或明确拒绝写入权限的浏览器。 */
    const copyTextWithLegacyField = (value: string) => {
      const field = document.createElement("textarea");
      field.value = value;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.opacity = "0";
      document.body.append(field);
      field.select();
      const legacyCopy = Reflect.get(document, "execCommand");
      const copied =
        typeof legacyCopy === "function" && Reflect.apply(legacyCopy, document, ["copy"]);
      field.remove();
      return copied;
    };

    /** 在安全上下文优先使用 Clipboard API；权限拒绝时仍尝试兼容复制。 */
    const copyText = async (value: string) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(value);
          return true;
        } catch {
          return copyTextWithLegacyField(value);
        }
      }

      return copyTextWithLegacyField(value);
    };

    /** 同步复制按钮图标、可见反馈与数据状态，并在短暂确认后恢复默认文案。 */
    const setCopyState = (state: "idle" | "copied" | "failed") => {
      if (!copyQqButton || !copyQqLabel || !copyFeedback) {
        return;
      }

      const label =
        state === "copied"
          ? copyQqButton.dataset.copiedLabel
          : state === "failed"
            ? copyQqButton.dataset.copyFailedLabel
            : copyQqButton.dataset.copyLabel;

      copyQqButton.dataset.copyState = state;
      copyQqLabel.textContent = label ?? "";
      copyFeedback.textContent = state === "idle" ? "" : (label ?? "");
    };

    scrollHint?.addEventListener("click", () => selectBoard("help"));
    for (const button of boardButtons) {
      button.addEventListener("click", () => {
        const state = button.dataset.homeOnwardSelectBoard;
        if (state === "destinations" || state === "help") selectBoard(state);
      });
    }
    /* 键盘正在操作的面板保持可见，滚动不能藏起当前焦点所在的链接或复制按钮。 */
    destinationBoard.addEventListener("focusin", () => {
      selectedBoard = "destinations";
    });
    helpBoard.addEventListener("focusin", () => {
      selectedBoard = "help";
    });
    if (boardNavigation) {
      boardNavigation.hidden = false;
      section.dataset.homeOnwardEnhanced = "true";
    }
    copyQqButton?.addEventListener("click", async () => {
      if (copyResetTimer !== undefined) {
        window.clearTimeout(copyResetTimer);
      }

      try {
        const copied = await copyText(copyQqButton.dataset.copyValue ?? "");
        setCopyState(copied ? "copied" : "failed");
      } catch {
        setCopyState("failed");
      }

      copyResetTimer = window.setTimeout(() => setCopyState("idle"), 2400);
    });

    const onwardVisibilityObserver = new IntersectionObserver(
      (entries) => {
        /* 深链定位可能同批送达离屏与入屏记录；单目标观察器必须采用最后状态，才能恢复按钮更新。 */
        const entry = entries.at(-1);
        isOnwardActive = entry?.isIntersecting ?? false;
        if (isOnwardActive) {
          requestRender();
        }
      },
      { rootMargin: "100% 0px" },
    );
    onwardVisibilityObserver.observe(section);

    window.addEventListener("pageshow", requestRender);
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) {
        onwardVisibilityObserver.disconnect();
        unregisterFrameParticipant();
      }
    });
    requestRender();
  };

  document
    .querySelectorAll<HTMLElement>("[data-home-onward-content]")
    .forEach(initialiseHomeOnwardContent);
</script>

<style>
  .home-onward {
    /* 原生滚动行程先呈现两个 PIDS 拍点，再把后续输入连续交给 Footer。 */
    --home-onward-scroll-distance: clamp(1240px, 190svh, 1880px);
    --home-onward-track-width: clamp(36px, 3.23vw, 62px);
    /* 右轨变量表示直轨左边缘，并复用开放弯轨的 4.01613:1 比例；clamp 生效时仍与上段精确接缝。 */
    --home-onward-right-track-x: calc(
      77.71vw + var(--home-onward-track-width) * 3.01613
    );
    /* 桌面 PIDS 使用四边等宽灰壳；支柱在壳体背面承托，不再占用底边厚度。 */
    --home-onward-board-left: 7.92%;
    --home-onward-board-width: min(36.51vw, 701px);
    --home-onward-pids-inset: clamp(18px, 1.67vw, 32px);
    /* 在三行目的地上方预留一行切换按钮；两页共用外框高度，选择时不挤动附近内容。 */
    --home-onward-board-screen-size: clamp(268px, 31svh, 290px);
    /* 无脚本时没有切换控件；增强后只在屏幕内部给常驻按钮留出 44px。 */
    --home-onward-board-navigation-height: 0px;
    --home-onward-board-block-size: calc(
      var(--home-onward-board-screen-size) + var(--home-onward-pids-inset) * 2
    );
    --home-onward-pids-support-offset: clamp(148px, 17svh, 174px);
    /* 桌面 Station Mark 只向正文侧伸出一条轨道宽度；额外 1px 用来覆盖轨道拼缝。 */
    --home-onward-introduction-spur-width: calc(var(--home-onward-track-width) + 1px);
    /* 正文与 Station Mark 端点保留独立响应式空隙，避免横线把文字安全距全部填满。 */
    --home-onward-introduction-copy-clearance: clamp(48px, 3vw, 92px);
    /* 将轨宽与安全空隙合成正文右侧锚点，让续行标题的每一行共享同一条文字边界。 */
    --home-onward-introduction-copy-offset: calc(
      var(--home-onward-track-width) + var(--home-onward-introduction-copy-clearance)
    );
    /* 桌面邀请以探索线反推正文右边缘，并让两级文案都采用右对齐的阅读锚点。 */
    --home-onward-introduction-width: min(40vw, 720px);
    /* 末屏物件按视口高度下沉；短桌面也要为 Footer 解锁后的上移预留足够空间。 */
    --home-onward-footer-dock-offset: clamp(64px, 8svh, 96px);
    /* 减少动态时直接使用 Footer 交接完成态，保留构图但不播放随滚动位移。 */
    --home-onward-footer-reduced-shift: 96px;
    /* 导视牌跨过线路；内容安全区会叠加列车实际厚度，避免文字和箭头钻进运行中的车体。 */
    --home-onward-guide-right-wing: clamp(52px, 4.8vw, 92px);
    --home-onward-guide-train-gap: clamp(24px, 2vw, 32px);
    /* Wiki 箭头与导视行共用固定占位；放大只增加符号分量，不在 hover 时改变排版。 */
    --home-onward-guide-arrow-size: clamp(52px, 4vw, 76px);
    /* Wiki 色块扫过使用独立短促时长，保证方向可读且不拖慢高频 hover 反馈。 */
    --duration-home-onward-guide-sweep: 260ms;
    --home-onward-guide-right: calc(
      100% - var(--home-onward-right-track-x) - var(--home-onward-track-width) -
        var(--home-onward-guide-right-wing)
    );
    --home-onward-guide-width: min(42vw, 720px);
    --home-onward-guide-height: clamp(560px, 82svh, 893px);
    position: relative;
    min-height: 0;
    isolation: isolate;
    background: var(--palette-canvas);
    color: var(--palette-text);
  }

  .home-onward__route-track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--home-onward-right-track-x);
    z-index: 4;
    display: block;
    width: var(--home-onward-track-width);
    background: var(--home-onward-line-color);
    pointer-events: none;
  }

  .home-onward__introduction {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: min(90svh, 920px);
    align-items: center;
    padding-block: clamp(120px, 16svh, 190px);
  }

  .home-onward__station-marker {
    position: absolute;
    top: calc(50% - var(--home-onward-track-width) / 2);
    right: calc(100% - var(--home-onward-right-track-x) - 1px);
    z-index: 3;
    display: block;
    width: var(--home-onward-introduction-spur-width);
    height: var(--home-onward-track-width);
    background: var(--home-onward-line-color);
    pointer-events: none;
  }

  .home-onward__introduction-copy {
    display: grid;
    gap: clamp(18px, 2vw, 34px);
    width: var(--home-onward-introduction-width);
    margin-right: calc(
      100% - var(--home-onward-right-track-x) +
        var(--home-onward-introduction-copy-offset)
    );
    margin-left: auto;
    text-align: right;
  }

  .home-onward__introduction-copy p,
  .home-onward__introduction-copy h2 {
    margin: 0;
  }

  .home-onward__kicker {
    font-size: clamp(17px, 1.25vw, 24px);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .home-onward__introduction-copy h2 {
    font-size: clamp(43px, 4.6vw, 88px);
    font-weight: 700;
    line-height: 1.14;
  }

  .home-onward__introduction-copy h2 span {
    display: block;
  }

  .home-onward__invitation-description {
    max-width: 34em;
    margin-left: auto;
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 480;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .home-onward__journey {
    position: relative;
    z-index: 1;
    /* 外层路程保持 lvh 稳定；必须完整落在当前可见区的 PIDS 舞台继续使用 svh。 */
    height: calc(100lvh + var(--home-onward-scroll-distance));
    min-height: 980px;
    overflow: clip;
  }

  .home-onward__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 680px;
    overflow: clip;
  }

  .home-onward__pids-support {
    position: absolute;
    top: calc(21% + var(--home-onward-pids-support-offset));
    bottom: 0;
    left: 10.9%;
    z-index: 1;
    width: var(--home-onward-track-width);
    overflow: clip;
  }

  .home-onward__pids-support-fill {
    position: absolute;
    inset: 0;
    background: var(--palette-text);
  }

  .home-onward__board-area {
    position: absolute;
    top: 21%;
    left: var(--home-onward-board-left);
    z-index: 2;
    width: var(--home-onward-board-width);
  }

  .home-onward__board-shell {
    position: relative;
    box-sizing: border-box;
    height: var(--home-onward-board-block-size);
    padding: var(--home-onward-pids-inset);
    background: color-mix(in srgb, var(--palette-journey-map) 86%, var(--palette-text));
  }

  .home-onward__board-screen {
    position: absolute;
    inset: var(--home-onward-pids-inset);
    overflow: hidden;
    background: var(--palette-surface);
  }

  .home-onward[data-home-onward-enhanced="true"] {
    --home-onward-board-navigation-height: 44px;
  }

  .home-onward__board-navigation:not([hidden]) {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: var(--home-onward-board-navigation-height);
    box-shadow: inset 0 -2px var(--palette-text);
  }

  .home-onward__board-navigation button {
    min-width: 0;
    min-height: 44px;
    padding: 6px 10px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 650;
    cursor: pointer;
    touch-action: manipulation;
  }

  .home-onward__board-navigation button[aria-pressed="true"] {
    background: var(--palette-text);
    color: var(--palette-surface);
  }

  .home-onward__board-navigation button:focus-visible {
    outline: 2px solid var(--palette-action);
    outline-offset: -4px;
  }

  .home-onward__board-navigation button:active {
    opacity: 0.72;
  }

  .home-onward__board {
    position: absolute;
    inset: var(--home-onward-board-navigation-height) 0 0;
    min-height: 0;
    overflow: hidden;
    background: transparent;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .home-onward[data-home-onward-board-state="destinations"]
    .home-onward__board--destinations,
  .home-onward[data-home-onward-board-state="help"] .home-onward__board--help {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .home-onward__board--destinations {
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .home-onward[data-home-onward-board-state="destinations"]
    .home-onward__board--destinations {
    display: grid;
  }

  .home-onward table {
    width: 100%;
    height: auto;
    border-collapse: collapse;
    table-layout: fixed;
    font-variant-numeric: tabular-nums;
  }

  .home-onward th,
  .home-onward td {
    box-sizing: border-box;
    padding: 0.16em 0.58em;
    text-align: left;
    vertical-align: middle;
  }

  .home-onward th {
    border-bottom: 2px solid currentColor;
    font-size: clamp(15px, 1.15vw, 22px);
    font-weight: 700;
    line-height: 1.1;
  }

  .home-onward thead tr {
    height: clamp(28px, 3.2svh, 32px);
  }

  .home-onward td {
    border-bottom: 1px solid var(--palette-border);
    font-size: clamp(19px, 1.6vw, 28px);
    font-weight: 700;
    line-height: 1.18;
  }

  .home-onward tbody tr {
    position: relative;
    height: clamp(48px, 5.6svh, 52px);
  }

  .home-onward tbody tr:is(:hover, :focus-within) {
    background: var(--palette-surface-raised);
  }

  .home-onward th:first-child,
  .home-onward td:first-child {
    width: 17%;
    text-align: center;
  }

  .home-onward th:last-child,
  .home-onward td:last-child {
    width: 34%;
    text-align: right;
  }

  .home-onward td a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35em;
    min-height: 44px;
    padding-inline: 0.25em;
    color: inherit;
    font-size: clamp(16px, 1.25vw, 20px);
    text-decoration: none;
    white-space: nowrap;
  }

  /* 原生链接的透明命中面覆盖整行，保留新标签页、键盘与浏览器链接菜单的既有行为。 */
  .home-onward td a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .home-onward td a:focus-visible {
    outline: none;
  }

  .home-onward td a:focus-visible::after {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .home-onward td a:active,
  a.home-onward__service-link:active,
  .home-onward__ticker:active,
  .home-onward__qq-copy:active {
    opacity: 0.72;
  }

  .home-onward td a span:last-child,
  .home-onward__service-arrow {
    display: inline-grid;
    width: 1.15em;
    height: 1.15em;
    place-items: center;
  }

  .home-onward td a span:last-child :global(svg),
  .home-onward__service-arrow :global(svg),
  .home-onward__ticker :global(svg),
  .home-onward__qq-copy :global(svg),
  .home-onward__service-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-onward__ticker {
    display: grid;
    grid-template-columns: 1.35em minmax(0, 1fr) 1.2em;
    gap: 0.55em;
    align-items: center;
    width: 100%;
    min-height: clamp(40px, 4.2svh, 44px);
    margin: 0;
    padding: 0.42em 0.7em;
    border: 0;
    background: var(--color-scene-fallback);
    color: var(--color-on-hero);
    cursor: pointer;
    font: inherit;
    font-size: clamp(14px, 1.05vw, 20px);
    font-weight: 700;
    line-height: 1.2;
    text-align: left;
  }

  .home-onward__ticker > span:first-child,
  .home-onward__ticker-arrow,
  .home-onward__qq-copy-icon,
  .home-onward__service-icon {
    display: inline-grid;
    place-items: center;
  }

  .home-onward__ticker:hover,
  .home-onward__ticker:focus-visible {
    background: var(--palette-action);
    color: var(--palette-action-text);
    outline: 3px solid var(--palette-text);
    outline-offset: -3px;
  }

  .home-onward__ticker-arrow {
    width: 1.2em;
    height: 1.2em;
  }

  .home-onward__board--help {
    grid-template-columns: minmax(0, 1fr) clamp(108px, 7.3vw, 140px);
    gap: clamp(16px, 1.3vw, 24px);
    align-items: center;
    padding: clamp(16px, 1.3vw, 24px);
  }

  .home-onward[data-home-onward-board-state="help"] .home-onward__board--help {
    display: grid;
  }

  .home-onward__help-content,
  .home-onward__help-copy {
    display: grid;
  }

  .home-onward__help-content {
    gap: clamp(12px, 1vw, 18px);
    min-width: 0;
  }

  .home-onward__help-copy {
    gap: 0.65em;
  }

  .home-onward__help-copy p {
    margin: 0;
    font-size: clamp(16px, 1.2vw, 22px);
    line-height: 1.35;
  }

  .home-onward__help-copy .home-onward__help-title {
    font-size: clamp(27px, 2.2vw, 40px);
    font-weight: 700;
    line-height: 1.12;
  }

  .home-onward__qq-copy {
    display: grid;
    grid-template-columns: clamp(28px, 2.2vw, 42px) minmax(0, 1fr) auto;
    gap: clamp(8px, 0.7vw, 12px);
    align-items: center;
    min-width: 0;
    min-height: 58px;
    padding: 0.55em 0.65em;
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .home-onward__qq-copy:hover,
  .home-onward__qq-copy:focus-visible {
    background: var(--palette-action);
    color: var(--palette-action-text);
    outline: 3px solid var(--palette-text);
    outline-offset: 3px;
  }

  .home-onward__qq-copy-icon {
    width: clamp(28px, 2.2vw, 42px);
    height: clamp(28px, 2.2vw, 42px);
  }

  .home-onward__qq-copy-meta,
  .home-onward__qq-copy-meta strong,
  .home-onward__qq-copy-meta small {
    display: block;
  }

  .home-onward__qq-copy-meta {
    min-width: 0;
  }

  .home-onward__qq-copy-meta small {
    overflow: hidden;
    font-size: clamp(10px, 0.72vw, 13px);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-onward__qq-copy-meta strong {
    margin-top: 0.12em;
    font-size: clamp(19px, 1.45vw, 27px);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .home-onward__qq-copy-action {
    display: inline-flex;
    gap: 0.35em;
    align-items: center;
    font-size: clamp(10px, 0.72vw, 13px);
    font-weight: 700;
  }

  .home-onward__qq-copy-action-icon {
    display: inline-grid;
    width: 1.25em;
    height: 1.25em;
    place-items: center;
  }

  .home-onward__qq-copy-action-icon--done,
  .home-onward__qq-copy[data-copy-state="copied"]
    .home-onward__qq-copy-action-icon--copy {
    display: none;
  }

  .home-onward__qq-copy[data-copy-state="copied"]
    .home-onward__qq-copy-action-icon--done {
    display: inline-grid;
  }

  .home-onward__copy-feedback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .home-onward__qr {
    display: grid;
    gap: 0.45em;
    justify-items: center;
    font-size: clamp(9px, 0.65vw, 12px);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .home-onward__qr-code {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--palette-surface);
  }

  .home-onward__qr-code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-onward__guide {
    /* Footer 交接和车身厚度只在本导视牌局部消费，避免运行时变量使整节正文失效。 */
    --home-onward-footer-transition-shift: 0px;
    --home-onward-active-train-thickness: 90px;
    --home-onward-guide-content-right: calc(
      var(--home-onward-track-width) / 2 + var(--home-onward-guide-right-wing) +
        var(--home-onward-active-train-thickness) / 2 +
        var(--home-onward-guide-train-gap)
    );
    position: absolute;
    top: 10%;
    right: var(--home-onward-guide-right);
    z-index: 2;
    box-sizing: border-box;
    width: var(--home-onward-guide-width);
    min-height: var(--home-onward-guide-height);
    padding: clamp(20px, 2vw, 38px) var(--home-onward-guide-content-right)
      clamp(54px, 8svh, 92px) 0;
    background: var(--palette-surface);
  }

  .home-onward__service-links {
    display: grid;
    gap: clamp(8px, 1.1svh, 12px);
  }

  .home-onward__service-link {
    position: relative;
    display: grid;
    grid-template-columns:
      clamp(58px, 4.4vw, 84px) minmax(0, max-content) minmax(36px, 1fr)
      var(--home-onward-guide-arrow-size);
    gap: clamp(10px, 0.8vw, 16px);
    align-items: center;
    min-height: clamp(76px, 9.5svh, 102px);
    padding: 0;
    color: inherit;
    font-size: clamp(26px, 2.95vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
  }

  .home-onward__service-link > * {
    position: relative;
    z-index: 1;
  }

  a.home-onward__service-link--wiki::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--palette-fetarute-info);
    content: "";
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      transform var(--duration-home-onward-guide-sweep)
      var(--motion-header-standard-spatial);
  }

  a.home-onward__service-link--wiki:is(:hover, :focus-visible) {
    background: transparent;
    color: var(--palette-fetarute-info-text);
  }

  a.home-onward__service-link--wiki:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }

  a.home-onward__service-link--wiki:focus-visible {
    outline: 3px solid var(--palette-text);
    outline-offset: 3px;
  }

  .home-onward__service-icon {
    grid-column: 1;
    box-sizing: border-box;
    width: clamp(58px, 4.4vw, 84px);
    height: clamp(58px, 4.4vw, 84px);
    padding: clamp(13px, 1vw, 19px);
    background: var(--palette-fetarute-info);
    color: var(--palette-fetarute-info-text);
  }

  .home-onward__service-link--future .home-onward__service-icon {
    background: var(--palette-fetarute-exit);
    color: var(--palette-fetarute-exit-text);
  }

  .home-onward__service-copy {
    grid-column: 2;
    min-width: 0;
    white-space: nowrap;
  }

  .home-onward__service-link--future .home-onward__service-copy {
    grid-column: 2 / 5;
    white-space: normal;
    text-wrap: balance;
  }

  .home-onward__service-arrow {
    grid-column: 4;
  }

  .home-onward__service-link[aria-disabled="true"] {
    color: var(--palette-muted);
  }

  .home-onward__service-arrow {
    width: var(--home-onward-guide-arrow-size);
    height: var(--home-onward-guide-arrow-size);
  }

  @media (min-width: 1024px) {
    .home-onward__board-area,
    .home-onward__pids-support-fill {
      /* 与导视牌分别接收局部交接值，避免在父 section 上逐帧扩散变量。 */
      --home-onward-footer-transition-shift: 0px;
    }

    .home-onward__stage {
      /* 只由静止的 journey 边界裁切离场物件，避免移动中的 sticky 边界提前切掉 PIDS 底框。 */
      overflow: visible;
    }

    .home-onward__board-area,
    .home-onward__guide {
      transform: translateY(
        calc(
          var(--home-onward-footer-dock-offset) +
          var(--home-onward-footer-transition-shift)
        )
      );
      will-change: transform;
    }

    .home-onward__pids-support-fill {
      /* 固定父裁窗保留柱脚，填充层只做位移，避免 Safari 在滚动中重绘 clip-path。 */
      transform: translateY(
        calc(
          var(--home-onward-footer-dock-offset) +
            var(--home-onward-footer-transition-shift)
        )
      );
      will-change: transform;
    }

    .home-onward[data-home-onward-locale="en"] {
      /* 英文帮助文案需要固定的一档额外高度；两种 PIDS 状态仍共用同一外框，不在翻页时跳动。 */
      --home-onward-board-screen-size: clamp(296px, 34svh, 312px);
    }
  }

  @media (max-width: 1279px) and (min-width: 1024px) {
    .home-onward {
      --home-onward-board-width: clamp(360px, 39vw, 470px);
      --home-onward-guide-width: clamp(360px, 38vw, 430px);
      --home-onward-guide-arrow-size: 48px;
    }

    .home-onward__service-link {
      grid-template-columns:
        48px minmax(max-content, auto) minmax(38px, 1fr)
        var(--home-onward-guide-arrow-size);
      gap: 10px;
      min-height: 76px;
      font-size: clamp(22px, 2.5vw, 32px);
    }

    .home-onward__service-icon {
      width: 48px;
      height: 48px;
      padding: 11px;
    }
  }

  @media (max-width: 1023px) {
    .home-onward {
      /* 小屏延续“线路在左、正文向内容侧伸出”的首页铁路语法。 */
      --home-onward-scroll-distance: clamp(1180px, 190svh, 1600px);
      --home-onward-track-width: clamp(20px, 5.8vw, 30px);
      --home-onward-pids-inset: clamp(12px, 3.6vw, 18px);
      --home-onward-board-screen-size: clamp(270px, 32svh, 286px);
      --home-onward-guide-arrow-size: 36px;
      /* 小屏保留左侧线路挂载面，但纵向仍沿用桌面等宽的上下边框。 */
      --home-onward-board-block-size: calc(
        var(--home-onward-board-screen-size) + var(--home-onward-pids-inset) * 2
      );
      /* 移动端所有线路对象共享同一条左侧轨道基准，避免各自使用相近但不同的 7vw。 */
      --home-onward-mobile-track-left: 7vw;
      /* 挂载面只略微越过轨道左缘，让线路穿过牌体而不生成过宽的灰色翼板。 */
      --home-onward-mobile-mount-left: max(
        12px,
        calc(var(--home-onward-mobile-track-left) - 8px)
      );
      /* 文字跟在一条轨宽的站标之后，留出 18px 阅读间隔，与其余小屏章节保持接近的版心。 */
      --home-onward-mobile-copy-left: max(
        calc(
          var(--home-onward-mobile-track-left) + var(--home-onward-track-width) * 2 +
            18px
        ),
        20.9vw
      );
      /* PIDS 与导视内容保留列车安全距离，同时缩短轨道至屏幕之间的安装留白。 */
      --home-onward-mobile-content-left: max(
        calc(
          var(--home-onward-mobile-track-left) + var(--home-onward-track-width) +
            32px
        ),
        18vw
      );
      /* 左侧挂载留白从牌体外缘延伸到内容起点，PIDS 与导视牌共同复用。 */
      --home-onward-mobile-mount-depth: calc(
        var(--home-onward-mobile-content-left) - var(--home-onward-mobile-mount-left)
      );
    }

    .home-onward__route-track {
      right: auto;
      left: var(--home-onward-mobile-track-left);
    }

    .home-onward__introduction {
      min-height: clamp(460px, 72svh, 720px);
      padding: clamp(108px, 15svh, 150px) 22px clamp(96px, 13svh, 132px)
        var(--home-onward-mobile-copy-left);
    }

    .home-onward__station-marker {
      right: auto;
      left: calc(
        var(--home-onward-mobile-track-left) + var(--home-onward-track-width) - 1px
      );
      /* 与其他移动端正文共用“一条轨宽 + 1px 接缝”的 station mark，不为续行另设长度。 */
      width: var(--home-onward-introduction-spur-width);
    }

    .home-onward__introduction-copy {
      gap: clamp(14px, 3.8vw, 20px);
      width: auto;
      margin-right: 0;
      margin-left: 0;
      text-align: left;
    }

    .home-onward__kicker {
      font-size: clamp(14px, 3.7vw, 18px);
    }

    .home-onward__invitation-description {
      margin-left: 0;
      font-size: clamp(17px, 4.4vw, 20px);
    }

    .home-onward__introduction-copy h2 {
      font-size: clamp(30px, 8.8vw, 52px);
      line-height: 1.14;
    }

    .home-onward__journey {
      min-height: 1080px;
    }

    .home-onward__stage {
      display: grid;
      grid-template-rows: auto auto;
      align-content: start;
      gap: clamp(14px, 2svh, 20px);
      min-height: 720px;
      padding: clamp(104px, 13svh, 128px) 16px 54px
        var(--home-onward-mobile-content-left);
    }

    .home-onward__pids-support {
      display: none;
    }

    .home-onward__guide,
    .home-onward__board-area {
      position: relative;
      inset: auto;
      box-sizing: border-box;
      width: calc(
        100% + var(--home-onward-mobile-content-left) -
          var(--home-onward-mobile-mount-left)
      );
      height: auto;
      margin-left: calc(
        var(--home-onward-mobile-mount-left) - var(--home-onward-mobile-content-left)
      );
      min-height: 0;
    }

    .home-onward__board-screen {
      inset: var(--home-onward-pids-inset) var(--home-onward-pids-inset)
        var(--home-onward-pids-inset)
        var(--home-onward-mobile-mount-depth);
    }

    .home-onward__guide {
      order: 2;
