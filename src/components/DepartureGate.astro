---
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";
import ftaLogo from "@/assets/wayfinding/fta-logo.svg?raw";
import arrowRightIcon from "@phosphor-icons/core/assets/regular/arrow-right.svg?raw";
import checkCircleIcon from "@phosphor-icons/core/assets/regular/check-circle.svg?raw";
import contactlessPaymentIcon from "@phosphor-icons/core/assets/regular/contactless-payment.svg?raw";
import contactlessSignalIcon from "@phosphor-icons/core/assets/regular/wifi-high.svg?raw";
import handPointingIcon from "@phosphor-icons/core/assets/regular/hand-pointing.svg?raw";

/**
 * 首屏与第一叙事站之间的出发遮罩属性。
 * 它被投递到 BaseLayout 的正文外层，才能在锁定 main 时继续保有自己的可操作焦点。
 */
export interface Props {
  /** 当前公开语言决定遮罩中的交互文案与读屏标签。 */
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
/** 仅提取图标路径嵌入既有导引 SVG，避免嵌套根 SVG 影响整座舞台的视口尺寸。 */
const handPointingPath = handPointingIcon.match(/<path d="([^"]+)"/)?.[1] ?? "";
/** 生产站把本次出发写入当前 tab；开发环境每次刷新都保留可重看占位动效的机会。 */
const shouldPersistDepartureSeen = import.meta.env.PROD;
---

<section
  class="departure-gate"
  data-departure-gate
  data-departure-locale={locale}
  data-state="armed"
  data-persist-session={shouldPersistDepartureSeen ? "true" : "false"}
  data-ready-status={messages.home.departure.readyStatus}
  data-dragging-status={messages.home.departure.draggingStatus}
  data-validated-status={messages.home.departure.validatedStatus}
  data-skipped-status={messages.home.departure.skippedStatus}
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="departure-gate-title"
  aria-describedby="departure-gate-instruction"
  inert
>
  <div class="departure-gate__scene">
    <div class="departure-gate__copy">
      <h2 id="departure-gate-title">{messages.home.departure.title}</h2>
      <p id="departure-gate-instruction">{messages.home.departure.description}</p>
    </div>

    <div class="departure-gate__stage" data-departure-stage>
      <!-- 导引线只在静止时出现；脚本会按卡片与感应区的实际位置生成它，拖动时立即让出操作视野。 -->
      <svg class="departure-gate__drag-guide" data-departure-drag-guide aria-hidden="true" focusable="false">
        <path class="departure-gate__drag-guide-path" data-departure-drag-guide-path></path>
        <path class="departure-gate__drag-guide-head" data-departure-drag-guide-head></path>
        <!-- 手势图标沿同一条动态曲线移动，明确这是一段可执行的拖拽路径而非纯装饰。 -->
        <g class="departure-gate__drag-guide-prompt" data-departure-drag-guide-prompt>
          <g transform="translate(-18 -18) scale(0.140625)">
            <path class="departure-gate__drag-guide-prompt-icon" d={handPointingPath}></path>
          </g>
        </g>
      </svg>
      <button
        class="departure-gate__pass"
        data-departure-pass
        type="button"
        aria-label={messages.home.departure.cardActionLabel}
        aria-describedby="departure-gate-instruction"
        aria-pressed="false"
      >
        <span class="departure-gate__pass-face">
          <span class="departure-gate__pass-edge" aria-hidden="true"></span>
          <!-- 线路色曲线只作为卡面装饰，确保中性底色上的 Fetarute 凭证文字仍是阅读主角。 -->
          <span class="departure-gate__pass-routes" aria-hidden="true"><span></span><span></span><span></span></span>
          <!-- 卡名保持紧凑的两行文字，与 Figma 的基础排版关系一致，不把产品名拆散成装饰性元素。 -->
          <strong class="departure-gate__pass-title">
            <span>{messages.home.departure.passName[0]}</span>
            <span>{messages.home.departure.passName[1]}</span>
          </strong>
          <!-- 卡号是一次会话内的轻量凭证细节，不把虚构的路线序号伪装成真实运营信息。 -->
          <span class="departure-gate__pass-number" data-departure-pass-number aria-hidden="true">FTU-0000-0000</span>
          <!-- 非接触标记复用项目已安装的 Phosphor 图标，避免为装饰手绘近似的支付符号。 -->
          <span class="departure-gate__pass-contactless" aria-hidden="true" set:html={contactlessPaymentIcon}></span>
        </span>
      </button>

      <button
        class="departure-gate__reader"
        data-departure-reader
        type="button"
        aria-label={messages.home.departure.readerActionLabel}
        aria-describedby="departure-gate-instruction"
        aria-pressed="false"
      >
        <span class="departure-gate__reader-housing">
          <!-- 屏幕只显示 Validator 的真实待机信息，品牌归属留给下方运营导视牌。 -->
          <span class="departure-gate__reader-screen" aria-hidden="true">
            <span class="departure-gate__reader-screen-top">
              <strong class="departure-gate__reader-screen-caption">{messages.home.departure.screenSystemLabel}</strong>
              <span class="departure-gate__reader-screen-mode">
                <span class="departure-gate__reader-screen-ready-label">{messages.home.departure.screenReadyLabel}</span>
                <span class="departure-gate__reader-screen-validated-label">{messages.home.departure.screenValidatedLabel}</span>
                <span class="departure-gate__reader-signal"></span>
              </span>
            </span>
            <span class="departure-gate__reader-screen-idle">
              <!-- 待机状态只保留已有图标库的 NFC 符号；不再播放额外的波纹动画。 -->
              <span class="departure-gate__reader-screen-contactless" set:html={contactlessSignalIcon}></span>
              <!-- 小屏在拖动时用箭头取代 NFC，成为无文字的“继续靠近”方向符号。 -->
              <span class="departure-gate__reader-screen-go" set:html={arrowRightIcon}></span>
              <strong class="departure-gate__reader-screen-idle-copy">{messages.home.departure.screenIdleAction}</strong>
              <!-- 成功图标采用圆环包住对号的公共交通确认语义；小屏仅保留它，避免短暂停留时文字重叠。 -->
              <span class="departure-gate__reader-screen-result">
                <span class="departure-gate__reader-screen-result-icon" set:html={checkCircleIcon}></span>
                <strong class="departure-gate__reader-screen-result-copy">{messages.home.departure.screenValidatedAction}</strong>
              </span>
            </span>
          </span>
          <!-- 屏幕下方的确认条属于外壳而非第二块屏幕，以微弱反馈让 Validator 读作站内实体设备。 -->
          <span class="departure-gate__reader-housing-confirmation" aria-hidden="true">
            <span class="departure-gate__reader-housing-indicator"></span>
            <span class="departure-gate__reader-housing-groove"></span>
          </span>
        </span>
        <span class="departure-gate__reader-sign">
          <span class="departure-gate__reader-copy">
            <strong>{messages.home.departure.readerNotice}</strong>
            <small>{messages.home.departure.readerWelcome}</small>
          </span>
          <span class="departure-gate__reader-mark" aria-hidden="true" set:html={ftaLogo}></span>
        </span>
        <!-- 与外壳同材质的立柱和底座将设备固定在站内地面上，不靠悬浮阴影制造体积。 -->
        <span class="departure-gate__reader-stand" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <p class="departure-gate__status" data-departure-status aria-live="polite">
    {messages.home.departure.readyStatus}
  </p>
  <button class="departure-gate__skip" data-departure-skip type="button">
    <span>{messages.home.departure.skipLabel}</span>
    <small>{messages.home.departure.skipHint}</small>
  </button>
</section>

<script>
  /** 出发遮罩从靠近、定点、临时回退到放行的状态；只有完成后禁止再次回到可触发状态。 */
  type DepartureGateState =
    | "armed"
    | "approaching"
    | "snapping"
    | "active"
    | "swiping"
    | "retreating"
    | "dragging"
    | "returning"
    | "validated"
    | "skipped"
    | "leaving";
  /** 出发门离场方向区分结果淡出与读者上划放行，避免把手势语义伪装成同一种动画。 */
  type DepartureGateExitDirection = "fade" | "up";
  /** SVG 导引线使用的局部坐标点，始终相对于出发交互舞台。 */
  type DepartureGuidePoint = { x: number; y: number };
  /** 回退停止后的单一物理滚动状态；输入停止前不创建它，避免与浏览器原生惯性争夺位置。 */
  type DepartureReturnSettleMotion = {
    /** 当前文档滚动位置，单位为 CSS px。 */
    position: number;
    /** 当前回退速度，单位为 CSS px/s。 */
    velocity: number;
    /** 静默后依据真实停留位置选出的局部落点，只可能是 Home 或 Validator 锚点。 */
    targetScrollTop: number;
    /** 上一帧的单调时间；首帧前缺省以保持刷新率无关的推进。 */
    timestamp?: number;
    /** 当前唯一可写入 scrollY 的动画帧。 */
    frame?: number;
  };

  const departureGate = document.querySelector<HTMLElement>("[data-departure-gate]");
  const departureSentinel = document.querySelector<HTMLElement>("[data-departure-gate-sentinel]");
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const mainContent = document.querySelector<HTMLElement>("main");
  const root = document.documentElement;

  if (departureGate && departureSentinel) {
    const stage = departureGate.querySelector<HTMLElement>("[data-departure-stage]");
    const pass = departureGate.querySelector<HTMLButtonElement>("[data-departure-pass]");
    const passNumber = departureGate.querySelector<HTMLElement>("[data-departure-pass-number]");
    const reader = departureGate.querySelector<HTMLButtonElement>("[data-departure-reader]");
    const readerHousing = departureGate.querySelector<HTMLElement>(".departure-gate__reader-housing");
    const readerScreen = departureGate.querySelector<HTMLElement>(".departure-gate__reader-screen");
    const dragGuide = departureGate.querySelector<SVGSVGElement>("[data-departure-drag-guide]");
    const dragGuidePath = departureGate.querySelector<SVGPathElement>("[data-departure-drag-guide-path]");
    const dragGuideHead = departureGate.querySelector<SVGPathElement>("[data-departure-drag-guide-head]");
    const dragGuidePrompt = departureGate.querySelector<SVGGElement>("[data-departure-drag-guide-prompt]");
    const skip = departureGate.querySelector<HTMLButtonElement>("[data-departure-skip]");
    const status = departureGate.querySelector<HTMLElement>("[data-departure-status]");
    const shouldPersist = departureGate.dataset.persistSession === "true";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const departureSessionKey = "fetarute.departure.seen";
    /** Guard 使用 Material 式较短的加速离场；它比入场更快，仍给正文接棒留下可读的空间。 */
    const departureExitDuration = reducedMotion ? 160 : 300;
    /** Landing 仍保留六成可读范围；跨过此线才让 Guard 由视口下方开始接管。 */
    const departureApproachStartViewportFraction = 0.4;
    /** Guard 的文档锚点停在视口十分之一处，使滑入完成前保留一小段空间层次。 */
    const departureSnapViewportFraction = 0.1;
    /** 验票成功后保留一秒结果屏，让绿色状态有足够时间被读者确认再进入下一段。 */
    const departureValidationHoldDuration = 1000;
    /** 成功后先在感应区停留的时长，模拟真实拍卡完成的确认瞬间，再让卡片为结果屏让位。 */
    const departureValidationDockDelay = reducedMotion ? 0 : 320;
    /** Landing 跨过六成后等待原生惯性停止的短窗口；与 Portal 的滚动结算一致，不在输入中争夺 scrollY。 */
    const departureSettleIdleDuration = 160;
    /** 只在桌面精确指针环境启用“自由回退后归位”，移动版保留既有手势语义。 */
    const departureDesktopScrollMediaQuery = "(min-width: 761px) and (pointer: fine)";
    /** 回退超过相邻两站距离的十分之一，才视为读者确认要离开 Validator。 */
    const departureReturnSettleCommitRatio = 0.1;
    /** 短距离版面仍至少要求 64px 位移，避免一枚轻触触控板立刻离开闸机。 */
    const departureReturnSettleMinimumCommitDistance = 64;
    /** 归位沿用 Portal 的 90ms 临界阻尼响应，足够明确又不会像补帧般闪现。 */
    const departureReturnSettleResponseMs = 90;
    /** 图标沿导引线走完一段路径后短暂停顿，保持提示可读而不持续争夺注意力。 */
    const departureDragPromptPauseDuration = 760;
    /** 手势图标沿真实贝塞尔路径推进的时长；对应实体卡片的克制、无回弹移动。 */
    const departureDragPromptTravelDuration = 1120;
    let hasSeenDeparture = false;

    /** 为当前标签页生成简短的 TransitUnion 卡号，保留凭证质感但不伪造线路或站点编号。 */
    const createTransitUnionCardNumber = () => {
      const values = new Uint16Array(2);
      window.crypto.getRandomValues(values);
      const segments = Array.from(values, (value) => String(value % 10000).padStart(4, "0"));
      return `FTU-${segments.join("-")}`;
    };

    if (passNumber) passNumber.textContent = createTransitUnionCardNumber();

    try {
      if (!shouldPersist) {
        // 开发时清除生产预览残留，方便反复核查遮罩与第一站的淡出交接。
        window.sessionStorage.removeItem(departureSessionKey);
      } else {
        hasSeenDeparture = window.sessionStorage.getItem(departureSessionKey) === "true";
      }
    } catch {
      // 存储不可用时仍要求当前页完成一次明确操作，只是不承诺跨刷新记忆该结果。
    }

    /** 遮罩仍不透明时收起首屏后的跑道，使淡出后第一叙事站正好接住当前视口。 */
    const releaseDepartureRunway = () => {
      departureSentinel.dataset.departureGateRunway = "complete";
    };

    /** 已完成过出发的同标签页不再需要滑入跑道，直接恢复 Landing 与正文的常规章节间距。 */
    const removeDepartureRunwayForSeenSession = () => {
      departureSentinel.dataset.departureGateRunway = "seen";
    };

    /** 跑道收起后把当前视口交给紧随其后的第一站；该对齐只在不透明 Guard 离场前执行。 */
    const alignFirstNarrativeStation = () => {
      const firstNarrativeStation = departureSentinel.nextElementSibling;
      if (!(firstNarrativeStation instanceof HTMLElement)) return;

      const maximumScrollTop = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const targetScrollTop = Math.min(
        maximumScrollTop,
        Math.max(0, window.scrollY + firstNarrativeStation.getBoundingClientRect().top),
      );
      window.scrollTo({ top: targetScrollTop, behavior: "auto" });
    };

    /** 深链目标在跑道收起后重新定位，确保固定页眉的 scroll margin 在最终文档高度上生效。 */
    const restoreInitialAnchor = (target: HTMLElement) => {
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          // 全站 smooth 不能接管初始深链；否则补间末端的反向校正会让 Header 误判成用户上滑。
          const previousScrollBehavior = root.style.scrollBehavior;
          root.style.scrollBehavior = "auto";
          target.scrollIntoView({ behavior: "auto", block: "start" });
          window.requestAnimationFrame(() => {
            root.style.scrollBehavior = previousScrollBehavior;
          });
        });
      });
    };

    const initialAnchorId = window.location.hash.slice(1);
    const initialAnchorTarget = initialAnchorId ? document.getElementById(initialAnchorId) : null;

    if (initialAnchorTarget instanceof HTMLElement) {
      // URL 已明确指定站名章节时不要求先完成出发交互；否则深链会被 Guard 的跑道和对齐逻辑改写。
      removeDepartureRunwayForSeenSession();
      departureGate.remove();
      restoreInitialAnchor(initialAnchorTarget);
    } else if (hasSeenDeparture) {
      removeDepartureRunwayForSeenSession();
      departureGate.remove();
    } else if (stage && pass && reader && skip && status) {
      let dragPointerId: number | undefined;
      let dragStartX = 0;
      let dragStartY = 0;
      let passOffsetX = 0;
      let passOffsetY = 0;
      let passRotation = -5;
      let dragStartOffsetX = 0;
      let dragStartOffsetY = 0;
      let dragStartPassBounds: DOMRect | undefined;
      let draggedDuringPointerSession = false;
      let suppressPassClick = false;
      let hasDeparted = false;
      let scrollFrameId: number | undefined;
      let departureSettleTimeoutId: number | undefined;
      let finishDepartureSettle: (() => void) | undefined;
      let departureSnapTimeoutId: number | undefined;
      let finishDepartureSnap: (() => void) | undefined;
      let gateSwipePointerId: number | undefined;
      let gateSwipeStartY = 0;
      let gateSwipeDistance = 0;
      let departureReturnStartScrollTop = 0;
      let departureReturnSettleTimeoutId: number | undefined;
      let departureReturnSettleMotion: DepartureReturnSettleMotion | undefined;
      let dragGuideFrameId: number | undefined;
      let dragGuideObserver: ResizeObserver | undefined;
      let dragGuidePromptFrameId: number | undefined;
      let dragGuidePromptPathLength = 0;
      let dragGuidePromptCycleStart: number | undefined;
      let launchStateObserver: MutationObserver | undefined;
      let launchBoundaryObserver: MutationObserver | undefined;
      let headerWasInert = false;
      let mainWasInert = false;

      /** 读取当前遮罩状态，所有事件先以它判断自己是否仍有写入权。 */
      const getState = (): DepartureGateState =>
        (departureGate.dataset.state as DepartureGateState | undefined) ?? "armed";

      /** 统一写入状态属性，让 CSS 只根据这一处状态机渲染占位画面。 */
      const setState = (nextState: DepartureGateState) => {
        departureGate.dataset.state = nextState;
      };

      /** 将首屏滚动进度写入遮罩的视觉变量；范围固定为 0 到 1，避免越界位移。 */
      const setApproachProgress = (progress: number) => {
        const clampedProgress = Math.min(1, Math.max(0, progress));
        departureGate.style.setProperty("--departure-gate-approach-progress", String(clampedProgress));
      };

      /** 回退期间由真实 scrollY 派生 Guard 位移；不再另开一条 CSS transform 动画。 */
      const setReturnProgress = (progress: number) => {
        const clampedProgress = Math.min(1, Math.max(0, progress));
        departureGate.style.setProperty("--departure-gate-return-progress", String(clampedProgress));
      };

      /** 把触控端整片 Guard 的上划距离限制在一个视口内，只影响遮罩而不干扰行程卡的拖动位移。 */
      const setGateSwipeDistance = (distance: number) => {
        gateSwipeDistance = Math.min(window.innerHeight, Math.max(0, distance));
        departureGate.style.setProperty("--departure-gate-swipe-distance", `${gateSwipeDistance}px`);
      };

      /** 仅让桌面精确指针取得回退滚动的输入权，窄屏和触控设备不改写既有手势路径。 */
      const usesDesktopGateScroll = () => window.matchMedia(departureDesktopScrollMediaQuery).matches;

      /** 停止沿线图标的单一动画帧循环；遮罩离开或读者开始拖卡时不再保留后台绘制。 */
      const stopDragGuidePrompt = () => {
        if (dragGuidePromptFrameId !== undefined) window.cancelAnimationFrame(dragGuidePromptFrameId);
        dragGuidePromptFrameId = undefined;
        dragGuidePromptCycleStart = undefined;
        if (dragGuidePrompt) dragGuidePrompt.style.visibility = "hidden";
      };

      /** 图标的位置和朝向直接从 SVG 路径取得，使所有断点都沿同一条测量后的贝塞尔线前进。 */
      const animateDragGuidePrompt = (timestamp: number) => {
        dragGuidePromptFrameId = undefined;
        if (
          reducedMotion ||
          getState() !== "active" ||
          !dragGuidePath ||
          !dragGuidePrompt ||
          dragGuidePromptPathLength <= 1
        ) {
          stopDragGuidePrompt();
          return;
        }

        dragGuidePromptCycleStart ??= timestamp;
        const cycleDuration = departureDragPromptTravelDuration + departureDragPromptPauseDuration;
        const cycleElapsed = (timestamp - dragGuidePromptCycleStart) % cycleDuration;

        if (cycleElapsed >= departureDragPromptTravelDuration) {
          dragGuidePrompt.style.visibility = "hidden";
          dragGuidePromptFrameId = window.requestAnimationFrame(animateDragGuidePrompt);
          return;
        }

        const rawProgress = cycleElapsed / departureDragPromptTravelDuration;
        // 沿线移动采用减速曲线，抵达箭头前的轻收束让卡片方向保持可读。
        const progress = 1 - Math.pow(1 - rawProgress, 3);
        const pathProgress = 0.08 + progress * 0.68;
        const pathLength = dragGuidePromptPathLength * pathProgress;
        const point = dragGuidePath.getPointAtLength(pathLength);
        const nextPoint = dragGuidePath.getPointAtLength(Math.min(dragGuidePromptPathLength, pathLength + 1));
        const heading = (Math.atan2(nextPoint.y - point.y, nextPoint.x - point.x) * 180) / Math.PI + 90;
        // 透明度只作为移动图标的入出场辅助，不独立承担提示语义。
        const opacity = Math.min(1, rawProgress / 0.12, (1 - rawProgress) / 0.18);

        dragGuidePrompt.style.visibility = "visible";
        dragGuidePrompt.setAttribute("transform", `translate(${point.x} ${point.y}) rotate(${heading})`);
        dragGuidePrompt.style.opacity = String(opacity);
        dragGuidePromptFrameId = window.requestAnimationFrame(animateDragGuidePrompt);
      };

      /** 路径重算后仅启动一个图标循环，避免 ResizeObserver 的连续回调叠加多条动画。 */
      const startDragGuidePrompt = () => {
        if (
          reducedMotion ||
          getState() !== "active" ||
          !dragGuidePrompt ||
          dragGuidePromptPathLength <= 1 ||
          dragGuidePromptFrameId !== undefined
        ) {
          return;
        }

        dragGuidePromptCycleStart = undefined;
        dragGuidePromptFrameId = window.requestAnimationFrame(animateDragGuidePrompt);
      };

      /** 判断当前是否仍允许读者拖动、验票或略过；离场后所有输入都必须失效。 */
      const isInteractionActive = () => {
        const state = getState();
        return state === "active" || state === "swiping" || state === "dragging";
      };

      /** 将手势位置直接写到卡片本体，避免父级变量更新整片遮罩的样式计算。 */
      const renderPassTransform = () => {
        pass.style.transform = `translate(${passOffsetX}px, ${passOffsetY}px) rotate(${passRotation}deg)`;
      };

      /**
       * 从矩形中心沿目标方向找到相向边缘，使导引线始终停在卡片与 Validator 实体之外。
       * 以实际边界计算可避免桌面、平板与移动端分别维护一组箭头坐标。
       */
      const getFacingEdgePoint = (bounds: DOMRect, direction: DepartureGuidePoint): DepartureGuidePoint => {
        const centre = {
          x: bounds.left + bounds.width / 2,
          y: bounds.top + bounds.height / 2,
        };
        const horizontalHalf = Math.max(bounds.width / 2, 1);
        const verticalHalf = Math.max(bounds.height / 2, 1);
        const scale = 1 / Math.max(Math.abs(direction.x) / horizontalHalf, Math.abs(direction.y) / verticalHalf, 1);

        return {
          x: centre.x + direction.x * scale,
          y: centre.y + direction.y * scale,
        };
      };

      /**
       * 由卡片与感应区当前位置绘制一条二次贝塞尔导引线，并让箭头切线准确指向 Validator。
       * 仅在待机时更新，避免在拖动手势中为不可见装饰重复做布局读取。
       */
      const renderDragGuide = () => {
        if (
          getState() !== "active" ||
          !stage ||
          !readerHousing ||
          !dragGuide ||
          !dragGuidePath ||
          !dragGuideHead
        ) {
          return;
        }

        const stageBounds = stage.getBoundingClientRect();
        const passBounds = pass.getBoundingClientRect();
        const readerBounds = readerHousing.getBoundingClientRect();
        const direction = {
          x: readerBounds.left + readerBounds.width / 2 - (passBounds.left + passBounds.width / 2),
          y: readerBounds.top + readerBounds.height / 2 - (passBounds.top + passBounds.height / 2),
        };
        const distance = Math.hypot(direction.x, direction.y);

        if (stageBounds.width <= 0 || stageBounds.height <= 0 || distance <= 1) return;

        const unitDirection = {
          x: direction.x / distance,
          y: direction.y / distance,
        };
        const clearance = Math.min(14, Math.max(8, distance * 0.04));
        const passEdge = getFacingEdgePoint(passBounds, direction);
        const readerEdge = getFacingEdgePoint(readerBounds, {
          x: -direction.x,
          y: -direction.y,
        });
        const start = {
          x: passEdge.x + unitDirection.x * clearance - stageBounds.left,
          y: passEdge.y + unitDirection.y * clearance - stageBounds.top,
        };
        const end = {
          x: readerEdge.x - unitDirection.x * clearance - stageBounds.left,
          y: readerEdge.y - unitDirection.y * clearance - stageBounds.top,
        };
        // 弯曲量以可绘制的两端净距为基准，避免实体靠近时仍生成一枚过度弯折的小钩子。
        const availableDistance = Math.hypot(end.x - start.x, end.y - start.y);
        const bend = Math.min(52, Math.max(14, availableDistance * 0.24));
        const perpendicular = {
          x: -unitDirection.y,
          y: unitDirection.x,
        };
        const control = {
          x: (start.x + end.x) / 2 + perpendicular.x * bend,
          y: (start.y + end.y) / 2 + perpendicular.y * bend,
        };
        const finalTangent = {
          x: end.x - control.x,
          y: end.y - control.y,
        };
        const finalTangentLength = Math.max(Math.hypot(finalTangent.x, finalTangent.y), 1);
        const finalTangentUnit = {
          x: finalTangent.x / finalTangentLength,
          y: finalTangent.y / finalTangentLength,
        };
        const arrowLength = Math.min(16, Math.max(11, distance * 0.12));
        const arrowHalfWidth = arrowLength * 0.62;
        const arrowBase = {
          x: end.x - finalTangentUnit.x * arrowLength,
          y: end.y - finalTangentUnit.y * arrowLength,
        };
        const arrowPerpendicular = {
          x: -finalTangentUnit.y,
          y: finalTangentUnit.x,
        };
        const arrowStart = {
          x: arrowBase.x + arrowPerpendicular.x * arrowHalfWidth,
          y: arrowBase.y + arrowPerpendicular.y * arrowHalfWidth,
        };
        const arrowEnd = {
          x: arrowBase.x - arrowPerpendicular.x * arrowHalfWidth,
          y: arrowBase.y - arrowPerpendicular.y * arrowHalfWidth,
        };

        dragGuide.setAttribute("viewBox", `0 0 ${stageBounds.width} ${stageBounds.height}`);
        dragGuidePath.setAttribute("d", `M ${start.x} ${start.y} Q ${control.x} ${control.y} ${end.x} ${end.y}`);
        dragGuideHead.setAttribute("d", `M ${arrowStart.x} ${arrowStart.y} L ${end.x} ${end.y} L ${arrowEnd.x} ${arrowEnd.y}`);
        dragGuidePromptPathLength = dragGuidePath.getTotalLength();
        startDragGuidePrompt();
      };

      /** 将一次布局重算合并进动画帧，让 ResizeObserver 不会在同一帧多次读取矩形。 */
      const queueDragGuideUpdate = () => {
        if (dragGuideFrameId !== undefined) return;

        dragGuideFrameId = window.requestAnimationFrame(() => {
          dragGuideFrameId = undefined;
          renderDragGuide();
        });
      };

      /** 返回卡片当前位置到初始占位位置；未成功的拖放不做摇晃或错误惩罚。 */
      const returnPassToStart = () => {
        passOffsetX = 0;
        passOffsetY = 0;
        passRotation = -5;
        renderPassTransform();
      };

      /** 卡片回到起点后才重新开放下一次拖放并显示导引线，避免回位途中出现错误的临时路径。 */
      const finishPassReturn = () => {
        if (hasDeparted || getState() !== "returning") return;

        setState("active");
        status.textContent = departureGate.dataset.readyStatus ?? status.textContent;
        queueDragGuideUpdate();
      };

      /** 只响应卡片本体的 transform 结束事件，子元素样式变化不能提前结束回位状态。 */
      const handlePassTransitionEnd = (event: TransitionEvent) => {
        if (event.target !== pass || event.propertyName !== "transform") return;

        finishPassReturn();
        queueDragGuideUpdate();
      };

      /** Validator 在断点间使用 transform 回到居中位，过渡结束后需重算导引终点，避免箭头停留在旧屏幕位置。 */
      const handleReaderTransitionEnd = (event: TransitionEvent) => {
        if (event.target !== reader || event.propertyName !== "transform") return;

        queueDragGuideUpdate();
      };

      /** 只在完成的两种结果写入会话，避免读者只是经过第一站就失去出发门。 */
      const persistDepartureSeen = () => {
        if (!shouldPersist) return;

        try {
          window.sessionStorage.setItem(departureSessionKey, "true");
        } catch {
          // 当前页面的单向状态仍能阻止同一次阅读里重新出现。
        }
      };

      /** 遮罩激活期间记录本组件新增的 inert 边界，离场时不会误清除其他流程已有的锁定。 */
      const lockPageForDeparture = () => {
        headerWasInert = siteHeader?.hasAttribute("inert") ?? false;
        mainWasInert = mainContent?.hasAttribute("inert") ?? false;
        root.dataset.departureGating = "true";

        if (!headerWasInert) siteHeader?.setAttribute("inert", "");
        if (!mainWasInert) mainContent?.setAttribute("inert", "");
      };

      /** 仅恢复本遮罩负责的键盘边界，确保 Launch 等其他状态不会被提前放开。 */
      const unlockPageAfterDeparture = () => {
        delete root.dataset.departureGating;
        if (!headerWasInert) siteHeader?.removeAttribute("inert");
        if (!mainWasInert) mainContent?.removeAttribute("inert");
      };

      /** 停止随滚动检查的触发器，使已通过的第一站不可能在回滚时再次盖住内容。 */
      const stopScrollControl = () => {
        window.removeEventListener("scroll", queueScrollCheck);
        window.removeEventListener("resize", queueScrollCheck);
        if (scrollFrameId !== undefined) window.cancelAnimationFrame(scrollFrameId);
        scrollFrameId = undefined;
      };

      /** 清理一次性定点等待器，避免离场后仍有 scrollend 回调改写已卸载的遮罩状态。 */
      const clearDepartureSnapWait = () => {
        if (departureSnapTimeoutId !== undefined) window.clearTimeout(departureSnapTimeoutId);
        departureSnapTimeoutId = undefined;
        if (finishDepartureSnap) window.removeEventListener("scrollend", finishDepartureSnap);
        finishDepartureSnap = undefined;
      };

      /** 清理 Landing 到 Guard 的原生停顿结算，保证新输入或离场不会被旧 scrollend 再次接管。 */
      const clearDepartureSettleWait = () => {
        if (departureSettleTimeoutId !== undefined) window.clearTimeout(departureSettleTimeoutId);
        departureSettleTimeoutId = undefined;
        if (finishDepartureSettle) window.removeEventListener("scrollend", finishDepartureSettle);
        finishDepartureSettle = undefined;
      };

      /** 归还回退结算的唯一写入权；新的原生输入可以从当前画面无缝接管。 */
      const clearDepartureReturnSettle = () => {
        if (departureReturnSettleTimeoutId !== undefined) window.clearTimeout(departureReturnSettleTimeoutId);
        departureReturnSettleTimeoutId = undefined;
        if (departureReturnSettleMotion?.frame !== undefined) {
          window.cancelAnimationFrame(departureReturnSettleMotion.frame);
        }
        departureReturnSettleMotion = undefined;
        root.classList.remove("departure-gate--return-settling");
      };

      /** 真正移除遮罩前先撤销所有全局监听，避免已卸载的节点继续持有焦点或滚动引用。 */
      const removeDepartureGate = () => {
        stopScrollControl();
        clearDepartureSnapWait();
        clearDepartureSettleWait();
        clearDepartureReturnSettle();
        dragGuideObserver?.disconnect();
        if (dragGuideFrameId !== undefined) window.cancelAnimationFrame(dragGuideFrameId);
        stopDragGuidePrompt();
        launchStateObserver?.disconnect();
        launchBoundaryObserver?.disconnect();
        document.removeEventListener("keydown", handleGateKeydown);
        window.removeEventListener("pointermove", handlePassPointerMove);
        window.removeEventListener("pointerup", settleDrag);
        window.removeEventListener("pointercancel", settleDrag);
        window.removeEventListener("pointermove", moveGateSwipe);
        window.removeEventListener("pointerup", settleGateSwipe);
        window.removeEventListener("pointercancel", settleGateSwipe);
        window.removeEventListener("wheel", handleGateWheel, true);
        window.removeEventListener("scrollend", handleDepartureReturnScrollEnd);
        pass.removeEventListener("transitionend", handlePassTransitionEnd);
        reader.removeEventListener("transitionend", handleReaderTransitionEnd);
        departureGate.removeEventListener("pointerdown", beginGateSwipe);
        stopGateSwipe();
        unlockPageAfterDeparture();
        departureGate.remove();
      };

      /** 终态统一进入淡出；遮罩始终覆盖第一 Section，淡出时才让其站名边界显现。 */
      const beginLeaving = () => {
        if (getState() === "leaving") return;

        releaseDepartureRunway();
        alignFirstNarrativeStation();
        departureGate.setAttribute("aria-hidden", "true");
        departureGate.setAttribute("inert", "");
        setState("leaving");
        window.setTimeout(removeDepartureGate, departureExitDuration);
      };

      /** 释放拖放 capture，供验票、略过和 Escape 共用，避免遗留 pointer 所有权。 */
      const stopDragging = () => {
        const capturedPointerId = dragPointerId;
        dragPointerId = undefined;
        dragStartPassBounds = undefined;
        if (capturedPointerId !== undefined && pass.hasPointerCapture(capturedPointerId)) {
          pass.releasePointerCapture(capturedPointerId);
        }
      };

      /** 验票成功时把行程卡吸附到屏幕感应区的视觉中心，避免不同拖放终点留下不一致的停留位置。 */
      const centerValidatedPass = () => {
        if (!hasDeparted || getState() !== "validated" || reducedMotion) return;

        const targetBounds = readerScreen?.getBoundingClientRect() ?? readerHousing?.getBoundingClientRect() ?? reader.getBoundingClientRect();
        passRotation = 0;
        renderPassTransform();

        const passRect = pass.getBoundingClientRect();
        passOffsetX += targetBounds.left + targetBounds.width / 2 - (passRect.left + passRect.width / 2);
        passOffsetY += targetBounds.top + targetBounds.height / 2 - (passRect.top + passRect.height / 2);
        renderPassTransform();
      };

      /** 成功停留结束后，把卡片轻移到 Validator 左侧；计算时保留当前纵向位置，避免跳变成另一套构图。 */
      const dockValidatedPass = () => {
        if (!hasDeparted || getState() !== "validated") return;

        const passRect = pass.getBoundingClientRect();
        const readerBounds = readerHousing?.getBoundingClientRect() ?? reader.getBoundingClientRect();
        const gateBounds = departureGate.getBoundingClientRect();
        const safeInset = Math.max(12, Math.min(gateBounds.width, gateBounds.height) * 0.018);
        const dockingGap = Math.min(28, Math.max(12, passRect.width * 0.07));
        const targetPassLeft = Math.max(gateBounds.left + safeInset, readerBounds.left - dockingGap - passRect.width);

        passOffsetX += targetPassLeft + passRect.width / 2 - (passRect.left + passRect.width / 2);
        passRotation = 0;
        if (!reducedMotion) renderPassTransform();
      };

      /** 验票或略过后都成为不可逆的一次性结果，并在当前文档里永久关闭触发器。 */
      const completeDeparture = (outcome: "validated" | "skipped", exitDirection: DepartureGateExitDirection = "fade") => {
        if (!isInteractionActive() || hasDeparted) return;

        hasDeparted = true;
        stopScrollControl();
        stopDragging();
        persistDepartureSeen();
        departureGate.dataset.departureGateExitDirection = exitDirection;
        setState(outcome);
        status.textContent =
          outcome === "validated"
            ? departureGate.dataset.validatedStatus ?? status.textContent
            : departureGate.dataset.skippedStatus ?? status.textContent;

        if (outcome === "validated") {
          pass.setAttribute("aria-pressed", "true");
          reader.setAttribute("aria-pressed", "true");

          centerValidatedPass();
          window.setTimeout(dockValidatedPass, departureValidationDockDelay);
          window.setTimeout(beginLeaving, departureValidationHoldDuration);
          return;
        }

        window.setTimeout(beginLeaving, 0);
      };

      /** 根据 Validator 的实际尺寸定义感应区，卡片靠近设备即可触发，不要求放到像素级中心。 */
      const isPassNearReader = () => {
        const passRect = pass.getBoundingClientRect();
        const readerRect = reader.getBoundingClientRect();
        const horizontalDistance = passRect.left + passRect.width / 2 - (readerRect.left + readerRect.width / 2);
        const verticalDistance = passRect.top + passRect.height / 2 - (readerRect.top + readerRect.height / 2);
        const snapRadius = Math.max(108, Math.min(Math.max(readerRect.width, readerRect.height) * 0.62, 220));

        return Math.hypot(horizontalDistance, verticalDistance) <= snapRadius;
      };

      /** 将拖动范围约束到全屏遮罩之内，使卡片可以经过页面任意位置但不会遗失到可视区域外。 */
      const movePassWithinGate = (horizontalDelta: number, verticalDelta: number) => {
        const gateBounds = departureGate.getBoundingClientRect();
        const initialBounds = dragStartPassBounds ?? pass.getBoundingClientRect();
        const safeInset = Math.max(12, Math.min(gateBounds.width, gateBounds.height) * 0.018);
        const minOffsetX = gateBounds.left + safeInset - initialBounds.left;
        const maxOffsetX = gateBounds.right - safeInset - initialBounds.right;
        const minOffsetY = gateBounds.top + safeInset - initialBounds.top;
        const maxOffsetY = gateBounds.bottom - safeInset - initialBounds.bottom;

        passOffsetX = dragStartOffsetX + Math.min(Math.max(horizontalDelta, minOffsetX), maxOffsetX);
        passOffsetY = dragStartOffsetY + Math.min(Math.max(verticalDelta, minOffsetY), maxOffsetY);
      };

      /** 在定点完成后激活遮罩：这时读者已明确抵达出发口，才锁定背景并交出焦点。 */
      const activateDepartureGate = () => {
        const state = getState();
        if (hasDeparted || (state !== "armed" && state !== "approaching" && state !== "snapping")) return;

        clearDepartureSnapWait();
        clearDepartureSettleWait();
        stopScrollControl();
        setApproachProgress(1);
        setState("active");
        departureGate.removeAttribute("aria-hidden");
        departureGate.removeAttribute("inert");
        lockPageForDeparture();
        window.requestAnimationFrame(() => {
          queueDragGuideUpdate();
          pass.focus({ preventScroll: true });
        });
      };

      /** 首屏滚过约六成即开始出现出发口；保留其后约三成视口作为平滑滑入与确认空间。 */
      const getApproachProgress = () => {
        const approachStartLine = window.innerHeight * departureApproachStartViewportFraction;
        const snapLine = window.innerHeight * departureSnapViewportFraction;
        const sentinelTop = departureSentinel.getBoundingClientRect().top;

        return (approachStartLine - sentinelTop) / (approachStartLine - snapLine);
      };

      /**
       * 将最后一小段滚动收束至出发口锚点；只完成这一次局部定点，不把后续章节变成强制分页。
       * scrollend 不可用或被浏览器合并时，以短超时兜底，并仅在确实抵达锚点后才激活 modal。
       */
      const beginDepartureSnap = () => {
        if (hasDeparted || getState() !== "approaching") return;

        if (reducedMotion) {
          activateDepartureGate();
          return;
        }

        clearDepartureSettleWait();
        stopScrollControl();
        setApproachProgress(1);
        setState("snapping");

        const maximumScrollTop = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        const targetScrollTop = Math.min(
          maximumScrollTop,
          Math.max(
            0,
            window.scrollY + departureSentinel.getBoundingClientRect().top - window.innerHeight * departureSnapViewportFraction,
          ),
        );
        let snapFinished = false;

        finishDepartureSnap = () => {
          if (snapFinished || getState() !== "snapping") return;
          snapFinished = true;
          clearDepartureSnapWait();

          if (Math.abs(window.scrollY - targetScrollTop) <= 4) {
            activateDepartureGate();
            return;
          }

          // 用户中断了定点时，不强行锁住页面；回到可继续滚动的靠近阶段等待下一次明确推进。
          setApproachProgress(getApproachProgress());
          setState("approaching");
          armScrollControl();
        };

        window.addEventListener("scrollend", finishDepartureSnap, { once: true });
        departureSnapTimeoutId = window.setTimeout(finishDepartureSnap, 900);
        window.scrollTo({ top: targetScrollTop, behavior: "smooth" });
      };

      /**
       * 复用 Portal 的原生输入结算边界：滚动期间不写 scrollY，惯性停稳后才把 Landing 吸附至 Guard。
       * 这里只有两站，故不引入全站 Section/hash 控制器；跨过六成门槛才会进入定点。
       */
      const scheduleDepartureSettle = () => {
        if (reducedMotion || getState() !== "approaching") return;

        clearDepartureSettleWait();
        let hasSettled = false;
        finishDepartureSettle = () => {
          if (hasSettled || getState() !== "approaching") return;
          hasSettled = true;
          clearDepartureSettleWait();

          if (getApproachProgress() > 0) beginDepartureSnap();
        };

        window.addEventListener("scrollend", finishDepartureSettle, { once: true });
        departureSettleTimeoutId = window.setTimeout(finishDepartureSettle, departureSettleIdleDuration);
      };

      /** 将滚动事件压缩到动画帧；回退时只由真实 scrollY 派生画面，静默后才开始局部归位。 */
      const checkScrollThreshold = () => {
        scrollFrameId = undefined;
        const state = getState();
        if (hasDeparted || (state !== "armed" && state !== "approaching" && state !== "retreating")) return;

        if (state === "retreating") {
          const returnDistance = Math.max(1, departureReturnStartScrollTop);
          const returnProgress = 1 - Math.min(returnDistance, Math.max(0, window.scrollY)) / returnDistance;
          setReturnProgress(returnProgress);

          if (window.scrollY <= 4) {
            // 读者已原生抵达 Home，不等待静默窗口，直接消除可能累积的亚像素偏移。
            finishDepartureReturnSettle(0);
            return;
          }

          scheduleDepartureReturnSettle();
          return;
        }

        const approachProgress = Math.min(1, Math.max(0, getApproachProgress()));
        if (approachProgress <= 0) {
          clearDepartureSettleWait();
          if (state === "approaching") {
            setApproachProgress(0);
            setState("armed");
          }
          return;
        }

        setApproachProgress(approachProgress);
        if (state === "armed") setState("approaching");
        // 减少动态效果时省略滑入路径，在跨过首屏阈值后直接把可操作出发口交给读者。
        if (reducedMotion) {
          activateDepartureGate();
          return;
        }
        scheduleDepartureSettle();
      };

      /** 滚动与尺寸变化共用同一帧检查，防止触控板连续事件在同一帧重复激活。 */
      function queueScrollCheck() {
        if (scrollFrameId !== undefined) return;
        scrollFrameId = window.requestAnimationFrame(checkScrollThreshold);
      }

      /** 只观察影响两端锚点的尺寸变化；卡片拖动时导引线已隐藏，不建立逐帧跟随循环。 */
      if (readerHousing && dragGuide && dragGuidePath && dragGuideHead) {
        dragGuideObserver = new ResizeObserver(queueDragGuideUpdate);
        dragGuideObserver.observe(stage);
        dragGuideObserver.observe(pass);
        dragGuideObserver.observe(readerHousing);
        pass.addEventListener("transitionend", handlePassTransitionEnd);
        reader.addEventListener("transitionend", handleReaderTransitionEnd);
      }

      /** Launch 放行或定点被打断后，均可恢复 Guard 的滚动观察；其他终态不再重新接管页面。 */
      const armScrollControl = () => {
        const state = getState();
        if (hasDeparted || (state !== "armed" && state !== "approaching" && state !== "retreating")) return;

        window.addEventListener("scroll", queueScrollCheck, { passive: true });
        window.addEventListener("resize", queueScrollCheck, { passive: true });
        queueScrollCheck();
      };

      /** 用临界阻尼推进选定的局部落点；rAF 是结算期间唯一的 scrollY writer。 */
      const advanceDepartureReturnSettle = (
        motion: DepartureReturnSettleMotion,
        timestamp: number,
      ): DepartureReturnSettleMotion => {
        if (motion.timestamp === undefined || !Number.isFinite(timestamp)) {
          return { ...motion, timestamp };
        }

        const elapsedSeconds = Math.max(0, timestamp - motion.timestamp) / 1000;
        if (elapsedSeconds === 0) return { ...motion, timestamp };

        const angularFrequency = 1000 / departureReturnSettleResponseMs;
        const displacement = motion.position - motion.targetScrollTop;
        const velocityTerm = motion.velocity + angularFrequency * displacement;
        const decay = Math.exp(-angularFrequency * elapsedSeconds);
        const position = motion.targetScrollTop + (displacement + velocityTerm * elapsedSeconds) * decay;
        const velocity = (motion.velocity - angularFrequency * velocityTerm * elapsedSeconds) * decay;

        return { ...motion, position, velocity, timestamp };
      };

      /** 根据停下时的真实位置选择 Home 或 Validator，不读取单次 wheel delta 来猜测读者意图。 */
      const resolveDepartureReturnTargetScrollTop = () => {
        const validatorScrollTop = Math.max(1, departureReturnStartScrollTop);
        const currentScrollTop = Math.min(validatorScrollTop, Math.max(0, window.scrollY));
        const displacement = validatorScrollTop - currentScrollTop;
        const commitDistance = Math.max(
          validatorScrollTop * departureReturnSettleCommitRatio,
          Math.min(validatorScrollTop, departureReturnSettleMinimumCommitDistance),
        );

        return displacement >= commitDistance ? 0 : validatorScrollTop;
      };

      /** 完成局部结算后恢复对应边界：到 Home 则重启 Landing，到闸机则重新锁住未验票状态。 */
      const finishDepartureReturnSettle = (targetScrollTop: number) => {
        if (getState() !== "retreating") return;

        root.classList.add("departure-gate--return-settling");
        window.scrollTo({ left: window.scrollX, top: targetScrollTop, behavior: "auto" });
        clearDepartureReturnSettle();

        if (targetScrollTop <= 4) {
          setApproachProgress(0);
          setReturnProgress(0);
          setState("armed");
          return;
        }

        setApproachProgress(1);
        setReturnProgress(0);
        departureGate.removeAttribute("aria-hidden");
        departureGate.removeAttribute("inert");
        setState("active");
        lockPageForDeparture();
        status.textContent = departureGate.dataset.readyStatus ?? status.textContent;
        queueDragGuideUpdate();
      };

      /** 原生惯性停止后才开始本地归位；反向滚动可传入闸机锚点，立即撤销原先的 Home 目标。 */
      const beginDepartureReturnSettle = (requestedTargetScrollTop = resolveDepartureReturnTargetScrollTop()) => {
        if (getState() !== "retreating" || departureReturnSettleMotion) return;

        const targetScrollTop = requestedTargetScrollTop;

        root.classList.add("departure-gate--return-settling");
        departureReturnSettleMotion = {
          position: window.scrollY,
          velocity: 0,
          targetScrollTop,
        };

        /**
         * 回退结算的唯一帧循环：每帧只由此处写入 scrollY，抵达目标或 reduced-motion 立即落位时停止调度。
         * 新输入会先清除 motion 与 frame，因而不会与浏览器重新接管的原生滚动同时写入位置。
         */
        const animate = () => {
          const motion = departureReturnSettleMotion;
          if (!motion || motion.frame !== undefined) return;

          motion.frame = window.requestAnimationFrame((timestamp) => {
            const activeMotion = departureReturnSettleMotion;
            if (!activeMotion || getState() !== "retreating") return;

            activeMotion.frame = undefined;
            const nextMotion = reducedMotion
              ? { ...activeMotion, position: activeMotion.targetScrollTop, velocity: 0, timestamp }
              : advanceDepartureReturnSettle(activeMotion, timestamp);
            const aligned = Math.abs(nextMotion.position - nextMotion.targetScrollTop) <= 0.5;
            const stopped = Math.abs(nextMotion.velocity) <= 5;
            departureReturnSettleMotion =
              aligned && stopped
                ? { ...nextMotion, position: nextMotion.targetScrollTop, velocity: 0 }
                : nextMotion;
            window.scrollTo({ left: window.scrollX, top: departureReturnSettleMotion.position, behavior: "auto" });

            if (!aligned || !stopped) {
              animate();
              return;
            }

            finishDepartureReturnSettle(nextMotion.targetScrollTop);
          });
        };

        animate();
      };

      /** 每笔真实滚动都会刷新静默窗口；Safari 提前派发 scrollend 时也不会抢走剩余惯性。 */
      const scheduleDepartureReturnSettle = () => {
        if (getState() !== "retreating" || departureReturnSettleMotion) return;

        if (departureReturnSettleTimeoutId !== undefined) window.clearTimeout(departureReturnSettleTimeoutId);
        departureReturnSettleTimeoutId = window.setTimeout(() => {
          departureReturnSettleTimeoutId = undefined;
          beginDepartureReturnSettle();
        }, departureSettleIdleDuration);
      };

      /** scrollend 只确认可以继续等待静默；真正开启动画仍共享同一个 160ms 门槛。 */
      const handleDepartureReturnScrollEnd = () => {
        scheduleDepartureReturnSettle();
      };

      /** idle 时把 Guard 交回原生上滚；停止后按位置归位，未完成验票也不会写入会话。 */
      const beginIdleGateReturn = () => {
        if (hasDeparted || getState() !== "active") return;

        departureGate.setAttribute("aria-hidden", "true");
        departureGate.setAttribute("inert", "");
        departureReturnStartScrollTop = Math.max(1, window.scrollY);
        setReturnProgress(0);
        setState("retreating");
        unlockPageAfterDeparture();
        armScrollControl();
        scheduleDepartureReturnSettle();
      };

      /** Launch 移除全屏层后仍会短暂保留 inert，因此需等现有焦点边界彻底释放才监听下一站滚动。 */
      const waitForLaunchBoundaryRelease = () => {
        const hasLaunchBoundary =
          (siteHeader?.hasAttribute("inert") ?? false) || (mainContent?.hasAttribute("inert") ?? false);

        if (!hasLaunchBoundary) {
          armScrollControl();
          return;
        }

        launchBoundaryObserver = new MutationObserver(() => {
          const boundaryStillLocked =
            (siteHeader?.hasAttribute("inert") ?? false) ||
            (mainContent?.hasAttribute("inert") ?? false);
          if (!boundaryStillLocked) {
            launchBoundaryObserver?.disconnect();
            armScrollControl();
          }
        });
        if (siteHeader) {
          launchBoundaryObserver.observe(siteHeader, { attributes: true, attributeFilter: ["inert"] });
        }
        if (mainContent) {
          launchBoundaryObserver.observe(mainContent, { attributes: true, attributeFilter: ["inert"] });
        }
      };

      /** Launch 可能正常播放或被跳过；观察根状态可覆盖两条路径而不改动它的成熟时间线。 */
      const waitForLaunchToEnd = () => {
        if (!root.hasAttribute("data-launching")) {
          waitForLaunchBoundaryRelease();
          return;
        }

        launchStateObserver = new MutationObserver(() => {
          if (!root.hasAttribute("data-launching")) {
            launchStateObserver?.disconnect();
            waitForLaunchBoundaryRelease();
          }
        });
        launchStateObserver.observe(root, { attributes: true, attributeFilter: ["data-launching"] });
      };

      pass.addEventListener("pointerdown", (event) => {
        if (!isInteractionActive() || reducedMotion || event.button !== 0) return;

        dragPointerId = event.pointerId;
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        dragStartOffsetX = passOffsetX;
        dragStartOffsetY = passOffsetY;
        dragStartPassBounds = pass.getBoundingClientRect();
        draggedDuringPointerSession = false;
        setState("dragging");
        status.textContent = departureGate.dataset.draggingStatus ?? status.textContent;
        pass.setPointerCapture(event.pointerId);
        event.preventDefault();
      });

      /**
       * 手势开始于卡片，但移动和松开由窗口接收。
       * 这样卡片越过 Validator、提示牌或页面边缘时也不会因命中元素改变而丢失拖放会话。
       */
      function handlePassPointerMove(event: PointerEvent) {
        if (dragPointerId !== event.pointerId || hasDeparted) return;

        const horizontalDelta = event.clientX - dragStartX;
        const verticalDelta = event.clientY - dragStartY;
        movePassWithinGate(horizontalDelta, verticalDelta);
        draggedDuringPointerSession ||= Math.hypot(horizontalDelta, verticalDelta) > 6;
        renderPassTransform();

        if (draggedDuringPointerSession && isPassNearReader()) {
          completeDeparture("validated");
        }
      }

      const settleDrag = (event: PointerEvent) => {
        if (dragPointerId !== event.pointerId) return;

        stopDragging();
        if (!draggedDuringPointerSession) {
          setState("active");
          status.textContent = departureGate.dataset.readyStatus ?? status.textContent;
          queueDragGuideUpdate();
          return;
        }

        suppressPassClick = true;
        if (isPassNearReader()) {
          completeDeparture("validated");
        } else {
          setState("returning");
          returnPassToStart();
          // 减少动态效果时卡片没有 transform 过渡，不能等待不会发生的 transitionend。
          if (reducedMotion) finishPassReturn();
        }
        window.setTimeout(() => {
          suppressPassClick = false;
          draggedDuringPointerSession = false;
        }, 0);
      };

      /** 桌面 idle 时仅放行原生上滚；向前滚动仍不把“未验票”隐式解释成略过。 */
      const handleGateWheel = (event: WheelEvent) => {
        if (!usesDesktopGateScroll()) return;

        const state = getState();
        if (state === "retreating") {
          if (event.ctrlKey || event.deltaY === 0) return;

          if (event.deltaY < 0) {
            // 新的上滚立即取消在途结算，完整归还给浏览器的原生惯性。
            clearDepartureReturnSettle();
            return;
          }

          // 反向输入同样拥有中断权，但仍不能穿过未验票 Guard；改为从当前位置平滑回到闸机锚点。
          event.preventDefault();
          clearDepartureReturnSettle();
          beginDepartureReturnSettle(departureReturnStartScrollTop);
          return;
        }
        if (state !== "active" || event.ctrlKey || hasDeparted || event.deltaY === 0) return;

        if (event.deltaY < 0) {
          beginIdleGateReturn();
          return;
        }

        event.preventDefault();
      };

      /** 结束触控端 Guard 上划会话并归还 pointer capture，避免后续验票拖放继承旧输入。 */
      const stopGateSwipe = () => {
        const capturedPointerId = gateSwipePointerId;
        gateSwipePointerId = undefined;
        if (capturedPointerId !== undefined && departureGate.hasPointerCapture(capturedPointerId)) {
          departureGate.releasePointerCapture(capturedPointerId);
        }
      };

      /** 移动端空白 Guard 保留原有的显式上划略过；桌面则完全交给自由原生滚动与位置归位。 */
      const beginGateSwipe = (event: PointerEvent) => {
        if (usesDesktopGateScroll() || getState() !== "active" || event.button !== 0) return;
        if (event.target instanceof Element && event.target.closest("button")) return;

        gateSwipePointerId = event.pointerId;
        gateSwipeStartY = event.clientY;
        setGateSwipeDistance(0);
        setState("swiping");
        departureGate.setPointerCapture(event.pointerId);
        event.preventDefault();
      };

      /** 上划只跟随向上的距离，向下拖动不拉开 Guard，以保留未验票不得向前通过的边界。 */
      const moveGateSwipe = (event: PointerEvent) => {
        if (gateSwipePointerId !== event.pointerId || hasDeparted) return;

        setGateSwipeDistance(gateSwipeStartY - event.clientY);
      };

      /** 触控端跨过明确阈值才略过；不足则恢复待机，避免轻触留白就离开 Validator。 */
      const settleGateSwipe = (event: PointerEvent) => {
        if (gateSwipePointerId !== event.pointerId) return;

        const shouldRelease = gateSwipeDistance >= window.innerHeight * 0.18;
        stopGateSwipe();
        if (shouldRelease) {
          completeDeparture("skipped", "up");
          return;
        }

        setGateSwipeDistance(0);
        if (!hasDeparted) setState("active");
      };

      window.addEventListener("pointermove", handlePassPointerMove);
      window.addEventListener("pointerup", settleDrag);
      window.addEventListener("pointercancel", settleDrag);
      window.addEventListener("pointermove", moveGateSwipe);
      window.addEventListener("pointerup", settleGateSwipe);
      window.addEventListener("pointercancel", settleGateSwipe);
      pass.addEventListener("lostpointercapture", settleDrag);
      departureGate.addEventListener("pointerdown", beginGateSwipe);
      window.addEventListener("wheel", handleGateWheel, { capture: true, passive: false });
      window.addEventListener("scrollend", handleDepartureReturnScrollEnd, { passive: true });
      pass.addEventListener("click", (event) => {
        if (suppressPassClick) {
          event.preventDefault();
          return;
        }
        completeDeparture("validated");
      });
      reader.addEventListener("click", () => completeDeparture("validated"));
      skip.addEventListener("click", () => completeDeparture("skipped", "up"));
      departureGate.addEventListener("click", (event) => {
        if (event.target === departureGate) completeDeparture("skipped", "up");
      });

      /** 模态开启后让键盘只在三条明确的出发路径之间循环，留白点击仍保留给指针用户。 */
      function handleGateKeydown(event: KeyboardEvent) {
        if (!isInteractionActive()) return;

        if (event.key === "Escape") {
          event.preventDefault();
          completeDeparture("skipped", "up");
          return;
        }

        if (event.key !== "Tab") return;

        const controls = [pass, reader, skip];
        const activeControlIndex = controls.indexOf(document.activeElement as HTMLButtonElement);
        if (activeControlIndex === -1) {
          event.preventDefault();
          pass?.focus();
        } else if (event.shiftKey && activeControlIndex <= 0) {
          event.preventDefault();
          skip?.focus();
        } else if (!event.shiftKey && activeControlIndex === controls.length - 1) {
          event.preventDefault();
          pass?.focus();
        }
      }

      document.addEventListener("keydown", handleGateKeydown);
      waitForLaunchToEnd();
    }
  }
</script>
