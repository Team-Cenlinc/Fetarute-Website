---
import type { ImageMetadata } from "astro";
import copyIcon from "@phosphor-icons/core/assets/bold/copy-bold.svg?raw";
import JourneyFooter from "@/components/JourneyFooter.astro";
import { getCommunityJourneyStops } from "@/data/community-journey";
import acatine from "@/assets/pages/home/community/presence/players/acatine.png";
import hot945 from "@/assets/pages/home/community/presence/players/hot945.png";
import lanyuvu from "@/assets/pages/home/community/presence/players/lanyuvu.png";
import complexColors from "@/assets/pages/home/community/presence/players/complex-colors.png";
import katsuta from "@/assets/pages/home/community/presence/players/katsuta-minamoto.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommunityMap from "@/components/CommunityMap.astro";
import TrainJourneyTooltip from "@/components/TrainJourneyTooltip.astro";
import { communityEntities, communityMosaicCells } from "@/data/community";
import { communityMapPalette } from "@/data/palette";
import { createHexColor, shiftRailwayLineColor } from "@/data/railway";
import { onwardEntryPoints, wayfindingPrototype } from "@/data/site";
import { communityMessages } from "@/i18n/community";
import type { Locale } from "@/i18n/config";
import { getLocalizedRelativeUrl } from "@/i18n/links";
import "@/styles/community.css";

/** 三语社区页共用街区布局和交互，仅替换公开文案。 */
export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = communityMessages[locale];
/** 复用已经缓存且公开署名的本地头像，不引入访客侧第三方图片请求。 */
const avatars: Readonly<Record<string, ImageMetadata>> = {
  "044741a8b61048f4aed1553b7e2ca8da": acatine,
  "5b8c1dec528a4a6286fc49fdc94a7b23": hot945,
  "6c921ad9ee8e42ddae447558e76239e5": lanyuvu,
  "49a9cb104b224aceb91f7605df0b34a6": complexColors,
  "302c6dad42bd46f996e3a4b239ab88ca": katsuta,
};
const entities = communityEntities.map((entity) => ({
  ...entity,
  displayName: entity.name ?? (
    entity.id === "server-placeholder" ? copy.serverPlaceholder :
    entity.id === "community-placeholder" ? copy.communityPlaceholder : copy.groupPlaceholder
  ),
  avatar: entity.playerUuid ? avatars[entity.playerUuid] : undefined,
}));
const members = entities.filter((entity) => entity.kind === "player");
const trainColor = shiftRailwayLineColor(createHexColor(communityMapPalette.route), wayfindingPrototype.homeTrainColorShift);
/** 页面只注入不会随主题改变的线路与列车色；材料色通过 CSS 消费全局 palette。 */
const paletteStyle = Object.entries(communityMapPalette)
  .map(([key, value]) => "--community-" + key + ": " + value + ";").join(" ") +
  " --community-train-color: " + trainColor + ";";
const chapters = getCommunityJourneyStops(locale);
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} pagePath="community/" fullBleedMain noindex>
  <div class="community-page" style={paletteStyle} data-community-page>
    <div class="community-train">
      <button class="train-feedback" type="button" data-community-train aria-label={copy.guide} aria-haspopup="dialog" aria-controls="community-train-panel" aria-expanded="false">
        <span aria-hidden="true"></span>
      </button>
    </div>
    <TrainJourneyTooltip
      id="community-train-panel"
      className="community-guide"
      title={copy.chapters}
      initiallyHidden={false}
      locale={locale}
      currentSectionId="community-center"
      routeStops={chapters}
      currentSectionLabel={copy.current}
      quickPickLabel={copy.chapters}
      goToSectionLabel={copy.goToSection}
      closeLabel={copy.close}
    />

    <section class="community-landing" id="community-center" aria-labelledby="community-title" data-community-stop={copy.title}>
      <svg class="community-landing__tracks" aria-hidden="true" focusable="false"><path d="M 3000 -2258 L 119 623 L 119 900" data-community-arrival-path fill="none" /></svg>
      <span class="community-landing__arrival-end" aria-hidden="true"></span>
      <span class="community-station community-landing__station" aria-hidden="true"></span>
      <a class="community-mosaic" href="#community-district" aria-label={copy.mapLabel}>
        {communityMosaicCells.map(([column, row], index) => (
          <span style={"grid-column: " + (column + 1) + "; grid-row: " + (row + 1) + ";"}>
            {members[index]?.avatar && (
              <img src={members[index].avatar!.src} width="77" height="77" alt="" decoding="async" />
            )}
          </span>
        ))}
      </a>
      <h1 id="community-title">
        <span>{copy.title}</span>
        {locale !== "en" && <span class="community-landing__english" lang="en">Community Center</span>}
      </h1>
    </section>

    <div class="community-atlas" data-community-atlas>
    <svg class="community-river-joins" aria-hidden="true" focusable="false"><path data-community-river-links /></svg>
    <svg class="community-river-mouth community-river-mouth--in" aria-hidden="true" focusable="false"><polygon data-community-river-in /></svg>
    <section class="community-district" id="community-district" aria-labelledby="community-district-title" data-community-stop={copy.districtStop} data-community-zone="players">
      <header class="community-district__heading">
        <span class="community-station" aria-hidden="true"></span>
        <h2 id="community-district-title">{copy.districtTitle}</h2>
        <p class="community-district__hint">{copy.mapHint}</p>
      </header>
      <CommunityMap locale={locale} entities={members} />
    </section>
    <section class="community-district" id="community-connections" aria-labelledby="community-connections-title" data-community-stop={copy.connectionsTitle} data-community-zone="connections">
      <header class="community-district__heading">
        <h2 id="community-connections-title">{copy.connectionsTitle}</h2>
      </header>
      <span class="community-district__crossing" aria-hidden="true">
        <span class="community-station community-station--approach"></span>
        <span class="community-station"></span>
      </span>
      <CommunityMap locale={locale} entities={entities.filter((entity) => entity.kind !== "player")} />
    </section>
    <svg class="community-river-mouth community-river-mouth--out" aria-hidden="true" focusable="false"><polygon data-community-river-out /></svg>
    </div>

    <JourneyFooter
      id="community-contact"
      className="community-contact"
      stopName={copy.contactStop}
      title={copy.contact}
      lineColor={communityMapPalette.route}
      returnHref={getLocalizedRelativeUrl(locale)}
      returnLabel={copy.home}
      returnDirection="left"
    >
      <div class="community-contact__details">
        <div class="community-contact__entry">
          <p class="community-contact__number">QQ <span>{onwardEntryPoints.qqPortalGroupNumber}</span></p>
          <button type="button" class="community-contact__copy" data-community-copy={onwardEntryPoints.qqPortalGroupNumber} data-copied-label={copy.copied} data-copy-failed-label={copy.copyFailed}>
            <span aria-hidden="true" set:html={copyIcon}></span>
            <span>{copy.copy}</span>
          </button>
        </div>
        <p class="community-contact__feedback" aria-live="polite" data-community-copy-feedback></p>
      </div>
    </JourneyFooter>
  </div>
  <noscript>
    <style>
      .community-map-block { aspect-ratio: auto; }
      .community-plot { position: relative; inset: auto; width: 100%; height: auto; margin-block: 16px; }
      .community-plot > summary { position: relative; min-height: 120px; clip-path: none; }
      .community-plot__label { left: 50%; top: 50%; width: 90%; }
      .community-map-base, .community-plot__outline, .community-river-mouth, .community-river-joins { display: none; }
      .community-panel { position: static; width: 100%; height: auto; max-height: none; }
      .community-guide { position: static; width: 100%; translate: none; transform: none; opacity: 1; pointer-events: auto; }
      .community-train { display: none; }
      .community-contact__copy { display: none; }
    </style>
  </noscript>
</BaseLayout>

<script>
  import { setupCommunityPage } from "@/lib/community/controller";
  const root = document.querySelector<HTMLElement>("[data-community-page]");
  if (root) setupCommunityPage(root);
</script>
