---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

/** 文章图片的受控输入，统一提供多格式响应式输出和可访问的替代文字。 */
interface Props {
  /** Astro 在构建期分析的本地图片，避免 public 目录绕过转换管线。 */
  src: ImageMetadata;
  /** 图片承载的信息描述；纯装饰图片应由调用者明确传入空字符串。 */
  alt: string;
  /** 图片下方的来源、说明或版权文字；没有必要信息时不渲染。 */
  caption?: string;
  /** 首屏关键图片可显式提升优先级，其余文章图片保持原生延迟加载。 */
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
---

<figure class="article-image">
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[480, 768, 1120, 1600]}
    sizes="(max-width: 800px) 100vw, 760px"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
