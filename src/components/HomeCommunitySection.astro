---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import cursorClickIcon from "@phosphor-icons/core/assets/regular/cursor-click.svg?raw";
import newYear2026Image from "@/assets/pages/home/community/new-year-2026.png";
import acatineNeoFueyaMaintenanceImage from "@/assets/pages/home/community/presence/acatine-neo-fueya-maintenance.png";
import complexColorsFueyaRenewalImage from "@/assets/pages/home/community/presence/complex-colors-fueya-renewal.png";
import hot945PyutocorLightingImage from "@/assets/pages/home/community/presence/hot945-pyutocor-lighting.png";
import katsutaMinamotoNktrTramImage from "@/assets/pages/home/community/presence/katsuta-minamoto-nktr-tram.png";
import lanYuvuBaysideRailwayImage from "@/assets/pages/home/community/presence/lanyuvu-bayside-railway.png";
import acatineAvatar from "@/assets/pages/home/community/presence/players/acatine.png";
import complexColorsAvatar from "@/assets/pages/home/community/presence/players/complex-colors.png";
import hot945Avatar from "@/assets/pages/home/community/presence/players/hot945.png";
import katsutaMinamotoAvatar from "@/assets/pages/home/community/presence/players/katsuta-minamoto.png";
import lanYuvuAvatar from "@/assets/pages/home/community/presence/players/lanyuvu.png";
import kitarikuLightrailTrialImage from "@/assets/pages/home/community/shared-kitariku-lightrail-trial.png";
import pulanSouthExtensionTrialImage from "@/assets/pages/home/community/shared-pulan-south-extension-trial.png";
import surcentralRebuildImage from "@/assets/pages/home/community/surcentral-rebuild.png";
import {
  homeCommunityStories,
  segmentHomeCommunityPlayerText,
} from "@/data/home-community";
import type {
  HomeCommunityMemoryStoryId,
  HomeCommunityPresenceStoryId,
} from "@/data/home-community";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";

/** 首页同岸社群叙事区的属性。 */
export interface Props {
  /** 当前公开语言，决定故事框架与图片替代文本。 */
  locale: Locale;
  /** 从湾岸支线正式数据注入的连续轨道色。 */
  lineColor: string;
}

const { locale, lineColor } = Astro.props;
const communityMessages = getMessages(locale).home.community;
const shortStoryMediaSizes = "(max-width: 1023px) 86vw, 72vw";
const shortStoryMediaWidths = [640, 960, 1440, 1920];

/**
 * 提前让 Astro Assets 生成所有候选，但只返回可放进延迟 DOM 属性的描述。
 * 浏览器不会把 data-* 中的 URL 当成图片请求，控制器激活故事后才会提交它们。
 */
async function getDeferredStoryImage(image: ImageMetadata) {
  const output = await getImage({
    src: image,
    widths: shortStoryMediaWidths,
    sizes: shortStoryMediaSizes,
  });

  return {
    src: output.src,
    srcset: output.srcSet.attribute,
    width: output.attributes.width,
    height: output.attributes.height,
  };
}

/** 头像固定为同一 128px 输出，让摘要与署名复用浏览器的请求和解码缓存。 */
async function getDeferredStoryAvatar(image: ImageMetadata) {
  const output = await getImage({ src: image, width: 128, height: 128 });

  return {
    src: output.src,
    width: output.attributes.width,
    height: output.attributes.height,
  };
}

/** 已确认玩家与本地头像的唯一绑定，供多人主故事和随机短故事共用。 */
const communityPlayerAvatarByName: Readonly<Record<string, ImageMetadata>> = {
  Acatine: acatineAvatar,
  Hot945: hot945Avatar,
  Katsuta_Minamoto: katsutaMinamotoAvatar,
  LanYuvu: lanYuvuAvatar,
  Complex_Colors: complexColorsAvatar,
};

/** 为已确认玩家注入构建期本地头像，避免访客浏览时请求外部皮肤服务。 */
function getCommunityPlayerAvatar(playerName: string): ImageMetadata {
  const avatar = communityPlayerAvatarByName[playerName];

  if (!avatar) {
    throw new Error(`同岸玩家 ${playerName} 缺少本地头像。`);
  }

  return avatar;
}

/** 共同经历图片与已确认建设者头像按稳定故事身份绑定。 */
const memoryAssetById = {
  "new-year-2026": { image: newYear2026Image },
  "pulan-south-extension-trial": {
    image: pulanSouthExtensionTrialImage,
    avatar: acatineAvatar,
  },
  "kitariku-lightrail-trial": {
    image: kitarikuLightrailTrialImage,
    avatar: katsutaMinamotoAvatar,
  },
} satisfies Readonly<
  Record<HomeCommunityMemoryStoryId, { image: ImageMetadata; avatar?: ImageMetadata }>
>;

/** 日常故事的图片与本地玩家头像在 Astro 构建边界统一注入。 */
const presenceAssetById = {
  "presence-neo-fueya-maintenance": {
    image: acatineNeoFueyaMaintenanceImage,
    avatar: acatineAvatar,
  },
  "presence-pyutocor-lighting": {
    image: hot945PyutocorLightingImage,
    avatar: hot945Avatar,
  },
  "presence-bayside-railway": {
    image: lanYuvuBaysideRailwayImage,
    avatar: lanYuvuAvatar,
  },
  "presence-fueya-renewal": {
    image: complexColorsFueyaRenewalImage,
    avatar: complexColorsAvatar,
  },
  "presence-nktr-tram": {
    image: katsutaMinamotoNktrTramImage,
    avatar: katsutaMinamotoAvatar,
  },
} satisfies Readonly<
  Record<HomeCommunityPresenceStoryId, { image: ImageMetadata; avatar: ImageMetadata }>
>;

const mainStory = {
  ...homeCommunityStories.main,
  media: {
    ...homeCommunityStories.main.media,
    image: surcentralRebuildImage,
  },
  players: homeCommunityStories.main.players?.map((player) => ({
    ...player,
    avatar: getCommunityPlayerAvatar(player.name),
  })),
  message: communityMessages.featureStoryById[homeCommunityStories.main.id],
};
const mainStoryPlayers = mainStory.hasPublicCredit ? (mainStory.players ?? []) : [];
const mainStoryDescriptionSegments = segmentHomeCommunityPlayerText(
  mainStory.message.description,
  mainStoryPlayers,
);
const mainStoryDetailSegments = segmentHomeCommunityPlayerText(
  mainStory.message.detail,
  mainStoryPlayers,
);
const memoryStories = await Promise.all(homeCommunityStories.memory.map(async (story) => {
  const assets = memoryAssetById[story.id];

  return {
    ...story,
    media: {
      ...story.media,
      image: assets.image,
      deferredImage: await getDeferredStoryImage(assets.image),
    },
    player:
      story.player && "avatar" in assets
        ? {
            ...story.player,
            avatar: assets.avatar,
            deferredAvatar: await getDeferredStoryAvatar(assets.avatar),
          }
        : undefined,
    message: communityMessages.featureStoryById[story.id],
  };
}));
const presenceStories = await Promise.all(homeCommunityStories.presence.map(async (story) => {
  const assets = presenceAssetById[story.id];

  return {
    ...story,
    media: {
      ...story.media,
      image: assets.image,
      deferredImage: await getDeferredStoryImage(assets.image),
    },
    player: {
      ...story.player,
      avatar: assets.avatar,
      deferredAvatar: await getDeferredStoryAvatar(assets.avatar),
    },
    message: communityMessages.presenceStoryById[story.id],
  };
}));
const titleId = "home-community-title";
const mainStoryTitleId = "home-community-main-story-title";
---

<section
  class="home-community"
  data-home-community
  data-home-community-locale={locale}
  aria-labelledby={titleId}
  style={`--home-community-line-color: ${lineColor};`}
>
  <span class="home-community__track" data-home-community-track aria-hidden="true"></span>

  <header class="home-community__introduction">
    <p class="home-community__eyebrow">{communityMessages.introHeading}</p>
    <div class="home-community__heading-line">
      <span class="home-community__station-spur" aria-hidden="true"></span>
      <h2 id={titleId}>{communityMessages.statement}</h2>
    </div>
    <p>{communityMessages.introduction}</p>
  </header>

  <article
    class="home-community__main-story"
    data-home-community-main-story
    aria-labelledby={mainStoryTitleId}
  >
    <div class="home-community__main-stage">
      <div
        class="home-community__main-media"
        style={`--home-community-media-focus: ${mainStory.media.focalPoint};`}
      >
        <Image
          src={mainStory.media.image}
          alt={mainStory.message.imageAlt}
          widths={[960, 1440, 1920, 2560]}
          sizes="100vw"
          loading="lazy"
        />
      </div>
      <span class="home-community__main-veil" aria-hidden="true"></span>

      <div class="home-community__main-detail">
        <p class="home-community__main-kicker">{mainStory.message.label}</p>
        <div class="home-community__heading-line">
          <span class="home-community__station-spur" aria-hidden="true"></span>
          <h3 id={mainStoryTitleId}>{mainStory.message.title}</h3>
        </div>
        <div class="home-community__main-narrative">
          <p>
            {
              mainStoryDescriptionSegments.map((segment) =>
                segment.type === "player" ? (
                  <span class="home-community__inline-player home-community__inline-player--main">
                    <Image
                      src={segment.player.avatar}
                      alt=""
                      width={128}
                      height={128}
                      loading="lazy"
                    />
                    <strong>{segment.player.name}</strong>
                  </span>
                ) : (
                  segment.value
                ),
              )
            }
          </p>
          <p>
            {
              mainStoryDetailSegments.map((segment) =>
                segment.type === "player" ? (
                  <span class="home-community__inline-player home-community__inline-player--main">
                    <Image
                      src={segment.player.avatar}
                      alt=""
                      width={128}
                      height={128}
                      loading="lazy"
                    />
                    <strong>{segment.player.name}</strong>
                  </span>
                ) : (
                  segment.value
                ),
              )
            }
          </p>
        </div>
      </div>
    </div>
  </article>

  <section class="home-community__short-stories" aria-label={communityMessages.label}>
    {
      memoryStories.map((story, index) => {
        const memoryStoryTitleId = `home-community-memory-story-${story.id}`;

        return (
          <article
            class="home-community__short-story home-community__short-story--memory"
            data-home-community-memory-story={story.id}
            aria-labelledby={memoryStoryTitleId}
            hidden={index !== 0}
          >
            <div class="home-community__short-heading">
              <p>{story.message.label}</p>
              <div class="home-community__heading-line">
                <span class="home-community__station-spur" aria-hidden="true"></span>
                <h3 id={memoryStoryTitleId}>{story.message.title}</h3>
              </div>
            </div>

            <p class="home-community__short-excerpt">
              {
                story.player && (
                  <span
                    class="home-community__inline-player"
                    aria-label={`${communityMessages.playerLabel}: ${story.player.name}`}
                  >
                    {index === 0 ? (
                      <Image
                        src={story.player.avatar}
                        alt=""
                        width={128}
                        height={128}
                        loading="lazy"
                      />
                    ) : (
                      <img
                        data-home-community-deferred-src={story.player.deferredAvatar.src}
                        data-home-community-deferred-alt=""
                        width={story.player.deferredAvatar.width}
                        height={story.player.deferredAvatar.height}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <strong>{story.player.name}</strong>
                  </span>
                )
              }
              <span>{story.message.description}</span>
            </p>

            <details class="home-community__story-details home-community__story-details--memory">
              <summary>
                <span
                  class="home-community__short-media"
                  style={`--home-community-media-focus: ${story.media.focalPoint};`}
                >
                  {index === 0 ? (
                    <Image
                      src={story.media.image}
                      alt={story.message.imageAlt}
                      widths={shortStoryMediaWidths}
                      sizes={shortStoryMediaSizes}
                      loading="lazy"
                    />
                  ) : (
                    <picture data-home-community-deferred-picture>
                      <img
                        data-home-community-deferred-src={story.media.deferredImage.src}
                        data-home-community-deferred-srcset={story.media.deferredImage.srcset}
                        data-home-community-deferred-sizes={shortStoryMediaSizes}
                        data-home-community-deferred-alt={story.message.imageAlt}
                        width={story.media.deferredImage.width}
                        height={story.media.deferredImage.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  )}
                </span>
                <span class="home-community__story-hint">
                  <span
                    class="home-community__story-hint-icon"
                    set:html={cursorClickIcon}
                    aria-hidden="true"
                  />
                  <span>
                    <span data-home-community-story-open-label>
                      {communityMessages.storyOpenLabel}
                    </span>
                    <span data-home-community-story-close-label>
                      {communityMessages.storyCloseLabel}
                    </span>
                  </span>
                </span>
              </summary>

              <div class="home-community__short-body">
                <p>{story.message.detail}</p>
                {story.player ? (
                  <p
                    class="home-community__player-credit"
                    aria-label={`${communityMessages.playerLabel}: ${story.player.name}`}
                  >
                    {index === 0 ? (
                      <Image
                        src={story.player.avatar}
                        alt=""
                        width={128}
                        height={128}
                        loading="lazy"
                      />
                    ) : (
                      <img
                        data-home-community-deferred-src={story.player.deferredAvatar.src}
                        data-home-community-deferred-alt=""
                        width={story.player.deferredAvatar.width}
                        height={story.player.deferredAvatar.height}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <span>{story.player.name}</span>
                  </p>
                ) : story.hasPublicCredit ? (
                  <p class="home-community__credit">
                    <span>{communityMessages.creditLabel}</span>
                    {story.message.credit}
                  </p>
                ) : null}
              </div>
            </details>
          </article>
        );
      })
    }

    <section class="home-community__presence">
      {
        presenceStories.map((story, index) => {
          const presenceTitleId = `home-community-presence-story-${story.id}`;

          return (
            <article
              class="home-community__short-story home-community__short-story--presence"
              data-home-community-presence-story={story.id}
              aria-labelledby={presenceTitleId}
              hidden={index !== 0}
            >
              <div class="home-community__short-heading">
                <p>{story.message.label}</p>
                <div class="home-community__heading-line">
                  <span class="home-community__station-spur" aria-hidden="true"></span>
                  <h3 id={presenceTitleId}>{story.message.title}</h3>
                </div>
              </div>

              <p class="home-community__short-excerpt">
                <span
                  class="home-community__inline-player"
                  aria-label={`${communityMessages.playerLabel}: ${story.player.name}`}
                >
                  {index === 0 ? (
                    <Image
                      src={story.player.avatar}
                      alt=""
                      width={128}
                      height={128}
                      loading="lazy"
                    />
                  ) : (
                    <img
                      data-home-community-deferred-src={story.player.deferredAvatar.src}
                      data-home-community-deferred-alt=""
                      width={story.player.deferredAvatar.width}
                      height={story.player.deferredAvatar.height}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <strong>{story.player.name}</strong>
                </span>
                <span>{story.message.description}</span>
              </p>
              <details class="home-community__story-details home-community__story-details--presence">
                <summary>
                  <span
                    class="home-community__short-media"
                    style={`--home-community-media-focus: ${story.media.focalPoint};`}
                  >
                    {index === 0 ? (
                      <Image
                        src={story.media.image}
                        alt={story.message.imageAlt}
                        widths={shortStoryMediaWidths}
                        sizes={shortStoryMediaSizes}
                        loading="lazy"
                      />
                    ) : (
                      <picture data-home-community-deferred-picture>
                        <img
                          data-home-community-deferred-src={story.media.deferredImage.src}
                          data-home-community-deferred-srcset={story.media.deferredImage.srcset}
                          data-home-community-deferred-sizes={shortStoryMediaSizes}
                          data-home-community-deferred-alt={story.message.imageAlt}
                          width={story.media.deferredImage.width}
                          height={story.media.deferredImage.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    )}
                  </span>
                  <span class="home-community__story-hint">
                    <span
                      class="home-community__story-hint-icon"
                      set:html={cursorClickIcon}
                      aria-hidden="true"
                    />
                    <span>
                      <span data-home-community-story-open-label>
                        {communityMessages.storyOpenLabel}
                      </span>
                      <span data-home-community-story-close-label>
                        {communityMessages.storyCloseLabel}
                      </span>
                    </span>
                  </span>
                </summary>
                <div class="home-community__presence-story-copy">
                  <p>{story.message.detail}</p>
                  <p
                    class="home-community__player-credit"
                    aria-label={`${communityMessages.playerLabel}: ${story.player.name}`}
                  >
                    {index === 0 ? (
                      <Image
                        src={story.player.avatar}
                        alt=""
                        width={128}
                        height={128}
                        loading="lazy"
                      />
                    ) : (
                      <img
                        data-home-community-deferred-src={story.player.deferredAvatar.src}
                        data-home-community-deferred-alt=""
                        width={story.player.deferredAvatar.width}
                        height={story.player.deferredAvatar.height}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <span>{story.player.name}</span>
                  </p>
                </div>
              </details>
            </article>
          );
        })
      }
    </section>
  </section>

  <footer class="home-community__closing">
    <div class="home-community__heading-line">
      <span class="home-community__station-spur" aria-hidden="true"></span>
      <h3>{communityMessages.closingTitle}</h3>
    </div>
    <p>{communityMessages.closingDescription}</p>
  </footer>
</section>

<script>
  import {
    HOME_COMMUNITY_LAST_MEMORY_SESSION_KEY,
    HOME_COMMUNITY_LAST_PRESENCE_SESSION_KEY,
    getHomeCommunityMainStoryMotionState,
    homeCommunityStories,
    selectHomeCommunityMemoryStoryId,
    selectHomeCommunityPresenceStoryId,
  } from "@/data/home-community";
  import { getHomePageFrameCoordinator } from "@/data/home-route-viewport";

  /** 同岸主故事从统一 read 阶段传到 write 阶段的纯数值状态。 */
  interface HomeCommunityFrameMeasurement {
    /** 只有桌面且未启用减少动态时才由脚本提交逐帧视觉。 */
    enhanced: boolean;
    /** 图片舞台的受控滚动进度。 */
    sceneProgress: number;
    /** 深色遮罩的过渡进度。 */
    veilProgress: number;
    /** 详情正文的显现进度。 */
    detailProgress: number;
  }

  /** 为页面中的同岸实例轮换两个短故事池，并初始化主故事滚动交互。 */
  function setupHomeCommunitySection(communitySection: HTMLElement): void {
    /** 把构建期候选从延迟描述提交给浏览器；src 最后写入，避免中间态发出错误请求。 */
    const loadStoryImages = (storyElement: HTMLElement): void => {
      storyElement
        .querySelectorAll<HTMLImageElement>("img[data-home-community-deferred-src]")
        .forEach((image) => {
          const { homeCommunityDeferredSrc, homeCommunityDeferredSrcset } = image.dataset;

          if (!homeCommunityDeferredSrc) return;

          image.alt = image.dataset.homeCommunityDeferredAlt ?? "";
          if (image.dataset.homeCommunityDeferredSizes) {
            image.sizes = image.dataset.homeCommunityDeferredSizes;
          }
          if (homeCommunityDeferredSrcset) {
            image.srcset = homeCommunityDeferredSrcset;
          }
          image.src = homeCommunityDeferredSrc;
          image.removeAttribute("data-home-community-deferred-src");
          image.removeAttribute("data-home-community-deferred-srcset");
          image.removeAttribute("data-home-community-deferred-sizes");
          image.removeAttribute("data-home-community-deferred-alt");
        });
    };

    communitySection
      .querySelectorAll<HTMLDetailsElement>(".home-community__story-details")
      .forEach((details) => {
        details.addEventListener("toggle", () => {
          const storyElement = details.closest<HTMLElement>(".home-community__short-story");
          if (details.open && storyElement) loadStoryImages(storyElement);
        });
      });

    const memoryStoryElements = Array.from(
      communitySection.querySelectorAll<HTMLElement>("[data-home-community-memory-story]"),
    );

    if (memoryStoryElements.length > 0) {
      const validMemoryStoryIds = new Set<string>(
        homeCommunityStories.memory.map((story) => story.id),
      );
      let previousMemoryStoryId:
        | (typeof homeCommunityStories.memory)[number]["id"]
        | undefined;

      try {
        const storedStoryId = window.sessionStorage.getItem(
          HOME_COMMUNITY_LAST_MEMORY_SESSION_KEY,
        );

        if (storedStoryId && validMemoryStoryIds.has(storedStoryId)) {
          previousMemoryStoryId = storedStoryId as typeof previousMemoryStoryId;
        }
      } catch {
        // 禁用储存时仍展示一则共同经历，只是不再保证刷新后避开上一则。
      }

      const selectedMemoryStoryId = selectHomeCommunityMemoryStoryId(
        homeCommunityStories.memory,
        Math.random(),
        previousMemoryStoryId,
      );

      try {
        window.sessionStorage.setItem(
          HOME_COMMUNITY_LAST_MEMORY_SESSION_KEY,
          selectedMemoryStoryId,
        );
      } catch {
        // 所有共同经历都已随页面发布，储存不可用不会阻断当前内容。
      }

      memoryStoryElements.forEach((storyElement) => {
        const selected =
          storyElement.dataset.homeCommunityMemoryStory === selectedMemoryStoryId;
        if (selected) loadStoryImages(storyElement);
        storyElement.hidden = !selected;
      });
      communitySection.dataset.homeCommunityActiveMemoryStory = selectedMemoryStoryId;
    }

    const presenceStoryElements = Array.from(
      communitySection.querySelectorAll<HTMLElement>("[data-home-community-presence-story]"),
    );

    if (presenceStoryElements.length > 0) {
      const validStoryIds = new Set<string>(
        homeCommunityStories.presence.map((story) => story.id),
      );
      let previousStoryId: (typeof homeCommunityStories.presence)[number]["id"] | undefined;

      try {
        const storedStoryId = window.sessionStorage.getItem(
          HOME_COMMUNITY_LAST_PRESENCE_SESSION_KEY,
        );

        if (storedStoryId && validStoryIds.has(storedStoryId)) {
          previousStoryId = storedStoryId as typeof previousStoryId;
        }
      } catch {
        // 禁用储存时仍随机显示本次页面的一条故事，只是不再保证刷新后避开上一条。
      }

      const selectedStoryId = selectHomeCommunityPresenceStoryId(
        homeCommunityStories.presence,
        Math.random(),
        previousStoryId,
      );

      try {
        window.sessionStorage.setItem(
          HOME_COMMUNITY_LAST_PRESENCE_SESSION_KEY,
          selectedStoryId,
        );
      } catch {
        // 头像与故事都已随页面发布，储存不可用不会阻断当前内容。
      }

      presenceStoryElements.forEach((storyElement) => {
        const selected = storyElement.dataset.homeCommunityPresenceStory === selectedStoryId;
        if (selected) loadStoryImages(storyElement);
        storyElement.hidden = !selected;
      });
      communitySection.dataset.homeCommunityActivePresenceStory = selectedStoryId;
    }

    const mainStory = communitySection.querySelector<HTMLElement>(
      "[data-home-community-main-story]",
    );
    const mainStage = mainStory?.querySelector<HTMLElement>(
      ".home-community__main-stage",
    );
    const mainVeil = mainStage?.querySelector<HTMLElement>(
      ".home-community__main-veil",
    );
    const mainNarrative = mainStage?.querySelector<HTMLElement>(
      ".home-community__main-narrative",
    );
    if (!mainStory || !mainStage || !mainVeil || !mainNarrative) return;

    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const frameCoordinator = getHomePageFrameCoordinator();
    let isCommunityActive = true;

    /** 在统一帧 read 阶段读取主故事几何并计算纯数值动画状态。 */
    const readMainStoryFrame = (): HomeCommunityFrameMeasurement => {
      const enhanced = desktopQuery.matches && !reducedMotionQuery.matches;
      let rawProgress = 1;

      if (enhanced) {
        const bounds = mainStory.getBoundingClientRect();
        const scrollTravel = Math.max(1, bounds.height - mainStage.offsetHeight);
        rawProgress = -bounds.top / scrollTravel;
      }

      return { enhanced, ...getHomeCommunityMainStoryMotionState(rawProgress) };
    };

    /** 只在动画目标值改变时写入行内样式，避免重复触发局部样式失效。 */
    const setAnimatedStyle = (
      element: HTMLElement,
      property: "opacity" | "transform",
      value: string,
    ): void => {
      if (element.style[property] !== value) {
        element.style[property] = value;
      }
    };

    /** 在统一帧 write 阶段直接更新消费元素，不让父节点变量使整棵故事子树失效。 */
    const writeMainStoryFrame = (state: HomeCommunityFrameMeasurement): void => {
      if (!state.enhanced) {
        mainVeil.style.removeProperty("opacity");
        mainNarrative.style.removeProperty("opacity");
        mainNarrative.style.removeProperty("transform");
      } else {
        setAnimatedStyle(mainVeil, "opacity", String(state.veilProgress * 0.76));
        setAnimatedStyle(mainNarrative, "opacity", String(state.detailProgress));
        setAnimatedStyle(
          mainNarrative,
          "transform",
          `translateY(${(1 - state.detailProgress) * 34}px)`,
        );
      }

      const phase = state.detailProgress >= 0.5 ? "detail" : "scene";
      if (mainStory.dataset.homeCommunityMainPhase !== phase) {
        mainStory.dataset.homeCommunityMainPhase = phase;
      }
    };

    const unregisterFrameParticipant = frameCoordinator.register({
      isActive: () => isCommunityActive,
      read: readMainStoryFrame,
      write: writeMainStoryFrame,
    });
    const requestMainStoryFrame = (): void => frameCoordinator.request();
    const communityVisibilityObserver = new IntersectionObserver(
      ([entry]) => {
        isCommunityActive = entry?.isIntersecting ?? false;
        if (isCommunityActive) {
          requestMainStoryFrame();
        }
      },
      { rootMargin: "100% 0px" },
    );
    communityVisibilityObserver.observe(communitySection);

    /* 响应式或减少动态边界切换时同步校正，避免 CSS 已换分支而进度仍停留一帧。 */
    desktopQuery.addEventListener("change", requestMainStoryFrame);
    reducedMotionQuery.addEventListener("change", requestMainStoryFrame);
    window.addEventListener("pageshow", requestMainStoryFrame);
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) {
        communityVisibilityObserver.disconnect();
        unregisterFrameParticipant();
      }
    });
    requestMainStoryFrame();
  }

  document
    .querySelectorAll<HTMLElement>("[data-home-community]")
    .forEach(setupHomeCommunitySection);
</script>

