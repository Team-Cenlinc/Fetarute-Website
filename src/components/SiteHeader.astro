---
import { primaryNavItems, siteInfo, wayfindingPrototype } from "@/data/site";
---

<header class="site-header" aria-label="站点顶部导航">
  <a class="brand" href="/" aria-label={`${siteInfo.name} 首页`}>
    <img
      class="brand-mark"
      src="/favicon-96x96.png"
      width="34"
      height="34"
      alt=""
      aria-hidden="true"
    />
    <span class="brand-copy">
      <strong>{siteInfo.name}</strong>
      <small>{wayfindingPrototype.routeName}</small>
    </span>
  </a>

  <span class="route-code" aria-label={`${wayfindingPrototype.routeName} 线路代号`}>
    {wayfindingPrototype.routeCode}
  </span>

  <nav class="nav-links" aria-label="主导航">
    {
      primaryNavItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
