---
import arrowUpRightIcon from "@phosphor-icons/core/assets/bold/arrow-up-right-bold.svg?raw";
import circleHalfIcon from "@phosphor-icons/core/assets/bold/circle-half-bold.svg?raw";
import dotsThreeIcon from "@phosphor-icons/core/assets/bold/dots-three-bold.svg?raw";
import infoIcon from "@phosphor-icons/core/assets/bold/info-bold.svg?raw";
import listIcon from "@phosphor-icons/core/assets/bold/list-bold.svg?raw";
import moonIcon from "@phosphor-icons/core/assets/bold/moon-bold.svg?raw";
import sunIcon from "@phosphor-icons/core/assets/bold/sun-bold.svg?raw";
import translateIcon from "@phosphor-icons/core/assets/bold/translate-bold.svg?raw";
import fetaruteLogo from "@/assets/fetarute-branding/fetarute-logo.svg?raw";
import { getRailwayLineCssVariableName } from "@/data/palette";
import { railwayLineByKey } from "@/data/railway";
import { primaryNavItems, wayfindingPrototype } from "@/data/site";
import { localeMetadata, locales, type Locale } from "@/i18n/config";
import { getLocalizedRelativeUrl } from "@/i18n/links";
import { getMessages } from "@/i18n/messages";

/**
 * 固定顶部导视导航的属性。
 * 当前语言决定链接、菜单文字和无障碍标签，保证切换语言后仍停留在相同的公开首页路径。
 */
export interface Props {
  /** 当前页面所属的公开语言。 */
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);

/**
 * 供首页装饰信号选择的 CSS 线路 token。
 * 先由 site.ts 的身份白名单筛选，再在此解析为 palette token，避免客户端持有或复制任何十六进制线路色。
 */
const homeNavigationSignalLineCssVariables = wayfindingPrototype.homeNavigationSignal.lineKeys.map(
  (lineKey) => {
    const line = railwayLineByKey.get(lineKey);

    if (!line) {
      throw new Error(`首页导视信号引用了未录入的线路：${lineKey}。`);
    }

    return getRailwayLineCssVariableName(line);
  },
);

/**
 * 手动外观切换的三种稳定选项。
 * “跟随系统”不写入强制值，其余两项与 BaseLayout 的 palette CSS 变量一一对应。
 */
const appearanceOptions = [
  { value: "system", label: messages.appearanceOptions.system, icon: circleHalfIcon },
  { value: "light", label: messages.appearanceOptions.light, icon: sunIcon },
  { value: "dark", label: messages.appearanceOptions.dark, icon: moonIcon },
] as const;
---

<script
  is:inline
  define:vars={{
    homeNavigationSignalLineCssVariables,
    homeNavigationSignalDoubleLineProbability:
      wayfindingPrototype.homeNavigationSignal.doubleLineProbability,
  }}
>
  (() => {
    // 同一 tab 内固定轨网信号，避免语言切换或普通导航让 Header 的线路身份来回跳变。
    const homeNavigationSignalStorageKey = "fetarute.home-navigation-signal";

    /** 生成 0（含）到 1（不含）的随机数；优先使用密码学随机源，受限环境才退回浏览器默认随机源。 */
    function getHomeNavigationSignalRandom() {
      try {
        const randomValues = new Uint32Array(1);
        window.crypto.getRandomValues(randomValues);
        return randomValues[0] / 2 ** 32;
      } catch {
        return Math.random();
      }
    }

    /** 验证会话缓存仍引用当前构建所允许的线路 token，部署更新后忽略过期或手改的存储值。 */
    function isHomeNavigationSignal(value) {
      return (
        value !== null &&
        typeof value === "object" &&
        "cssVariables" in value &&
        "pattern" in value &&
        Array.isArray(value.cssVariables) &&
        value.cssVariables.every(
          (cssVariable) =>
            typeof cssVariable === "string" &&
            homeNavigationSignalLineCssVariables.includes(cssVariable),
        ) &&
        ((value.pattern === "single" && value.cssVariables.length === 1) ||
          (value.pattern === "double" &&
            value.cssVariables.length === 2 &&
            value.cssVariables[0] !== value.cssVariables[1]))
      );
    }

    /** 从已核准的线路 token 与配置好的单双线形态中抽取一次新的纯装饰性信号。 */
    function createHomeNavigationSignal() {
      if (homeNavigationSignalLineCssVariables.length === 0) {
        return null;
      }

      const lineIndex = Math.floor(
        getHomeNavigationSignalRandom() * homeNavigationSignalLineCssVariables.length,
      );
      const primaryCssVariable = homeNavigationSignalLineCssVariables[lineIndex];
      const isDoubleLine =
        homeNavigationSignalLineCssVariables.length > 1 &&
        getHomeNavigationSignalRandom() < homeNavigationSignalDoubleLineProbability;

      if (!isDoubleLine) {
        return {
          cssVariables: [primaryCssVariable],
          pattern: "single",
        };
      }

      // 第二色从去除首色后的候选中抽取，保证并列圆点和双色色带始终包含两条不同线路。
      const secondaryCssVariables = homeNavigationSignalLineCssVariables.filter(
        (cssVariable) => cssVariable !== primaryCssVariable,
      );
      const secondaryIndex = Math.floor(
        getHomeNavigationSignalRandom() * secondaryCssVariables.length,
      );

      return {
        cssVariables: [primaryCssVariable, secondaryCssVariables[secondaryIndex]],
        pattern: "double",
      };
    }

    let homeNavigationSignal = null;
    let canPersistHomeNavigationSignal = true;

    try {
      const storedSignal = window.sessionStorage.getItem(homeNavigationSignalStorageKey);
      let parsedSignal = null;

      try {
        parsedSignal = storedSignal ? JSON.parse(storedSignal) : null;
      } catch {
        // 仅忽略损坏的历史缓存；存储本身仍可用时会以当前构建的有效信号覆盖它。
      }

      if (isHomeNavigationSignal(parsedSignal)) {
        homeNavigationSignal = parsedSignal;
      }
    } catch {
      // 私密浏览或受限存储下不选择随机信号，保持 BaseLayout 提供的确定线路色。
      canPersistHomeNavigationSignal = false;
    }

    if (canPersistHomeNavigationSignal && !homeNavigationSignal) {
      const nextHomeNavigationSignal = createHomeNavigationSignal();

      try {
        if (nextHomeNavigationSignal) {
          window.sessionStorage.setItem(
            homeNavigationSignalStorageKey,
            JSON.stringify(nextHomeNavigationSignal),
          );

          homeNavigationSignal = nextHomeNavigationSignal;
        }
      } catch {
        // 只有成功写入才应用随机信号；否则回退到页面已有的确定线路色。
      }
    }

    if (homeNavigationSignal) {
      document.documentElement.style.setProperty(
        "--home-nav-line-color",
        `var(${homeNavigationSignal.cssVariables[0]})`,
      );

      if (homeNavigationSignal.pattern === "double") {
        document.documentElement.style.setProperty(
          "--home-nav-line-color-secondary",
          `var(${homeNavigationSignal.cssVariables[1]})`,
        );
      } else {
        document.documentElement.style.removeProperty("--home-nav-line-color-secondary");
      }

      document.documentElement.dataset.homeNavIndicatorPattern = homeNavigationSignal.pattern;
    }
  })();
</script>

<header class="site-header" aria-label={messages.headerLabel}>
  <a class="brand" href={getLocalizedRelativeUrl(locale)} aria-label={messages.brandHomeLabel}>
    <span class="brand-wordmark" aria-hidden="true" set:html={fetaruteLogo}></span>
  </a>

  <div class="mobile-header-tools">
    <details class="mobile-header-tool mobile-header-tool--service" data-header-menu>
      <summary class="mobile-header-tool__summary" aria-label={messages.languageNavigationLabel}>
        <span class="mobile-header-tool__icon" aria-hidden="true" set:html={translateIcon}></span>
      </summary>

      <div
        class="mobile-header-tool__menu"
        data-header-menu-panel
        aria-labelledby="mobile-language-menu-label"
      >
        <section class="service-menu__group" aria-labelledby="mobile-language-menu-label">
          <h2 id="mobile-language-menu-label" class="service-menu__heading">
            {messages.languageNavigationLabel}
          </h2>
          <nav class="language-links" aria-label={messages.languageNavigationLabel}>
            {
              locales.map((alternateLocale) => (
                <a
                  class="language-link"
                  href={getLocalizedRelativeUrl(alternateLocale)}
                  lang={localeMetadata[alternateLocale].languageTag}
                  aria-label={localeMetadata[alternateLocale].label}
                  aria-current={alternateLocale === locale ? "page" : undefined}
                >
                  {localeMetadata[alternateLocale].shortLabel}
                </a>
              ))
            }
          </nav>
        </section>
      </div>
    </details>

    <details class="mobile-header-tool mobile-header-tool--service" data-header-menu>
      <summary class="mobile-header-tool__summary" aria-label={messages.appearanceNavigationLabel}>
        <span class="mobile-header-tool__icon" aria-hidden="true" set:html={circleHalfIcon}></span>
      </summary>

      <div
        class="mobile-header-tool__menu"
        data-header-menu-panel
        aria-labelledby="mobile-appearance-menu-label"
      >
        <section class="service-menu__group" aria-labelledby="mobile-appearance-menu-label">
          <h2 id="mobile-appearance-menu-label" class="service-menu__heading">
            {messages.appearanceNavigationLabel}
          </h2>
          <div class="appearance-options">
            {
              appearanceOptions.map((option) => (
                <button
                  class="appearance-choice"
                  type="button"
                  data-appearance-choice={option.value}
                  aria-pressed="false"
                >
                  <span class="appearance-choice__icon" aria-hidden="true" set:html={option.icon}></span>
                  <span>{option.label}</span>
                </button>
              ))
            }
          </div>
        </section>
      </div>
    </details>

    <details class="mobile-header-tool mobile-header-tool--destination" data-header-menu>
      <summary class="mobile-header-tool__summary" aria-label={messages.destinationMenuLabel}>
        <span class="mobile-header-tool__icon" aria-hidden="true" set:html={dotsThreeIcon}></span>
      </summary>

      <div
        class="mobile-header-tool__menu mobile-destination-menu__panel"
        data-header-menu-panel
        aria-labelledby="mobile-destination-menu-label"
      >
        <div class="mobile-destination-menu__heading">
          <h2 id="mobile-destination-menu-label" class="service-menu__heading">
            {messages.destinationMenuLabel}
          </h2>
          <p>{messages.destinationMenuHint}</p>
        </div>
        <nav class="mobile-destination-menu__links" aria-label={messages.navigationLabel}>
          {
            primaryNavItems.map((item) => (
              <a
                href={
                  item.fragment === "home"
                    ? getLocalizedRelativeUrl(locale)
                    : getLocalizedRelativeUrl(locale, "", item.fragment)
                }
                aria-current={item.fragment === "home" ? "page" : undefined}
              >
                <span>{messages.navigation[item.labelKey]}</span>
                <span aria-hidden="true" set:html={arrowUpRightIcon}></span>
              </a>
            ))
          }
        </nav>
      </div>
    </details>
  </div>

  <span class="site-header__spacer" aria-hidden="true"></span>

  <a class="home-nav" href={getLocalizedRelativeUrl(locale)} aria-label={messages.navigation.home}>
    <span class="home-nav__primary">
      <span class="home-nav__text-stack">
        <span class="home-nav__label">{messages.navigation.home}</span>
        <span class="home-nav__indicator" aria-hidden="true">
          <span class="home-nav__indicator-dot"></span>
          <span class="home-nav__indicator-band"></span>
        </span>
      </span>
      <span class="home-nav__arrow" aria-hidden="true" set:html={arrowUpRightIcon}></span>
    </span>
  </a>

  <details class="service-desk" data-header-menu>
    <summary class="service-desk__summary" aria-label={messages.serviceDeskLabel}>
      <span class="service-desk__direction">
        <span class="service-desk__copy">
          <span class="service-desk__label">{messages.serviceDeskLabel}</span>
          <span class="service-desk__marker-row" aria-hidden="true">
            <span class="service-desk__marker" set:html={translateIcon}></span>
            <span class="service-desk__marker" set:html={circleHalfIcon}></span>
          </span>
        </span>
        <span class="service-desk__information" aria-hidden="true" set:html={infoIcon}></span>
      </span>
    </summary>

    <div class="service-desk__menu" data-header-menu-panel aria-label={messages.serviceDeskLabel}>
      <section class="service-menu__group" aria-labelledby="language-menu-label">
        <h2 id="language-menu-label" class="service-menu__heading">
          {messages.languageNavigationLabel}
        </h2>
        <nav class="language-links" aria-label={messages.languageNavigationLabel}>
          {
            locales.map((alternateLocale) => (
              <a
                class="language-link"
                href={getLocalizedRelativeUrl(alternateLocale)}
                lang={localeMetadata[alternateLocale].languageTag}
                aria-label={localeMetadata[alternateLocale].label}
                aria-current={alternateLocale === locale ? "page" : undefined}
              >
                {localeMetadata[alternateLocale].shortLabel}
              </a>
            ))
          }
        </nav>
      </section>

      <section class="service-menu__group" aria-labelledby="appearance-menu-label">
        <h2 id="appearance-menu-label" class="service-menu__heading">
          {messages.appearanceNavigationLabel}
        </h2>
        <div class="appearance-options">
          {
            appearanceOptions.map((option) => (
              <button
                class="appearance-choice"
                type="button"
                data-appearance-choice={option.value}
                aria-pressed="false"
              >
                <span class="appearance-choice__icon" aria-hidden="true" set:html={option.icon}></span>
                <span>{option.label}</span>
              </button>
            ))
          }
        </div>
      </section>
    </div>
  </details>

  <span class="exit-menu">
    <span class="exit-menu__direction">
      <span class="exit-menu__copy">
        <span class="exit-menu__primary">
          <span class="exit-menu__label">{messages.destinationMenuLabel}</span>
        </span>
        <span class="exit-menu__hint">{messages.destinationMenuHint}</span>
      </span>
      <span class="exit-menu__arrow" aria-hidden="true" set:html={arrowUpRightIcon}></span>
    </span>
  </span>

  <details class="compact-exit-menu" data-header-menu>
    <summary class="compact-exit-menu__summary" aria-label={messages.destinationMenuLabel}>
      <span class="compact-exit-menu__icon" aria-hidden="true" set:html={listIcon}></span>
    </summary>
    <div
      class="compact-exit-menu__menu mobile-destination-menu__panel"
      data-header-menu-panel
      aria-labelledby="desktop-destination-menu-label"
    >
      <div class="mobile-destination-menu__heading">
        <h2 id="desktop-destination-menu-label" class="service-menu__heading">
          {messages.destinationMenuLabel}
        </h2>
        <p>{messages.destinationMenuHint}</p>
      </div>
      <nav class="mobile-destination-menu__links" aria-label={messages.navigationLabel}>
        {
          primaryNavItems.map((item) => (
            <a
              href={
                item.fragment === "home"
                  ? getLocalizedRelativeUrl(locale)
                  : getLocalizedRelativeUrl(locale, "", item.fragment)
              }
              aria-current={item.fragment === "home" ? "page" : undefined}
            >
              <span>{messages.navigation[item.labelKey]}</span>
              <span aria-hidden="true" set:html={arrowUpRightIcon}></span>
            </a>
          ))
        }
      </nav>
    </div>
  </details>
</header>

<script>
  // 与 BaseLayout 的首帧读取共用同一键，用户点击后立即更新根节点 palette 与菜单选中态。
  const appearanceStorageKey = "fetarute.appearance";
  const appearanceChoices = ["system", "light", "dark"];
  const appearanceButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-appearance-choice]"),
  );
  const headerMenus = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-header-menu]"));
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  /** 向下阅读超过此距离才收束导视牌，避免首屏与短距离定位滚动反复改变 Header 密度。 */
  const compactHeaderScrollThreshold = 160;
  /** 小于此差值的滚动抖动不改变模式，触控板慢速停靠时仍保持稳定。 */
  const compactHeaderScrollDirectionThreshold = 8;
  let lastHeaderScrollPosition = window.scrollY;
  let compactHeaderAnimationFrame: number | undefined;
  /** 首次同步只校准锚点或历史记录带来的初始状态，不把页面加载误读成一次用户触发的收缩。 */
  let hasSyncedCompactHeaderState = false;
  /** 最近一次有效滚动方向；阅读模式依赖这一连续语义，不再用单帧位置覆盖用户刚刚的上滑意图。 */
  let compactHeaderScrollDirection: "up" | "down" | undefined;
  /** 当前方向已累计的位移；向下只有达到滞后距离后才重新收束 Header。 */
  let compactHeaderScrollDirectionDistance = 0;
  /** 指针离开完整导视牌后的短暂缓冲，允许自然移向下方菜单而不立即折回紧凑态。 */
  const compactHeaderHoverContractDelay = 180;
  let compactHeaderHoverContractTimer: number | undefined;
  /** 内容交接的阶段只描述 live DOM 的可见性，禁止以旧新快照叠放来改变 Header 尺寸。 */
  type HeaderContentPhase =
    | "contracting"
    | "compact-entering"
    | "expanding"
    | "expanded-entering";
  /** 最近一次被接受的 Header 目标，重复 scroll 事件不会重启正在进行的同向交接。 */
  let headerLayoutIntent: { compact: boolean; hoverExpanded: boolean } | undefined;
  /** 每次新输入都会使上一段交接失效，保证快速反向从当前 live DOM 状态继续。 */
  let headerContentHandoffRun = 0;
  /** 用 AbortController 解除上一段 transitionend 监听，避免旧回调覆盖最新输入。 */
  let headerContentTransitionController: AbortController | undefined;

  /**
   * 将服务台中的外观选择同步到文档根节点和持久化设置。
   * 系统模式移除 data-appearance，让 CSS 媒体条件重新成为唯一的外观来源。
   */
  function applyAppearance(choice: string) {
    const selectedChoice = appearanceChoices.includes(choice) ? choice : "system";

    if (selectedChoice === "system") {
      document.documentElement.removeAttribute("data-appearance");
      try {
        window.localStorage.removeItem(appearanceStorageKey);
      } catch {
        // 存储不可用时仍可在当前页面完成外观切换。
      }
    } else {
      document.documentElement.dataset.appearance = selectedChoice;
      try {
        window.localStorage.setItem(appearanceStorageKey, selectedChoice);
      } catch {
        // 持久化失败不应阻断当前页面的可见反馈。
      }
    }

    appearanceButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.appearanceChoice === selectedChoice),
      );
    });
  }

  /**
   * 同步阅读中的紧凑导视状态。
   * 向下进入长内容后收成线路点与功能图标；用户一反向上滚便立即恢复完整牌面，保证回看与重新导航不需额外操作。
   */
  function syncCompactHeader() {
    const currentScrollPosition = window.scrollY;
    const scrollDelta = currentScrollPosition - lastHeaderScrollPosition;
    const nextScrollDirection = scrollDelta > 0 ? "down" : scrollDelta < 0 ? "up" : undefined;
    const isNearPageStart = currentScrollPosition < compactHeaderScrollThreshold;

    if (nextScrollDirection) {
      if (nextScrollDirection === compactHeaderScrollDirection) {
        compactHeaderScrollDirectionDistance += Math.abs(scrollDelta);
      } else {
        compactHeaderScrollDirection = nextScrollDirection;
        compactHeaderScrollDirectionDistance = Math.abs(scrollDelta);
      }
    }

    if (isNearPageStart) {
      setHeaderLayoutState(false, false, hasSyncedCompactHeaderState);
      cancelCompactHeaderHoverContract();
      compactHeaderScrollDirection = undefined;
      compactHeaderScrollDirectionDistance = 0;
    } else if (compactHeaderScrollDirection === "up") {
      setHeaderLayoutState(false, false, hasSyncedCompactHeaderState);
      cancelCompactHeaderHoverContract();
    } else if (
      compactHeaderScrollDirection === "down" &&
      compactHeaderScrollDirectionDistance >= compactHeaderScrollDirectionThreshold
    ) {
      setHeaderLayoutState(true, false, hasSyncedCompactHeaderState);
    } else if (compactHeaderScrollDirection === undefined) {
      // 页面因锚点、刷新或历史记录直接落在内容区时，仍以紧凑态作为无需额外输入的初始状态。
      setHeaderLayoutState(true, false, hasSyncedCompactHeaderState);
    }

    lastHeaderScrollPosition = currentScrollPosition;
    hasSyncedCompactHeaderState = true;
    compactHeaderAnimationFrame = undefined;
  }

  /** 将连续 scroll 事件压缩到浏览器绘制帧，避免阅读时为每个输入事件重复写入根节点状态。 */
  function scheduleCompactHeaderSync() {
    if (compactHeaderAnimationFrame !== undefined) {
      return;
    }

    compactHeaderAnimationFrame = window.requestAnimationFrame(syncCompactHeader);
  }

  /** 清除待执行的 hover 收束，防止指针回到 Header 时仍被过期计时器折回窄条。 */
  function cancelCompactHeaderHoverContract() {
    if (compactHeaderHoverContractTimer === undefined) {
      return;
    }

    window.clearTimeout(compactHeaderHoverContractTimer);
    compactHeaderHoverContractTimer = undefined;
  }

  /** 判断指针是否直接进入紧凑出口格；该格需要保留 sandwich 菜单的即时可操作性。 */
  function isCompactExitPointerTarget(event: PointerEvent) {
    return document.elementFromPoint(event.clientX, event.clientY)?.closest(".compact-exit-menu") !== null;
  }

  /** 只写入阅读态相关 attribute，集中保证所有入口都会得到同一份最终 DOM 状态。 */
  function applyHeaderLayoutState(nextCompact: boolean, nextHoverExpanded: boolean) {
    document.documentElement.toggleAttribute("data-header-compact", nextCompact);
    document.documentElement.toggleAttribute(
      "data-header-hover-expanded",
      nextCompact && nextHoverExpanded,
    );
  }

  /** 只在桌面密度之间交接内容；小屏本来就是图标导视，保持其现有即时结构。 */
  function canStageHeaderContentHandoff() {
    return (
      !prefersReducedHeaderMotion() &&
      window.matchMedia("(min-width: 761px)").matches &&
      siteHeader !== null
    );
  }

  /** 读取当前视觉密度；hover 展开虽然保留 compact 语义，但画面仍是完整导视牌。 */
  function isHeaderVisuallyCompact() {
    return (
      document.documentElement.hasAttribute("data-header-compact") &&
      !document.documentElement.hasAttribute("data-header-hover-expanded")
    );
  }

  /** 写入内容交接阶段；ready 表示新密度已经就位，可以让目标内容开始淡入。 */
  function setHeaderContentPhase(phase: HeaderContentPhase | undefined, ready = false) {
    if (!phase) {
      delete document.documentElement.dataset.headerContentPhase;
      delete document.documentElement.dataset.headerContentReady;
      return;
    }

    document.documentElement.dataset.headerContentPhase = phase;
    document.documentElement.toggleAttribute("data-header-content-ready", ready);
  }

  /** 取消旧交接的事件监听，但保留当前已渲染的画面，让新输入能从该画面连续反向。 */
  function cancelHeaderContentHandoff() {
    headerContentHandoffRun += 1;
    headerContentTransitionController?.abort();
    headerContentTransitionController = undefined;
    return headerContentHandoffRun;
  }

  /** 等待指定 live DOM 内容完成透明度交接；元素不存在时直接继续，不引入基于时钟的兜底跳变。 */
  function waitForHeaderContentOpacity(element: Element | null, run: number) {
    if (!element) {
      return Promise.resolve();
    }

    const controller = new AbortController();
    headerContentTransitionController = controller;

    return new Promise<void>((resolve) => {
      const complete = () => {
        if (headerContentTransitionController === controller) {
          headerContentTransitionController = undefined;
        }
        resolve();
      };
      const onTransitionEnd = (event: Event) => {
        if (
          event.target === element &&
          event instanceof TransitionEvent &&
          event.propertyName === "opacity"
        ) {
          complete();
        }
      };

      controller.signal.addEventListener("abort", complete, { once: true });
      element.addEventListener("transitionend", onTransitionEnd, { signal: controller.signal });
      element.addEventListener("transitioncancel", onTransitionEnd, { signal: controller.signal });

      if (run !== headerContentHandoffRun) {
        controller.abort();
      }
    });
  }

  /** 在新密度已布局的一帧后再让内容淡入，确保文字和图标不会与上一密度交叠。 */
  function revealHeaderContent(
    phase: "compact-entering" | "expanded-entering",
    selector: string,
    run: number,
  ) {
    setHeaderContentPhase(phase);
    const completion = waitForHeaderContentOpacity(siteHeader?.querySelector(selector) ?? null, run);

    window.requestAnimationFrame(() => {
      if (run === headerContentHandoffRun) {
        setHeaderContentPhase(phase, true);
      }
    });

    void completion.then(() => {
      if (run === headerContentHandoffRun) {
        setHeaderContentPhase(undefined);
      }
    });
  }

  /**
   * 统一写入完整、紧凑与 hover 展开的最终状态。
   * CSS transition 会从当前呈现值连续反向，避免另建快照层造成文字、图标或边框的缩放拖影。
   */
  function setHeaderLayoutState(
    nextCompact: boolean,
    nextHoverExpanded: boolean,
    shouldAnimate = true,
  ) {
    const normalizedHoverExpanded = nextCompact && nextHoverExpanded;
    const nextIntent = { compact: nextCompact, hoverExpanded: normalizedHoverExpanded };
    const isCompact = document.documentElement.hasAttribute("data-header-compact");
    const isHoverExpanded = document.documentElement.hasAttribute("data-header-hover-expanded");

    if (
      headerLayoutIntent?.compact === nextIntent.compact &&
      headerLayoutIntent.hoverExpanded === nextIntent.hoverExpanded
    ) {
      return;
    }

    headerLayoutIntent = nextIntent;

    if (!shouldAnimate || !canStageHeaderContentHandoff()) {
      cancelHeaderContentHandoff();
      setHeaderContentPhase(undefined);

      if (isCompact === nextCompact && isHoverExpanded === normalizedHoverExpanded) {
        return;
      }

      document.documentElement.dataset.headerLayoutInitializing = "true";
      applyHeaderLayoutState(nextCompact, normalizedHoverExpanded);
      window.requestAnimationFrame(() => {
        delete document.documentElement.dataset.headerLayoutInitializing;
      });
      return;
    }

    const run = cancelHeaderContentHandoff();
    const currentPhase = document.documentElement.dataset.headerContentPhase as
      | HeaderContentPhase
      | undefined;
    const isCurrentContentReady = document.documentElement.hasAttribute(
      "data-header-content-ready",
    );
    const nextVisuallyCompact = nextCompact && !normalizedHoverExpanded;
    const currentVisuallyCompact = isHeaderVisuallyCompact();

    if (nextVisuallyCompact === currentVisuallyCompact) {
      setHeaderContentPhase(undefined);
      applyHeaderLayoutState(nextCompact, normalizedHoverExpanded);
      return;
    }

    if (nextVisuallyCompact) {
      if (currentPhase === "expanded-entering" && !isCurrentContentReady) {
        applyHeaderLayoutState(nextCompact, normalizedHoverExpanded);
        revealHeaderContent("compact-entering", ".compact-exit-menu", run);
        return;
      }

      setHeaderContentPhase("contracting");
      void waitForHeaderContentOpacity(siteHeader?.querySelector(".exit-menu") ?? null, run).then(() => {
        if (run !== headerContentHandoffRun) {
          return;
        }

        applyHeaderLayoutState(nextCompact, normalizedHoverExpanded);
        revealHeaderContent("compact-entering", ".compact-exit-menu", run);
      });
      return;
    }

    if (currentPhase === "compact-entering" && !isCurrentContentReady) {
      applyHeaderLayoutState(nextCompact, normalizedHoverExpanded);
      revealHeaderContent("expanded-entering", ".exit-menu", run);
      return;
    }

    setHeaderContentPhase("expanding");
    void waitForHeaderContentOpacity(siteHeader?.querySelector(".compact-exit-menu") ?? null, run).then(() => {
      if (run !== headerContentHandoffRun) {
        return;
      }

      applyHeaderLayoutState(nextCompact, normalizedHoverExpanded);
      revealHeaderContent("expanded-entering", ".exit-menu", run);
    });
  }

  /**
   * 指针进入阅读态 Header 时临时展开完整导视牌。
   * 最右侧 sandwich 格例外，避免用户为了打开菜单却先丢失该触发器；触屏不启用 hover 捷径，减少动态效果则直接切换状态。
   */
  function expandCompactHeaderOnHover(event: PointerEvent) {
    if (
      !supportsHeaderHoverPreview() ||
      !document.documentElement.hasAttribute("data-header-compact") ||
      isCompactExitPointerTarget(event)
    ) {
      return;
    }

    cancelCompactHeaderHoverContract();
    setHeaderLayoutState(true, true);
  }

  /** 延迟收回 hover 展开的牌面，保证移动到溢出菜单时空间关系保持连续。 */
  function scheduleCompactHeaderHoverContract() {
    cancelCompactHeaderHoverContract();

    compactHeaderHoverContractTimer = window.setTimeout(() => {
      compactHeaderHoverContractTimer = undefined;

      if (siteHeader?.matches(":hover")) {
        return;
      }

      setHeaderLayoutState(true, false);
    }, compactHeaderHoverContractDelay);
  }

  /** 记录正在播放的菜单状态，让再次触发时可以沿当前方向反转，而不是跳回初始帧。 */
  const headerMenuAnimations = new WeakMap<
    HTMLDetailsElement,
    { direction: "opening" | "closing"; animation: Animation }
  >();
  /** 所有 Header 菜单共用的 hover 收起计时器，允许指针从触发牌移动到下方菜单。 */
  const headerHoverCloseTimers = new WeakMap<HTMLDetailsElement, number>();
  /** 精细指针触发的临时预览集合；click 后会转为固定打开，避免首次 click 反而关闭菜单。 */
  const headerHoverPreviewMenus = new WeakSet<HTMLDetailsElement>();
  /** click/touch 或键盘打开后固定的菜单集合，指针离开时也继续保持可操作。 */
  const headerPinnedMenus = new WeakSet<HTMLDetailsElement>();
  /** 菜单以裁切向下揭示的时长；收起延迟必须覆盖它，避免尚未显露的区域失去 hover 命中。 */
  const headerMenuRevealDuration = 220;
  /** 揭示结束后额外保留的指针交接时间，覆盖从触发牌移入扩大菜单区域的自然轨迹。 */
  const headerHoverCloseDelay = headerMenuRevealDuration + 100;

  /**
   * 找到当前 Header 导视牌对应的浮层。
   * 只读取当前 details 内的直接菜单，避免在页面新增同名结构后串扰其它交互。
   */
  function getHeaderMenuPanel(menu: HTMLDetailsElement) {
    return menu.querySelector<HTMLElement>("[data-header-menu-panel]");
  }

  /** 减少动态效果时保留状态切换本身，省去位移与缩放的过渡。 */
  function prefersReducedHeaderMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  /** 只在可精确悬停的设备上启用导视牌预览，触屏仍使用显式点击以避免误开菜单。 */
  function supportsHeaderHoverPreview() {
    return window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  }

  /** 清除已安排的收起任务，保证指针折返时菜单可从当前位置继续保持展开。 */
  function cancelHeaderHoverClose(menu: HTMLDetailsElement) {
    const closeTimer = headerHoverCloseTimers.get(menu);

    if (closeTimer === undefined) {
      return;
    }

    window.clearTimeout(closeTimer);
    headerHoverCloseTimers.delete(menu);
  }

  /** 延迟收起未被 click 固定的预览菜单；键盘焦点仍在面板内时保持打开，避免破坏键盘操作。 */
  function scheduleHeaderHoverClose(menu: HTMLDetailsElement) {
    cancelHeaderHoverClose(menu);

    if (headerPinnedMenus.has(menu)) {
      return;
    }

    const closeTimer = window.setTimeout(() => {
      headerHoverCloseTimers.delete(menu);

      if (
        headerPinnedMenus.has(menu) ||
        menu.matches(":hover") ||
        menu.contains(document.activeElement)
      ) {
        return;
      }

      closeHeaderMenu(menu);
    }, headerHoverCloseDelay);
    headerHoverCloseTimers.set(menu, closeTimer);
  }

  /** 读取全局 Header 动效曲线，确保脚本浮层与 CSS 触发反馈使用同一套导视节奏。 */
  function getHeaderMotionEasing(variableName: "--motion-header-enter" | "--motion-header-exit") {
    return getComputedStyle(document.documentElement).getPropertyValue(variableName).trim();
  }

  /**
   * 将已处于收起途中的菜单反转回展开状态。
   * 菜单的动画对象保留当前呈现帧，因此快速连续点击不会产生位置跳变。
   */
  function reopenHeaderMenu(menu: HTMLDetailsElement) {
    const activeAnimation = headerMenuAnimations.get(menu);

    if (activeAnimation?.direction !== "closing") {
      return;
    }

    activeAnimation.direction = "opening";
    delete menu.dataset.closing;
    activeAnimation.animation.reverse();
  }

  /**
   * 播放从 Header 导视牌底边向下延伸的菜单过渡。
   * 以裁切揭示代替淡入，让同色菜单读作 Header 的连续延伸，同时避免动画期间触发布局重排。
   */
  function openHeaderMenu(menu: HTMLDetailsElement) {
    if (!menu.open) {
      return;
    }

    headerMenus.forEach((otherMenu) => {
      if (otherMenu !== menu && otherMenu.open) {
        closeHeaderMenu(otherMenu);
      }
    });

    if (prefersReducedHeaderMotion()) {
      return;
    }

    const panel = getHeaderMenuPanel(menu);
    if (!panel) {
      return;
    }

    const activeAnimation = headerMenuAnimations.get(menu);
    if (activeAnimation?.direction === "closing") {
      reopenHeaderMenu(menu);
      return;
    }

    activeAnimation?.animation.cancel();
    const animation = panel.animate(
      [
        { clipPath: "inset(0 0 100% 0)" },
        { clipPath: "inset(0)" },
      ],
      {
        duration: headerMenuRevealDuration,
        easing: getHeaderMotionEasing("--motion-header-enter"),
        fill: "both",
      },
    );
    const record = { direction: "opening" as const, animation };
    headerMenuAnimations.set(menu, record);

    animation.finished
      .catch(() => undefined)
      .then(() => {
        if (headerMenuAnimations.get(menu) !== record || record.direction !== "opening") {
          return;
        }

        animation.cancel();
        headerMenuAnimations.delete(menu);
      });
  }

  /**
   * 沿菜单展开路径反向收起指定导视牌。
   * Escape 会把焦点返还给触发牌，点击页面空白处则只收起，避免焦点被强制拉回顶部。
   */
  function closeHeaderMenu(menu: HTMLDetailsElement, restoreFocus = false) {
    cancelHeaderHoverClose(menu);

    if (!menu.open) {
      headerHoverPreviewMenus.delete(menu);
      headerPinnedMenus.delete(menu);
      return;
    }

    const finishClosing = () => {
      menu.removeAttribute("open");
      delete menu.dataset.closing;
      headerMenuAnimations.delete(menu);
      headerHoverPreviewMenus.delete(menu);
      headerPinnedMenus.delete(menu);

      if (restoreFocus) {
        menu.querySelector<HTMLElement>("summary")?.focus();
      }
    };

    if (prefersReducedHeaderMotion()) {
      finishClosing();
      return;
    }

    const activeAnimation = headerMenuAnimations.get(menu);
    if (activeAnimation?.direction === "closing") {
      return;
    }

    menu.dataset.closing = "true";
    if (activeAnimation?.direction === "opening") {
      activeAnimation.direction = "closing";
      activeAnimation.animation.reverse();
      activeAnimation.animation.finished
        .catch(() => undefined)
        .then(() => {
          if (headerMenuAnimations.get(menu) === activeAnimation && activeAnimation.direction === "closing") {
            finishClosing();
          }
        });
      return;
    }

    const panel = getHeaderMenuPanel(menu);
    if (!panel) {
      finishClosing();
      return;
    }

    const animation = panel.animate(
      [{ clipPath: "inset(0)" }, { clipPath: "inset(0 0 100% 0)" }],
      {
        duration: 160,
        easing: getHeaderMotionEasing("--motion-header-exit"),
        fill: "forwards",
      },
    );
    const record = { direction: "closing" as const, animation };
    headerMenuAnimations.set(menu, record);

    animation.finished
      .catch(() => undefined)
      .then(() => {
        if (headerMenuAnimations.get(menu) === record && record.direction === "closing") {
          finishClosing();
        }
      });
  }

  let storedAppearance = "system";
  try {
    storedAppearance = window.localStorage.getItem(appearanceStorageKey) ?? "system";
  } catch {
    // 读取失败时保持系统主题，避免用异常状态替代可用的默认外观。
  }
  applyAppearance(storedAppearance);

  appearanceButtons.forEach((button) => {
    button.addEventListener("click", () => {
      applyAppearance(button.dataset.appearanceChoice ?? "system");
    });
  });

  headerMenus.forEach((menu) => {
    menu.addEventListener("toggle", () => {
      if (menu.open) {
        openHeaderMenu(menu);
      }
    });

    menu.addEventListener("pointerenter", () => {
      if (!supportsHeaderHoverPreview() || headerPinnedMenus.has(menu)) {
        return;
      }

      cancelHeaderHoverClose(menu);
      headerHoverPreviewMenus.add(menu);
      if (menu.open) {
        reopenHeaderMenu(menu);
      } else {
        menu.open = true;
      }
    });

    menu.addEventListener("pointerleave", () => {
      if (!supportsHeaderHoverPreview()) {
        return;
      }

      scheduleHeaderHoverClose(menu);
    });

    // 预览菜单的焦点移出整个 details 后重新安排收起，面板内部转移则不打断键盘操作。
    menu.addEventListener("focusout", (event) => {
      const nextFocusedElement = event.relatedTarget;

      if (nextFocusedElement instanceof Node && menu.contains(nextFocusedElement)) {
        return;
      }

      if (headerHoverPreviewMenus.has(menu)) {
        scheduleHeaderHoverClose(menu);
      }
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeHeaderMenu(menu, true);
      }
    });

    menu.querySelector<HTMLElement>("summary")?.addEventListener("click", (event) => {
      if (!menu.open) {
        // 触摸、键盘或没有先触发 hover 的 click 都应把菜单固定为可继续操作的打开状态。
        headerPinnedMenus.add(menu);
        return;
      }

      event.preventDefault();
      cancelHeaderHoverClose(menu);
      if (headerHoverPreviewMenus.has(menu)) {
        // hover 预览后的第一次 click 用于固定菜单，不应沿用旧逻辑把菜单立即关掉。
        headerHoverPreviewMenus.delete(menu);
        headerPinnedMenus.add(menu);
        return;
      }

      const activeAnimation = headerMenuAnimations.get(menu);
      if (activeAnimation?.direction === "closing") {
        reopenHeaderMenu(menu);
      } else {
        closeHeaderMenu(menu);
      }
    });
  });

  document.addEventListener("click", (event) => {
    const clickTarget = event.target;

    if (!(clickTarget instanceof Node)) {
      return;
    }

    headerMenus.forEach((menu) => {
      if (menu.open && !menu.contains(clickTarget)) {
        closeHeaderMenu(menu);
      }
    });
  });

  siteHeader?.addEventListener("pointerenter", expandCompactHeaderOnHover);
  siteHeader?.addEventListener("pointerleave", scheduleCompactHeaderHoverContract);

  syncCompactHeader();
  window.addEventListener("scroll", scheduleCompactHeaderSync, { passive: true });
</script>
