---
import RailwayLineHint from "@/components/RailwayLineHint.astro";
// 同岸复用既有 Figma Bézier，并通过翻转组成右侧进站、左侧出站的换乘轨迹。
import ServerlinkBend from "@/assets/pages/home/serverlink-bend.svg";
import type { HomeJourneySectionId } from "@/data/home-journey";
import {
  getRailwayLineCssVariableName,
  getRailwayLineTextColor,
} from "@/data/palette";
import type { RailwayLine } from "@/data/railway";
import type { Locale } from "@/i18n/config";

/** 首页两条叙事线路之间的满屏换乘站牌属性。 */
export interface Props {
  /** 稳定章节锚点，同时供快选路线图与 URL fragment 定位。 */
  id: HomeJourneySectionId;
  /** 当前公开语言决定站名与线路名的主副顺序。 */
  locale: Locale;
  /** 当前语言中承担主标题的站名。 */
  primaryName: string;
  /** 与主标题互补的第二语言站名。 */
  secondaryName: string;
  /** 从上一章节驶入换乘站的真实线路数据。 */
  incomingLine: RailwayLine;
  /** 换乘站在驶入线路上的叙事站序。 */
  incomingSequence: string;
  /** 从换乘站驶往下一章节的真实线路数据。 */
  outgoingLine: RailwayLine;
  /** 换乘站在驶出线路上的叙事站序。 */
  outgoingSequence: string;
  /** 列车驶入换乘站时由进入线路派生的附属色。 */
  incomingTrainColor: string;
  /** 列车驶离换乘站时由离开线路派生的附属色。 */
  outgoingTrainColor: string;
  /** 两班换乘列车共用的 Tooltip 触发动作名称。 */
  trainTooltipTriggerLabel: string;
}

const {
  id,
  locale,
  primaryName,
  secondaryName,
  incomingLine,
  incomingSequence,
  outgoingLine,
  outgoingSequence,
  incomingTrainColor,
  outgoingTrainColor,
  trainTooltipTriggerLabel,
} = Astro.props;
const titleId = `${id}-title`;
const incomingLineColor = `var(${getRailwayLineCssVariableName(incomingLine)})`;
const outgoingLineColor = `var(${getRailwayLineCssVariableName(outgoingLine)})`;
/** 线路名随公开语言交换主副顺序，保持与其余首页站牌一致。 */
const getLocalizedLineNames = (line: RailwayLine): readonly [string, string] =>
  locale === "en"
    ? [line.secondaryName, line.primaryName]
    : [line.primaryName, line.secondaryName];
const [incomingPrimaryName, incomingSecondaryName] = getLocalizedLineNames(incomingLine);
const [outgoingPrimaryName, outgoingSecondaryName] = getLocalizedLineNames(outgoingLine);
---

<section
  class="home-transfer-breaker"
  id={id}
  data-home-transfer-breaker
  data-home-transfer-breaker-locale={locale}
  data-home-transfer-incoming-line-code={incomingLine.code}
  data-home-transfer-incoming-line-color={incomingLine.color}
  data-home-transfer-incoming-train-color={incomingTrainColor}
  data-home-transfer-outgoing-line-code={outgoingLine.code}
  data-home-transfer-outgoing-line-color={outgoingLine.color}
  data-home-transfer-outgoing-train-color={outgoingTrainColor}
  tabindex="-1"
  aria-labelledby={titleId}
  style={`--home-transfer-incoming-color: ${incomingLineColor}; --home-transfer-outgoing-color: ${outgoingLineColor}; --home-transfer-incoming-train-color: ${incomingTrainColor}; --home-transfer-outgoing-train-color: ${outgoingTrainColor};`}
>
  <div class="home-transfer-breaker__stage" data-home-transfer-breaker-stage>
    <span class="home-transfer-breaker__right-track" data-home-transfer-right-track aria-hidden="true"></span>
    <ServerlinkBend
      class="home-transfer-breaker__right-bend"
      data-home-transfer-right-bend
      aria-hidden="true"
    />
    <span
      class="home-transfer-breaker__incoming-horizontal-track"
      data-home-transfer-incoming-horizontal-track
      aria-hidden="true"
    ></span>
    <ServerlinkBend
      class="home-transfer-breaker__left-bend"
      data-home-transfer-left-bend
      aria-hidden="true"
    />
    <span
      class="home-transfer-breaker__outgoing-horizontal-track"
      data-home-transfer-outgoing-horizontal-track
      aria-hidden="true"
    ></span>
    <span class="home-transfer-breaker__left-track" data-home-transfer-left-track aria-hidden="true"></span>
    <button
      class="home-transfer-breaker__train home-transfer-breaker__train--incoming"
      data-home-transfer-incoming-train
      data-home-transfer-tooltip-trigger="incoming"
      data-tooltip-open="false"
      type="button"
      aria-label={`${trainTooltipTriggerLabel} · ${incomingLine.code}${incomingSequence}`}
      aria-controls="home-arrival-train-tooltip"
      aria-haspopup="dialog"
      aria-expanded="false"
      disabled
    ></button>
    <button
      class="home-transfer-breaker__train home-transfer-breaker__train--outgoing"
      data-home-transfer-outgoing-train
      data-home-transfer-tooltip-trigger="outgoing"
      data-tooltip-open="false"
      type="button"
      aria-label={`${trainTooltipTriggerLabel} · ${outgoingLine.code}${outgoingSequence}`}
      aria-controls="home-arrival-train-tooltip"
      aria-haspopup="dialog"
      aria-expanded="false"
      disabled
    ></button>

    <div class="home-transfer-breaker__copy">
      <h2 id={titleId}>{primaryName}</h2>
      <p>{secondaryName}</p>
    </div>

    <div class="home-transfer-breaker__routes" aria-label={`${incomingLine.code} / ${outgoingLine.code}`}>
      <RailwayLineHint
        class="home-transfer-breaker__route home-transfer-breaker__route--incoming"
        lineColor={incomingLineColor}
        textColor={getRailwayLineTextColor(incomingLine.color)}
        lineCode={incomingLine.code}
        sequence={incomingSequence}
        primaryName={incomingPrimaryName}
        secondaryName={incomingSecondaryName}
        isEnglishPrimary={locale === "en"}
      />
      <RailwayLineHint
        class="home-transfer-breaker__route home-transfer-breaker__route--outgoing"
        lineColor={outgoingLineColor}
        textColor={getRailwayLineTextColor(outgoingLine.color)}
        lineCode={outgoingLine.code}
        sequence={outgoingSequence}
        primaryName={outgoingPrimaryName}
        secondaryName={outgoingSecondaryName}
        isEnglishPrimary={locale === "en"}
      />
    </div>
  </div>
</section>

<style>
  .home-transfer-breaker {
    /* 轨宽、弯轨与左右轴线对应 Figma 70:2 的 1920×1080 网格，并与相邻铁路 section 保持相同轨距。 */
    --home-transfer-track-width: clamp(34px, 3.23vw, 62px);
    --home-transfer-track-half: clamp(17px, 1.615vw, 31px);
    --home-transfer-bend-size: clamp(162px, 12.97vw, 249px);
    --home-transfer-bend-height: calc(var(--home-transfer-bend-size) * 250 / 249);
    --home-transfer-bend-inset: var(--home-transfer-track-half);
    --home-transfer-left-origin-x: 9.32vw;
    --home-transfer-right-origin-x: 86.41vw;
    /* 两条横向线路中心相隔 10svh，在桌面轨宽下保留约四分之三轨宽的换乘净空。 */
    --home-transfer-incoming-track-top: 59.17svh;
    --home-transfer-outgoing-track-top: 69.17svh;
    --home-transfer-copy-top: 26.48svh;
    --home-transfer-name-gap: clamp(12px, 1.2vw, 24px);
    --home-transfer-joint-overlap: 1px;
    --home-transfer-train-width: clamp(116px, 10.42vw, 200px);
    --home-transfer-train-height: clamp(58px, 9.26svh, 100px);
    /* 桌面由换乘交接节奏注入额外 sticky 行程；无脚本时保持一屏完整站牌。 */
    --home-transfer-scroll-distance: 0px;
    position: relative;
    width: 100%;
    min-width: 0;
    height: calc(100svh + var(--home-transfer-scroll-distance));
    min-height: 720px;
    scroll-margin-top: 0;
    background: var(--palette-canvas);
    color: var(--palette-text);
  }

  .home-transfer-breaker__stage {
    position: sticky;
    top: 0;
    display: grid;
    width: 100%;
    height: 100svh;
    min-width: 0;
    isolation: isolate;
    overflow: clip;
    background: var(--palette-canvas);
  }

  .home-transfer-breaker__right-track,
  .home-transfer-breaker__incoming-horizontal-track,
  .home-transfer-breaker__outgoing-horizontal-track,
  .home-transfer-breaker__left-track,
  .home-transfer-breaker__train {
    position: absolute;
    display: block;
  }

  .home-transfer-breaker__right-track {
    top: 0;
    left: var(--home-transfer-right-origin-x);
    width: var(--home-transfer-track-width);
    height: calc(
      var(--home-transfer-incoming-track-top) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-height) + var(--home-transfer-bend-inset) +
        var(--home-transfer-joint-overlap)
    );
    background: var(--home-transfer-incoming-color);
  }

  .home-transfer-breaker__right-bend,
  .home-transfer-breaker__left-bend {
    position: absolute;
    display: block;
    width: var(--home-transfer-bend-size);
    height: var(--home-transfer-bend-height);
  }

  .home-transfer-breaker__right-bend {
    top: calc(
      var(--home-transfer-incoming-track-top) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-height) + var(--home-transfer-bend-inset)
    );
    left: calc(
      var(--home-transfer-right-origin-x) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-size) + var(--home-transfer-bend-inset)
    );
    color: var(--home-transfer-incoming-color);
    transform: scale(-1);
  }

  .home-transfer-breaker__incoming-horizontal-track {
    top: var(--home-transfer-incoming-track-top);
    right: calc(
      100vw - var(--home-transfer-right-origin-x) - var(--home-transfer-track-half) +
        var(--home-transfer-bend-size) - var(--home-transfer-bend-inset) -
        var(--home-transfer-joint-overlap)
    );
    left: 0;
    height: var(--home-transfer-track-width);
    background: var(--home-transfer-incoming-color);
  }

  .home-transfer-breaker__outgoing-horizontal-track {
    top: var(--home-transfer-outgoing-track-top);
    right: 0;
    left: calc(
      var(--home-transfer-left-origin-x) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-inset) + var(--home-transfer-bend-size) -
        var(--home-transfer-joint-overlap)
    );
    height: var(--home-transfer-track-width);
    background: var(--home-transfer-outgoing-color);
  }

  .home-transfer-breaker__left-bend {
    top: calc(
      var(--home-transfer-outgoing-track-top) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-inset)
    );
    left: calc(
      var(--home-transfer-left-origin-x) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-inset)
    );
    color: var(--home-transfer-outgoing-color);
  }

  .home-transfer-breaker__left-track {
    top: calc(
      var(--home-transfer-outgoing-track-top) + var(--home-transfer-track-half) -
        var(--home-transfer-bend-inset) + var(--home-transfer-bend-height) -
        var(--home-transfer-joint-overlap)
    );
    bottom: 0;
    left: var(--home-transfer-left-origin-x);
    width: var(--home-transfer-track-width);
    background: var(--home-transfer-outgoing-color);
  }

  .home-transfer-breaker__right-bend path,
  .home-transfer-breaker__left-bend path {
    stroke: currentColor;
  }

  .home-transfer-breaker__train--incoming {
    top: calc(
      var(--home-transfer-incoming-track-top) +
        (var(--home-transfer-track-width) - var(--home-transfer-train-height)) / 2
    );
    left: 4.53vw;
    width: var(--home-transfer-train-width);
    height: var(--home-transfer-train-height);
    padding: 0;
    border: 0;
    background: var(--home-transfer-incoming-train-color);
    cursor: pointer;
    touch-action: manipulation;
  }

  .home-transfer-breaker__train--outgoing {
    top: calc(
      var(--home-transfer-outgoing-track-top) +
        (var(--home-transfer-track-width) - var(--home-transfer-train-height)) / 2
    );
    left: var(--home-transfer-right-origin-x);
    width: var(--home-transfer-train-width);
    height: var(--home-transfer-train-height);
    padding: 0;
    border: 0;
    background: var(--home-transfer-outgoing-train-color);
    cursor: pointer;
    touch-action: manipulation;
  }

  .home-transfer-breaker__train:focus-visible {
    outline: none;
    filter: brightness(0.92) saturate(1.08);
  }

  .home-transfer-breaker__train:not(:disabled):hover,
  .home-transfer-breaker__train:not(:disabled):active,
  .home-transfer-breaker__train[data-tooltip-open="true"] {
    filter: brightness(0.92) saturate(1.08);
  }

  .home-transfer-breaker__train:disabled {
    cursor: default;
  }

  @media (forced-colors: active), (prefers-contrast: more) {
    .home-transfer-breaker__train:focus-visible {
      outline: 3px solid currentColor;
      outline-offset: 4px;
      filter: none;
    }
  }

  .home-transfer-breaker[data-route-enhanced="true"][data-active-train="approaching"]
    .home-transfer-breaker__train--incoming {
    /* 进站阶段由全局 SVG 列车驶到 Figma 的蓝车位置，抵达后再无缝交还静态站台列车。 */
    visibility: hidden;
  }

  .home-transfer-breaker[data-route-enhanced="true"][data-active-train="departing"]
    .home-transfer-breaker__train--outgoing {
    /* 离站阶段由全局 SVG 列车从同一位置接管，隐藏静态副本避免出现重影。 */
    visibility: hidden;
  }

  .home-transfer-breaker__copy {
    position: relative;
    z-index: 1;
    display: grid;
    align-self: start;
    justify-items: center;
    gap: var(--home-transfer-name-gap);
    width: 100%;
    margin-top: var(--home-transfer-copy-top);
    text-align: center;
  }

  .home-transfer-breaker__copy h2,
  .home-transfer-breaker__copy p {
    max-width: calc(100% - 32px);
    margin: 0;
    white-space: nowrap;
  }

  .home-transfer-breaker__copy h2 {
    font-size: clamp(76px, 10.42vw, 200px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .home-transfer-breaker__copy p {
    font-family: var(--font-fetarute-display), var(--font-fetarute-sans-sc);
    font-size: clamp(42px, 5.21vw, 100px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .home-transfer-breaker[data-home-transfer-breaker-locale="en"] {
    --home-transfer-name-gap: clamp(12px, 1.1vw, 20px);
  }

  .home-transfer-breaker[data-home-transfer-breaker-locale="en"]
    .home-transfer-breaker__copy h2 {
    font-size: clamp(62px, 7.4vw, 142px);
    line-height: 1;
  }

  .home-transfer-breaker[data-home-transfer-breaker-locale="en"]
    .home-transfer-breaker__copy p {
    font-size: clamp(50px, 6.25vw, 120px);
  }

  .home-transfer-breaker__routes {
    position: absolute;
    z-index: 1;
    top: 80svh;
    left: 50%;
    display: flex;
    align-items: flex-start;
    gap: clamp(32px, 2.3vw, 56px);
    width: max-content;
    transform: translateX(-50%);
  }

  :global(.home-transfer-breaker__route) {
    position: relative;
    top: 0;
    flex: 0 0 auto;
  }

  @media (max-width: 1023px) {
    .home-transfer-breaker {
      --home-transfer-track-width: clamp(20px, 5.8vw, 30px);
      --home-transfer-left-origin-x: 7vw;
      /* --home-transfer-content-left 让小屏站名与两张线路牌共用轨道右侧的内容锚点。 */
      --home-transfer-content-left: max(
        calc(var(--home-transfer-left-origin-x) + var(--home-transfer-track-width) + 18px),
        20.9vw
      );
      --home-transfer-copy-top: 18svh;
      --home-transfer-incoming-track-top: 46%;
      --home-transfer-outgoing-track-top: 54%;
      height: max(760px, 100svh);
      min-height: max(760px, 100svh);
    }

    .home-transfer-breaker__stage {
      position: relative;
      height: 100%;
      min-height: inherit;
    }

    .home-transfer-breaker__right-track,
    .home-transfer-breaker__right-bend,
    .home-transfer-breaker__incoming-horizontal-track,
    .home-transfer-breaker__outgoing-horizontal-track,
    .home-transfer-breaker__left-bend,
    .home-transfer-breaker__train {
      display: none;
    }

    .home-transfer-breaker__right-bend,
    .home-transfer-breaker__left-bend {
      /* 内联 SVG 自带 display；visibility 作为窄屏保险，防止设计资产覆盖媒体查询。 */
      visibility: hidden;
    }

    .home-transfer-breaker__left-track {
      top: 0;
      bottom: auto;
      height: 100%;
      background: linear-gradient(
        to bottom,
        var(--home-transfer-incoming-color) 46%,
        var(--home-transfer-outgoing-color) 54%
      );
    }

    .home-transfer-breaker__copy {
      justify-items: start;
      width: calc(100% - var(--home-transfer-content-left) - 16px);
      margin-left: var(--home-transfer-content-left);
      text-align: left;
    }

    .home-transfer-breaker__copy h2 {
      max-width: 100%;
      font-size: clamp(58px, 19.4vw, 98px);
      white-space: normal;
    }

    .home-transfer-breaker__copy p {
      max-width: 100%;
      font-size: clamp(25px, 9.7vw, 48px);
      white-space: normal;
    }

    .home-transfer-breaker[data-home-transfer-breaker-locale="en"]
      .home-transfer-breaker__copy h2 {
      font-size: clamp(38px, 10.5vw, 58px);
    }

    .home-transfer-breaker[data-home-transfer-breaker-locale="en"]
      .home-transfer-breaker__copy p {
      font-size: clamp(40px, 12vw, 64px);
    }

    .home-transfer-breaker__routes {
      top: 51svh;
      left: var(--home-transfer-content-left);
      display: grid;
      gap: clamp(20px, 4svh, 32px);
      width: auto;
      transform: none;
    }

    :global(.home-transfer-breaker__route) {
      position: relative;
      top: auto;
      left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-transfer-breaker {
      --home-transfer-scroll-distance: 0px !important;
    }

    .home-transfer-breaker__stage {
      position: relative;
    }

    .home-transfer-breaker * {
      transition: none !important;
    }
  }
</style>
