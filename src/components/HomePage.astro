---
import { getImage } from "astro:assets";
import handTapIcon from "@phosphor-icons/core/assets/regular/hand-tap.svg?raw";
import mouseSimpleIcon from "@phosphor-icons/core/assets/regular/mouse-simple.svg?raw";
import DepartureGate from "@/components/DepartureGate.astro";
import HomeCommunitySection from "@/components/HomeCommunitySection.astro";
import HomeFooter from "@/components/HomeFooter.astro";
import HomeJourneyQuickPick from "@/components/HomeJourneyQuickPick.astro";
import HomeOnwardSection from "@/components/HomeOnwardSection.astro";
import HomeSectionBreaker from "@/components/HomeSectionBreaker.astro";
import HomeTransferSectionBreaker from "@/components/HomeTransferSectionBreaker.astro";
import HomeTriServerSection from "@/components/HomeTriServerSection.astro";
import RailwayLineHint from "@/components/RailwayLineHint.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home-shell.css";
import "@/styles/home.css";
// 保持 Figma 导出的原始 Bézier 作为内联 SVG，使可见弯轨与列车采样的几何完全一致。
import ServerlinkBend from "@/assets/pages/home/serverlink-bend.svg";
import { homeGalleryScenes } from "@/data/home-gallery";
import {
  getHomeSceneryOutputWidths,
  homeGalleryImageWidths,
  homeLandingImageWidths,
  homeSceneryImageQuality,
} from "@/data/home-image-output";
import { homeLandingScenes } from "@/data/home-landing";
import { getHomeJourneySectionNames, homeJourneySections } from "@/data/home-journey";
import { getRailwayLineCssVariableName } from "@/data/palette";
import { railwayLineByKey, shiftRailwayLineColor } from "@/data/railway";
import { wayfindingPrototype } from "@/data/site";
import { type Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";

/**
 * 多语言首页的属性。
 * 每个公开语言路由只传入 locale；页面结构、图片与交互边界保持同一份 Astro SSG 实现。
 */
export interface Props {
  /** 当前首页所属的公开语言。 */
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);

/**
 * 为每张受控实景生成可由浏览器延迟选择的两种现代格式。
 * 首帧保留第一张作为无脚本回退；脚本只替换地址，不会将所有候选图片同时放进页面布局。
 */
const landingSceneImages = await Promise.all(
  homeLandingScenes.map(async (scene) => {
    const outputWidths = getHomeSceneryOutputWidths(
      scene.image.width,
      2560,
      homeLandingImageWidths,
    );
    const [avifOutputs, webpOutputs] = await Promise.all([
      Promise.all(
        outputWidths.map((width) =>
          getImage({
            src: scene.image,
            format: "avif",
            width,
            quality: homeSceneryImageQuality.avif,
          }),
        ),
      ),
      Promise.all(
        outputWidths.map((width) =>
          getImage({
            src: scene.image,
            format: "webp",
            width,
            quality: homeSceneryImageQuality.webp,
          }),
        ),
      ),
    ]);
    const width = outputWidths.at(-1) ?? scene.image.width;
    const webp = webpOutputs.at(-1);

    if (!webp) {
      throw new Error(`首页 Landing 实景 ${scene.id} 没有生成可用的 WebP 输出。`);
    }

    return {
      id: scene.id,
      alt: messages.home.sceneAltById[scene.id],
      focalPoint: scene.focalPoint,
      copyShadow: scene.copyShadow,
      width,
      height: Math.round((scene.image.height / scene.image.width) * width),
      avifSrcset: avifOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
      webpSrc: webp.src,
      webpSrcset: webpOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
    };
  }),
);

/**
 * Gallery 截图在 SSG 阶段统一生成现代格式，并把可见标题与替代文本绑定到同一稳定 scene id。
 * 输出宽度封顶 1920px，足以覆盖 Figma 桌面卡片而不会让 2560px 原图进入每位访客的下载路径。
 */
const gallerySceneImages = await Promise.all(
  homeGalleryScenes.map(async (scene) => {
    const outputWidths = getHomeSceneryOutputWidths(
      scene.image.width,
      1920,
      homeGalleryImageWidths,
    );
    const width = outputWidths.at(-1) ?? Math.min(scene.image.width, 1920);
    const height = Math.round((scene.image.height / scene.image.width) * width);
    const [avifOutputs, webpOutputs] = await Promise.all([
      Promise.all(
        outputWidths.map((outputWidth) =>
          getImage({
            src: scene.image,
            format: "avif",
            width: outputWidth,
            quality: homeSceneryImageQuality.avif,
          }),
        ),
      ),
      Promise.all(
        outputWidths.map((outputWidth) =>
          getImage({
            src: scene.image,
            format: "webp",
            width: outputWidth,
            quality: homeSceneryImageQuality.webp,
          }),
        ),
      ),
    ]);
    const webp = webpOutputs.at(-1);
    const sceneMessage = messages.home.gallery.sceneById[scene.id];

    if (!webp) {
      throw new Error(`首页铁路回顾图片 ${scene.id} 没有生成可用的 WebP 输出。`);
    }

    return {
      id: scene.id,
      focalPoint: scene.focalPoint,
      width,
      height,
      avifSrcset: avifOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
      webpSrc: webp.src,
      webpSrcset: webpOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
      ...sceneMessage,
    };
  }),
);

const defaultLandingScene = landingSceneImages[0];

if (!defaultLandingScene) {
  throw new Error("首页至少需要登记一张可用的到站实景。");
}

const homeLine = railwayLineByKey.get(wayfindingPrototype.homeLineKey);

if (!homeLine) {
  throw new Error(`首页开屏引用了未录入的线路 ${wayfindingPrototype.homeLineKey}。`);
}

const homeLineCssVariable = getRailwayLineCssVariableName(homeLine);
const homeTrainColor = shiftRailwayLineColor(homeLine.color, wayfindingPrototype.homeTrainColorShift);
const homeArrivalJourneySection = homeJourneySections.find((section) => section.id === "beginning-bay");
const triServerJointJourneySection = homeJourneySections.find((section) => section.id === "tri-server-joint");
const sharedShoreJourneySection = homeJourneySections.find((section) => section.id === "shared-shore");
const onwardJourneySection = homeJourneySections.find((section) => section.id === "onward");

if (
  !homeArrivalJourneySection ||
  !triServerJointJourneySection ||
  !sharedShoreJourneySection ||
  !onwardJourneySection
) {
  throw new Error("首页站牌必须同时登记启始湾、三服汇、同岸与续行章节。");
}

if (!sharedShoreJourneySection.transferFrom) {
  throw new Error("同岸必须登记换乘前的进入线路与站序。");
}

if (!onwardJourneySection.transferFrom) {
  throw new Error("续行必须登记换乘前的进入线路与站序。");
}

const sharedShoreIncomingLine = railwayLineByKey.get(sharedShoreJourneySection.transferFrom.lineKey);
const sharedShoreOutgoingLine = railwayLineByKey.get(sharedShoreJourneySection.lineKey);

if (!sharedShoreIncomingLine || !sharedShoreOutgoingLine) {
  throw new Error("同岸引用了未录入的换乘线路。");
}

const onwardIncomingLine = railwayLineByKey.get(onwardJourneySection.transferFrom.lineKey);
const onwardOutgoingLine = railwayLineByKey.get(onwardJourneySection.lineKey);

if (!onwardIncomingLine || !onwardOutgoingLine) {
  throw new Error("续行引用了未录入的换乘线路。");
}

const sharedShoreOutgoingTrainColor = shiftRailwayLineColor(
  sharedShoreOutgoingLine.color,
  wayfindingPrototype.homeTrainColorShift,
);
const onwardIncomingTrainColor = shiftRailwayLineColor(
  onwardIncomingLine.color,
  wayfindingPrototype.homeTrainColorShift,
);
const onwardOutgoingTrainColor = shiftRailwayLineColor(
  onwardOutgoingLine.color,
  wayfindingPrototype.homeTrainColorShift,
);

const [homeArrivalPrimaryName, homeArrivalSecondaryName] = getHomeJourneySectionNames(
  homeArrivalJourneySection,
  locale,
);
const [triServerJointPrimaryName, triServerJointSecondaryName] = getHomeJourneySectionNames(
  triServerJointJourneySection,
  locale,
);
const [sharedShorePrimaryName, sharedShoreSecondaryName] = getHomeJourneySectionNames(
  sharedShoreJourneySection,
  locale,
);
const [onwardPrimaryName, onwardSecondaryName] = getHomeJourneySectionNames(
  onwardJourneySection,
  locale,
);
/** 线路导视跟随当前阅读语言切换主副名称，避免英文画面仍被中文大字主导。 */
const [homeLinePrimaryName, homeLineSecondaryName] =
  locale === "en" ? [homeLine.secondaryName, homeLine.primaryName] : [homeLine.primaryName, homeLine.secondaryName];
---

<BaseLayout locale={locale} description={messages.description} showLaunchSequence fullBleedMain>
  <DepartureGate slot="overlay" locale={locale} />

  <section
    class="hero-section"
    id="home"
    aria-labelledby="hero-title"
    style={`--hero-copy-shadow-blur: ${defaultLandingScene.copyShadow.blur}; --hero-copy-shadow-opacity: ${defaultLandingScene.copyShadow.opacity};`}
  >
    <div class="hero-section__viewport">
      <!-- 脚本先在离线 picture 中装入最终随机场景，再一次性挂载；浏览器不会抢先请求默认图。 -->
      <picture class="hero-scene" data-landing-scene-id={defaultLandingScene.id}></picture>
      <noscript>
        <picture class="hero-scene">
          <source srcset={defaultLandingScene.avifSrcset} sizes="100vw" type="image/avif" />
          <img
            src={defaultLandingScene.webpSrc}
            srcset={defaultLandingScene.webpSrcset}
            sizes="100vw"
            width={defaultLandingScene.width}
            height={defaultLandingScene.height}
            alt={defaultLandingScene.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={`object-position: ${defaultLandingScene.focalPoint};`}
          />
        </picture>
      </noscript>
      <div class="hero-section__foreground">
        <div class="hero-copy">
          <h1 id="hero-title">
            <span class="hero-title__base">{messages.home.title}</span>
            <span
              class="hero-title__reflection"
              aria-hidden="true"
              data-reflection-title={messages.home.title}
            ></span>
          </h1>
          <p class="hero-description">{messages.home.description}</p>
        </div>
      </div>
    </div>
  </section>

  <script
    is:inline
    id="home-landing-scenes"
    type="application/json"
    set:html={JSON.stringify(landingSceneImages).replaceAll("<", "\\u003c")}
  ></script>
  <script>
    import { setupHomeHero } from "@/lib/home/hero-controller";
    const sceneData = document.querySelector("#home-landing-scenes")?.textContent;
    if (sceneData) setupHomeHero(JSON.parse(sceneData));
  </script>

  <!-- 出发跑道先承接首屏余量；它与遮罩同底色，确保验票结束前不会提前露出第一叙事站。 -->
  <div class="departure-gate-sentinel" data-departure-gate-sentinel aria-hidden="true"></div>

  <section
    class="home-arrival"
    id="beginning-bay"
    data-home-arrival-route
    data-home-arrival-locale={locale}
    data-home-arrival-line-code={homeLine.code}
    data-home-arrival-line-color={homeLine.color}
    data-home-arrival-train-color={homeTrainColor}
    aria-labelledby="home-arrival-title"
    tabindex="-1"
    style={`--home-arrival-line-color: var(${homeLineCssVariable}); --home-arrival-train-color: ${homeTrainColor};`}
  >
    <span class="home-arrival__vertical-track" data-home-arrival-vertical-track aria-hidden="true"></span>
    <ServerlinkBend class="home-arrival__bend" data-home-arrival-bend aria-hidden="true" />
    <span class="home-arrival__horizontal-track" data-home-arrival-horizontal aria-hidden="true"></span>
    <div class="home-arrival__copy">
      <div class="home-arrival__name-lockup">
        <h2 id="home-arrival-title">{homeArrivalPrimaryName}</h2>
        <p>{homeArrivalSecondaryName}</p>
      </div>
    </div>
    <RailwayLineHint
      class="home-arrival__route"
      lineColor={`var(${homeLineCssVariable})`}
      lineCode={homeLine.code}
      sequence={homeArrivalJourneySection.sequence}
      primaryName={homeLinePrimaryName}
      secondaryName={homeLineSecondaryName}
      isEnglishPrimary={locale === "en"}
    />
    <!-- 有界车身沿数值路径的切线移动；避免 WebKit 为全视口 SVG dash 持续重绘。 -->
    <span class="home-arrival__train-visual" data-home-arrival-train-visual aria-hidden="true">
      <span
        class="home-arrival__train-color-layer home-arrival__train-color-layer--incoming"
        data-home-arrival-train-color-layer="incoming"
      ></span>
      <span
        class="home-arrival__train-color-layer home-arrival__train-color-layer--outgoing"
        data-home-arrival-train-color-layer="outgoing"
      ></span>
    </span>
    <button
      class="home-arrival__train"
      data-home-arrival-train
      data-tooltip-open="false"
      data-tooltip-mode="closed"
      data-tooltip-visual-active="true"
      type="button"
      aria-label={messages.home.arrival.trainTooltip.triggerLabel}
      aria-controls="home-arrival-train-tooltip"
      aria-haspopup="dialog"
      aria-expanded="false"
      disabled
    ></button>
    <p class="home-arrival__train-hint" aria-hidden="true">
      <span class="home-arrival__train-hint-icon home-arrival__train-hint-icon--pointer" set:html={mouseSimpleIcon} />
      <span class="home-arrival__train-hint-icon home-arrival__train-hint-icon--touch" set:html={handTapIcon} />
      <span class="home-arrival__train-hint-copy home-arrival__train-hint-copy--pointer">
        {messages.home.arrival.trainTooltip.hoverHint}
      </span>
      <span class="home-arrival__train-hint-copy home-arrival__train-hint-copy--touch">
        {messages.home.arrival.trainTooltip.tapHint}
      </span>
    </p>
    <aside
      class="home-arrival__train-tooltip"
      id="home-arrival-train-tooltip"
      data-home-arrival-tooltip-locale={locale}
      role="dialog"
      aria-label={messages.home.arrival.trainTooltip.title}
      aria-hidden="true"
      inert
    >
      <HomeJourneyQuickPick
        locale={locale}
        currentSectionId="beginning-bay"
        sections={homeJourneySections}
        currentSectionLabel={messages.home.arrival.trainTooltip.currentSectionLabel}
        quickPickLabel={messages.home.arrival.trainTooltip.quickPickLabel}
        goToSectionLabel={messages.home.arrival.trainTooltip.goToSectionLabel}
        closeLabel={messages.home.arrival.trainTooltip.closeLabel}
      />
    </aside>
  </section>

  <script>
  import { setupHomeRoute } from "@/lib/home/route-controller";
  setupHomeRoute();
</script>

  <section
    class="home-introduction"
    data-home-introduction-route
    aria-labelledby="home-introduction-title"
    style={`--home-introduction-line-color: var(${homeLineCssVariable});`}
  >
    <span class="home-introduction__track" data-home-introduction-track aria-hidden="true"></span>
    <div class="home-introduction__opening">
      <span class="home-introduction__branch" aria-hidden="true"></span>
      <div class="home-introduction__copy">
        <h2 id="home-introduction-title">{messages.home.introduction.title}</h2>
        <p>{messages.home.introduction.description}</p>
      </div>
    </div>
    <div
      class="home-gallery"
      data-home-gallery
      role="region"
      aria-label={messages.home.gallery.label}
    >
      <div class="home-gallery__stage" data-home-gallery-stage>
        <ol class="home-gallery__track" data-home-gallery-track>
          {
            gallerySceneImages.map((scene, index) => (
              <li
                class="home-gallery__item"
                data-home-gallery-item
                data-home-gallery-caption-visible={index === 0 ? "true" : undefined}
              >
                <figure class="home-gallery__figure">
                  <picture class="home-gallery__picture">
                    <source
                      srcset={scene.avifSrcset}
                      sizes="(max-width: 1023px) 70vw, 71.46vw"
                      type="image/avif"
                    />
                    <img
                      src={scene.webpSrc}
                      srcset={scene.webpSrcset}
                      sizes="(max-width: 1023px) 70vw, 71.46vw"
                      width={scene.width}
                      height={scene.height}
                      alt={scene.alt}
                      loading="lazy"
                      decoding="async"
                      style={`object-position: ${scene.focalPoint};`}
                    />
                  </picture>
                  <figcaption class="home-gallery__caption">
                    <span class="home-gallery__kicker">{scene.kicker}</span>
                    <span class="home-gallery__title">{scene.title}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

<script>
  import { setupLazyHomeSections } from "@/lib/home/lazy-sections";
  setupLazyHomeSections();
</script>

  <HomeSectionBreaker
    id={triServerJointJourneySection.id}
    locale={locale}
    primaryName={triServerJointPrimaryName}
    secondaryName={triServerJointSecondaryName}
    lineColor={`var(${homeLineCssVariable})`}
    trainColor={homeTrainColor}
    lineCode={homeLine.code}
    sequence={triServerJointJourneySection.sequence}
    linePrimaryName={homeLinePrimaryName}
    lineSecondaryName={homeLineSecondaryName}
  />
  <HomeTriServerSection locale={locale} lineColor={`var(${homeLineCssVariable})`} />
  <HomeTransferSectionBreaker
    id={sharedShoreJourneySection.id}
    locale={locale}
    primaryName={sharedShorePrimaryName}
    secondaryName={sharedShoreSecondaryName}
    incomingLine={sharedShoreIncomingLine}
    incomingSequence={sharedShoreJourneySection.transferFrom.sequence}
    outgoingLine={sharedShoreOutgoingLine}
    outgoingSequence={sharedShoreJourneySection.sequence}
    incomingTrainColor={homeTrainColor}
    outgoingTrainColor={sharedShoreOutgoingTrainColor}
    trainTooltipTriggerLabel={messages.home.arrival.trainTooltip.triggerLabel}
  />
  <HomeCommunitySection
    locale={locale}
    lineColor={`var(${getRailwayLineCssVariableName(sharedShoreOutgoingLine)})`}
  />
  <HomeTransferSectionBreaker
    id={onwardJourneySection.id}
    composition="open"
    locale={locale}
    primaryName={onwardPrimaryName}
    secondaryName={onwardSecondaryName}
    incomingLine={onwardIncomingLine}
    incomingSequence={onwardJourneySection.transferFrom.sequence}
    outgoingLine={onwardOutgoingLine}
    outgoingSequence={onwardJourneySection.sequence}
    incomingTrainColor={onwardIncomingTrainColor}
    outgoingTrainColor={onwardOutgoingTrainColor}
    trainTooltipTriggerLabel={messages.home.arrival.trainTooltip.triggerLabel}
  />
  <HomeOnwardSection
    locale={locale}
    lineColor={`var(${getRailwayLineCssVariableName(onwardOutgoingLine)})`}
  />
  <HomeFooter
    locale={locale}
    lineColor={`var(${getRailwayLineCssVariableName(onwardOutgoingLine)})`}
  />
</BaseLayout>
