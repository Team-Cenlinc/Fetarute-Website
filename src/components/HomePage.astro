---
import { getImage } from "astro:assets";
import handTapIcon from "@phosphor-icons/core/assets/regular/hand-tap.svg?raw";
import mouseSimpleIcon from "@phosphor-icons/core/assets/regular/mouse-simple.svg?raw";
import DepartureGate from "@/components/DepartureGate.astro";
import HomeJourneyQuickPick from "@/components/HomeJourneyQuickPick.astro";
import HomeSectionBreaker from "@/components/HomeSectionBreaker.astro";
import HomeTransferSectionBreaker from "@/components/HomeTransferSectionBreaker.astro";
import HomeTriServerSection from "@/components/HomeTriServerSection.astro";
import RailwayLineHint from "@/components/RailwayLineHint.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home-shell.css";
import "@/styles/home.css";
// 保持 Figma 导出的原始 Bézier 作为内联 SVG，使可见弯轨与列车采样的几何完全一致。
import ServerlinkBend from "@/assets/pages/home/serverlink-bend.svg";
import { homeGalleryScenes } from "@/data/home-gallery";
import {
  getHomeSceneryOutputWidths,
  homeGalleryImageWidths,
  homeLandingImageWidths,
  homeSceneryImageQuality,
} from "@/data/home-image-output";
import { homeLandingScenes } from "@/data/home-landing";
import { getHomeJourneySectionNames, homeJourneySections } from "@/data/home-journey";
import { getRailwayLineCssVariableName } from "@/data/palette";
import { railwayLineByKey, shiftRailwayLineColor } from "@/data/railway";
import { wayfindingPrototype } from "@/data/site";
import { type Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";

/**
 * 多语言首页的属性。
 * 每个公开语言路由只传入 locale；页面结构、图片与交互边界保持同一份 Astro SSG 实现。
 */
export interface Props {
  /** 当前首页所属的公开语言。 */
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);

/**
 * 为每张受控实景生成可由浏览器延迟选择的两种现代格式。
 * 首帧保留第一张作为无脚本回退；脚本只替换地址，不会将所有候选图片同时放进页面布局。
 */
const landingSceneImages = await Promise.all(
  homeLandingScenes.map(async (scene) => {
    const outputWidths = getHomeSceneryOutputWidths(
      scene.image.width,
      2560,
      homeLandingImageWidths,
    );
    const [avifOutputs, webpOutputs] = await Promise.all([
      Promise.all(
        outputWidths.map((width) =>
          getImage({
            src: scene.image,
            format: "avif",
            width,
            quality: homeSceneryImageQuality.avif,
          }),
        ),
      ),
      Promise.all(
        outputWidths.map((width) =>
          getImage({
            src: scene.image,
            format: "webp",
            width,
            quality: homeSceneryImageQuality.webp,
          }),
        ),
      ),
    ]);
    const width = outputWidths.at(-1) ?? scene.image.width;
    const webp = webpOutputs.at(-1);

    if (!webp) {
      throw new Error(`首页 Landing 实景 ${scene.id} 没有生成可用的 WebP 输出。`);
    }

    return {
      id: scene.id,
      alt: messages.home.sceneAltById[scene.id],
      focalPoint: scene.focalPoint,
      copyShadow: scene.copyShadow,
      width,
      height: Math.round((scene.image.height / scene.image.width) * width),
      avifSrcset: avifOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
      webpSrc: webp.src,
      webpSrcset: webpOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
    };
  }),
);

/**
 * Gallery 截图在 SSG 阶段统一生成现代格式，并把可见标题与替代文本绑定到同一稳定 scene id。
 * 输出宽度封顶 1920px，足以覆盖 Figma 桌面卡片而不会让 2560px 原图进入每位访客的下载路径。
 */
const gallerySceneImages = await Promise.all(
  homeGalleryScenes.map(async (scene) => {
    const outputWidths = getHomeSceneryOutputWidths(
      scene.image.width,
      1920,
      homeGalleryImageWidths,
    );
    const width = outputWidths.at(-1) ?? Math.min(scene.image.width, 1920);
    const height = Math.round((scene.image.height / scene.image.width) * width);
    const [avifOutputs, webpOutputs] = await Promise.all([
      Promise.all(
        outputWidths.map((outputWidth) =>
          getImage({
            src: scene.image,
            format: "avif",
            width: outputWidth,
            quality: homeSceneryImageQuality.avif,
          }),
        ),
      ),
      Promise.all(
        outputWidths.map((outputWidth) =>
          getImage({
            src: scene.image,
            format: "webp",
            width: outputWidth,
            quality: homeSceneryImageQuality.webp,
          }),
        ),
      ),
    ]);
    const webp = webpOutputs.at(-1);
    const sceneMessage = messages.home.gallery.sceneById[scene.id];

    if (!webp) {
      throw new Error(`首页铁路回顾图片 ${scene.id} 没有生成可用的 WebP 输出。`);
    }

    return {
      id: scene.id,
      focalPoint: scene.focalPoint,
      width,
      height,
      avifSrcset: avifOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
      webpSrc: webp.src,
      webpSrcset: webpOutputs
        .map((output, outputIndex) => `${output.src} ${outputWidths[outputIndex]}w`)
        .join(", "),
      ...sceneMessage,
    };
  }),
);

const defaultLandingScene = landingSceneImages[0];

if (!defaultLandingScene) {
  throw new Error("首页至少需要登记一张可用的到站实景。");
}

const homeLine = railwayLineByKey.get(wayfindingPrototype.homeLineKey);

if (!homeLine) {
  throw new Error(`首页开屏引用了未录入的线路 ${wayfindingPrototype.homeLineKey}。`);
}

const homeLineCssVariable = getRailwayLineCssVariableName(homeLine);
const homeTrainColor = shiftRailwayLineColor(homeLine.color, wayfindingPrototype.homeTrainColorShift);
const homeArrivalJourneySection = homeJourneySections.find((section) => section.id === "beginning-bay");
const triServerJointJourneySection = homeJourneySections.find((section) => section.id === "tri-server-joint");
const sharedShoreJourneySection = homeJourneySections.find((section) => section.id === "shared-shore");

if (!homeArrivalJourneySection || !triServerJointJourneySection || !sharedShoreJourneySection) {
  throw new Error("首页站牌必须同时登记启始湾、三服汇与同岸章节。");
}

if (!sharedShoreJourneySection.transferFrom) {
  throw new Error("同岸必须登记换乘前的进入线路与站序。");
}

const sharedShoreIncomingLine = railwayLineByKey.get(sharedShoreJourneySection.transferFrom.lineKey);
const sharedShoreOutgoingLine = railwayLineByKey.get(sharedShoreJourneySection.lineKey);

if (!sharedShoreIncomingLine || !sharedShoreOutgoingLine) {
  throw new Error("同岸引用了未录入的换乘线路。");
}

const sharedShoreOutgoingTrainColor = shiftRailwayLineColor(
  sharedShoreOutgoingLine.color,
  wayfindingPrototype.homeTrainColorShift,
);

const [homeArrivalPrimaryName, homeArrivalSecondaryName] = getHomeJourneySectionNames(
  homeArrivalJourneySection,
  locale,
);
const [triServerJointPrimaryName, triServerJointSecondaryName] = getHomeJourneySectionNames(
  triServerJointJourneySection,
  locale,
);
const [sharedShorePrimaryName, sharedShoreSecondaryName] = getHomeJourneySectionNames(
  sharedShoreJourneySection,
  locale,
);
/** 线路导视跟随当前阅读语言切换主副名称，避免英文画面仍被中文大字主导。 */
const [homeLinePrimaryName, homeLineSecondaryName] =
  locale === "en" ? [homeLine.secondaryName, homeLine.primaryName] : [homeLine.primaryName, homeLine.secondaryName];
---

<BaseLayout locale={locale} description={messages.description} showLaunchSequence fullBleedMain>
  <DepartureGate slot="overlay" locale={locale} />

  <section
    class="hero-section"
    id="home"
    aria-labelledby="hero-title"
    style={`--hero-copy-shadow-blur: ${defaultLandingScene.copyShadow.blur}; --hero-copy-shadow-opacity: ${defaultLandingScene.copyShadow.opacity};`}
  >
    <!-- 脚本先在离线 picture 中装入最终随机场景，再一次性挂载；浏览器不会抢先请求默认图。 -->
    <picture class="hero-scene" data-landing-scene-id={defaultLandingScene.id}></picture>
    <noscript>
      <picture class="hero-scene">
        <source srcset={defaultLandingScene.avifSrcset} sizes="100vw" type="image/avif" />
        <img
          src={defaultLandingScene.webpSrc}
          srcset={defaultLandingScene.webpSrcset}
          sizes="100vw"
          width={defaultLandingScene.width}
          height={defaultLandingScene.height}
          alt={defaultLandingScene.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style={`object-position: ${defaultLandingScene.focalPoint};`}
        />
      </picture>
    </noscript>
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="hero-title__base">{messages.home.title}</span>
        <span class="hero-title__reflection" aria-hidden="true">{messages.home.title}</span>
      </h1>
      <p class="hero-description">{messages.home.description}</p>
    </div>
  </section>

  <script is:inline define:vars={{ landingSceneImages }}>
    (() => {
      const sceneElement = document.querySelector("[data-landing-scene-id]");
      const heroSection = sceneElement?.closest(".hero-section");
      const heroTitle = heroSection?.querySelector("#hero-title");
      /** 同一标签页只记录上一张 Landing 实景，既保留随机性，又避免连续刷新恰好重复时误以为没有生效。 */
      const landingSceneSessionKey = "fetarute.home.landing-scene-id";

      if (
        !(sceneElement instanceof HTMLElement) ||
        !(heroSection instanceof HTMLElement) ||
        !(heroTitle instanceof HTMLElement)
      ) {
        return;
      }

      /** 使用密码学随机源避免刷新时固定落在同一张图；旧浏览器安全回退至 Math.random。 */
      const getRandomIndex = (length) => {
        if (length <= 1) {
          return 0;
        }

        if (window.crypto?.getRandomValues) {
          const values = new Uint32Array(1);
          window.crypto.getRandomValues(values);
          return Math.floor((values[0] / 2 ** 32) * length);
        }

        return Math.floor(Math.random() * length);
      };

      const getPreviousSceneId = () => {
        try {
          return window.sessionStorage.getItem(landingSceneSessionKey);
        } catch {
          // 隐私模式或受限嵌入上下文不能访问 storage 时，退回普通随机即可。
          return null;
        }
      };
      const previousSceneId = getPreviousSceneId();
      const selectableScenes = landingSceneImages.filter((scene) => scene.id !== previousSceneId);
      const selectedScene = selectableScenes[getRandomIndex(selectableScenes.length)];

      if (!selectedScene) {
        return;
      }

      const selectedSource = document.createElement("source");
      selectedSource.type = "image/avif";

      const sceneImage = document.createElement("img");
      sceneImage.dataset.landingSceneImage = "";
      sceneImage.width = selectedScene.width;
      sceneImage.height = selectedScene.height;
      sceneImage.alt = selectedScene.alt;
      sceneImage.loading = "eager";
      sceneImage.fetchPriority = "high";
      sceneImage.decoding = "async";
      sceneImage.style.objectPosition = selectedScene.focalPoint;

      sceneElement.dataset.landingSceneId = selectedScene.id;
      sceneElement.replaceChildren(selectedSource, sceneImage);
      // 先把无地址节点挂入 picture，再登记 AVIF 与回退地址，避免游离 img 抢先发出 WebP 请求。
      selectedSource.srcset = selectedScene.avifSrcset;
      selectedSource.sizes = "100vw";
      sceneImage.src = selectedScene.webpSrc;
      sceneImage.srcset = selectedScene.webpSrcset;
      sceneImage.sizes = "100vw";
      heroSection.style.setProperty("--hero-copy-shadow-blur", selectedScene.copyShadow.blur);
      heroSection.style.setProperty("--hero-copy-shadow-opacity", selectedScene.copyShadow.opacity);

      try {
        window.sessionStorage.setItem(landingSceneSessionKey, selectedScene.id);
      } catch {
        // 读取失败时已经正常随机；写入失败只意味着下一次刷新可能再次抽到同一张。
      }

      /** 将 CSS object-position 的关键词或百分比统一为可参与 cover 裁切计算的 0-1 锚点。 */
      const getObjectPositionRatio = (value, startKeyword, endKeyword) => {
        if (value === startKeyword) {
          return 0;
        }

        if (value === endKeyword) {
          return 1;
        }

        if (value === "center") {
          return 0.5;
        }

        const percentage = Number.parseFloat(value);
        return Number.isFinite(percentage) ? Math.min(1, Math.max(0, percentage / 100)) : 0.5;
      };

      /** 将 RGB 像素转换为 HSL，供后续排除无色暗部并以圆形均值汇总色相。 */
      const getPixelHsl = (red, green, blue) => {
        const r = red / 255;
        const g = green / 255;
        const b = blue / 255;
        const maximum = Math.max(r, g, b);
        const minimum = Math.min(r, g, b);
        const delta = maximum - minimum;
        const lightness = (maximum + minimum) / 2;

        if (delta === 0) {
          return { hue: 0, saturation: 0, lightness };
        }

        let hue =
          maximum === r
            ? ((g - b) / delta) % 6
            : maximum === g
              ? (b - r) / delta + 2
              : (r - g) / delta + 4;

        hue = (hue * 60 + 360) % 360;

        return {
          hue,
          saturation: delta / (1 - Math.abs(2 * lightness - 1)),
          lightness,
        };
      };

      /**
       * 从标题实际覆盖的可见图片区域取样。
       * 只保留有色相的中高亮像素，避开黑色遮罩和近白高光，再把加权色相收敛成适合反光层的一种颜色。
       */
      const getTitleReflectionColor = () => {
        if (sceneImage.naturalWidth === 0 || sceneImage.naturalHeight === 0) {
          return null;
        }

        const imageBox = sceneImage.getBoundingClientRect();
        const titleBox = heroTitle.getBoundingClientRect();

        if (imageBox.width === 0 || imageBox.height === 0 || titleBox.width === 0 || titleBox.height === 0) {
          return null;
        }

        const canvasScale = Math.min(192 / Math.max(imageBox.width, imageBox.height), 1);
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(imageBox.width * canvasScale));
        canvas.height = Math.max(1, Math.round(imageBox.height * canvasScale));

        const context = canvas.getContext("2d", { willReadFrequently: true });
        if (!context) {
          return null;
        }

        const [horizontalPosition = "center", verticalPosition = "center"] = getComputedStyle(sceneImage).objectPosition.split(" ");
        const positionX = getObjectPositionRatio(horizontalPosition, "left", "right");
        const positionY = getObjectPositionRatio(verticalPosition, "top", "bottom");
        const coverScale = Math.max(
          imageBox.width / sceneImage.naturalWidth,
          imageBox.height / sceneImage.naturalHeight,
        );
        const renderedWidth = sceneImage.naturalWidth * coverScale;
        const renderedHeight = sceneImage.naturalHeight * coverScale;

        context.drawImage(
          sceneImage,
          (imageBox.width - renderedWidth) * positionX * canvasScale,
          (imageBox.height - renderedHeight) * positionY * canvasScale,
          renderedWidth * canvasScale,
          renderedHeight * canvasScale,
        );

        const sampleLeft = Math.max(0, Math.floor((titleBox.left - imageBox.left) * canvasScale));
        const sampleTop = Math.max(0, Math.floor((titleBox.top - imageBox.top) * canvasScale));
        const sampleRight = Math.min(canvas.width, Math.ceil((titleBox.right - imageBox.left) * canvasScale));
        const sampleBottom = Math.min(canvas.height, Math.ceil((titleBox.bottom - imageBox.top) * canvasScale));

        if (sampleRight <= sampleLeft || sampleBottom <= sampleTop) {
          return null;
        }

        const pixels = context.getImageData(sampleLeft, sampleTop, sampleRight - sampleLeft, sampleBottom - sampleTop).data;
        let hueX = 0;
        let hueY = 0;
        let saturationTotal = 0;
        let lightnessTotal = 0;
        let weightTotal = 0;

        for (let index = 0; index < pixels.length; index += 16) {
          const { hue, saturation, lightness } = getPixelHsl(pixels[index], pixels[index + 1], pixels[index + 2]);

          if (saturation < 0.14 || lightness < 0.12 || lightness > 0.92) {
            continue;
          }

          const weight = saturation * (0.35 + lightness * 0.65);
          const angle = (hue * Math.PI) / 180;
          hueX += Math.cos(angle) * weight;
          hueY += Math.sin(angle) * weight;
          saturationTotal += saturation * weight;
          lightnessTotal += lightness * weight;
          weightTotal += weight;
        }

        if (weightTotal === 0) {
          return null;
        }

        const hue = (Math.atan2(hueY, hueX) * 180) / Math.PI;
        const saturation = Math.min(0.6, Math.max(0.28, (saturationTotal / weightTotal) * 0.9));
        const lightness = Math.min(0.72, Math.max(0.5, lightnessTotal / weightTotal + 0.3));

        return `hsl(${(hue + 360) % 360}deg ${saturation * 100}% ${lightness * 100}%)`;
      };

      /** 图片解码后才替换首屏白色反光，避免把取色计算放进首帧渲染关键路径。 */
      const updateTitleReflectionColor = async () => {
        try {
          if (!sceneImage.complete) {
            await new Promise((resolve, reject) => {
              sceneImage.addEventListener("load", resolve, { once: true });
              sceneImage.addEventListener("error", reject, { once: true });
            });
          }

          await sceneImage.decode();
          await new Promise((resolve) => requestAnimationFrame(resolve));
          const reflectionColor = getTitleReflectionColor();

          if (reflectionColor) {
            heroSection.style.setProperty("--hero-copy-reflection-color", reflectionColor);
          }
        } catch {
          // CORS、图片解码或 Canvas 取样失败时维持 SSR 白色反光，不阻塞首屏可读性。
        }
      };

      /** 标题换行、设备旋转或字体完成加载后重取样，确保反光始终对应当前可见裁切，而非初次布局。 */
      let titleReflectionFrame = 0;
      const scheduleTitleReflectionColorUpdate = () => {
        window.cancelAnimationFrame(titleReflectionFrame);
        titleReflectionFrame = window.requestAnimationFrame(() => {
          void updateTitleReflectionColor();
        });
      };

      let titleReflectionResizeObserver;
      if ("ResizeObserver" in window) {
        titleReflectionResizeObserver = new ResizeObserver(scheduleTitleReflectionColorUpdate);
        titleReflectionResizeObserver.observe(heroSection);
        titleReflectionResizeObserver.observe(heroTitle);
      }

      if (document.fonts) {
        void document.fonts.ready.then(scheduleTitleReflectionColorUpdate).catch(() => {
          // 字体 API 不可用或加载失败时，图片 decode 后的首次取样仍是有效回退。
        });
      }

      window.addEventListener(
        "pagehide",
        (event) => {
          window.cancelAnimationFrame(titleReflectionFrame);
          if (!event.persisted) {
            titleReflectionResizeObserver?.disconnect();
          }
        },
      );

      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          scheduleTitleReflectionColorUpdate();
        }
      });

      void updateTitleReflectionColor();
    })();
  </script>

  <!-- 出发跑道先承接首屏余量；它与遮罩同底色，确保验票结束前不会提前露出第一叙事站。 -->
  <div class="departure-gate-sentinel" data-departure-gate-sentinel aria-hidden="true"></div>

  <section
    class="home-arrival"
    id="beginning-bay"
    data-home-arrival-route
    data-home-arrival-locale={locale}
    data-home-arrival-line-code={homeLine.code}
    data-home-arrival-line-color={homeLine.color}
    data-home-arrival-train-color={homeTrainColor}
    aria-labelledby="home-arrival-title"
    tabindex="-1"
    style={`--home-arrival-line-color: var(${homeLineCssVariable}); --home-arrival-train-color: ${homeTrainColor};`}
  >
    <span class="home-arrival__vertical-track" data-home-arrival-vertical-track aria-hidden="true"></span>
    <ServerlinkBend class="home-arrival__bend" data-home-arrival-bend aria-hidden="true" />
    <span class="home-arrival__horizontal-track" data-home-arrival-horizontal aria-hidden="true"></span>
    <div class="home-arrival__copy">
      <div class="home-arrival__name-lockup">
        <h1 id="home-arrival-title">{homeArrivalPrimaryName}</h1>
        <p>{homeArrivalSecondaryName}</p>
      </div>
    </div>
    <RailwayLineHint
      class="home-arrival__route"
      lineColor={`var(${homeLineCssVariable})`}
      lineCode={homeLine.code}
      sequence={homeArrivalJourneySection.sequence}
      primaryName={homeLinePrimaryName}
      secondaryName={homeLineSecondaryName}
      isEnglishPrimary={locale === "en"}
    />
    <!-- 单一 SVG 列车段覆盖直轨和弯轨；车体进入弯道时沿同一条路线自然弯曲。 -->
    <svg class="home-arrival__train-visual" data-home-arrival-train-visual aria-hidden="true">
      <path data-home-arrival-train-visual-path fill="none" stroke="currentColor" stroke-linecap="butt" />
    </svg>
    <button
      class="home-arrival__train"
      data-home-arrival-train
      data-tooltip-open="false"
      data-tooltip-mode="closed"
      type="button"
      aria-label={messages.home.arrival.trainTooltip.triggerLabel}
      aria-controls="home-arrival-train-tooltip"
      aria-haspopup="dialog"
      aria-expanded="false"
      disabled
    ></button>
    <p class="home-arrival__train-hint" aria-hidden="true">
      <span class="home-arrival__train-hint-icon home-arrival__train-hint-icon--pointer" set:html={mouseSimpleIcon} />
      <span class="home-arrival__train-hint-icon home-arrival__train-hint-icon--touch" set:html={handTapIcon} />
      <span class="home-arrival__train-hint-copy home-arrival__train-hint-copy--pointer">
        {messages.home.arrival.trainTooltip.hoverHint}
      </span>
      <span class="home-arrival__train-hint-copy home-arrival__train-hint-copy--touch">
        {messages.home.arrival.trainTooltip.tapHint}
      </span>
    </p>
    <aside
      class="home-arrival__train-tooltip"
      id="home-arrival-train-tooltip"
      role="dialog"
      aria-label={messages.home.arrival.trainTooltip.title}
      aria-hidden="true"
    >
      <HomeJourneyQuickPick
        locale={locale}
        currentSectionId="beginning-bay"
        sections={homeJourneySections}
        currentSectionLabel={messages.home.arrival.trainTooltip.currentSectionLabel}
        quickPickLabel={messages.home.arrival.trainTooltip.quickPickLabel}
        goToSectionLabel={messages.home.arrival.trainTooltip.goToSectionLabel}
        closeLabel={messages.home.arrival.trainTooltip.closeLabel}
      />
    </aside>
  </section>

  <script>
    import {
      getHomeSectionBreakerEntryPathStartY,
      getHomeSectionBreakerScrollDistance,
      getHomeTrainColorTransitionProgress,
    } from "@/data/home-route-train";

    const homeArrivalTrain = document.querySelector<HTMLButtonElement>("[data-home-arrival-train]");
    const homeArrivalRoute = document.querySelector<HTMLElement>("[data-home-arrival-route]");
    const homeArrivalHorizontal = document.querySelector<HTMLElement>("[data-home-arrival-horizontal]");
    const homeArrivalVertical = document.querySelector<HTMLElement>("[data-home-arrival-vertical-track]");
    const homeArrivalBend = document.querySelector<HTMLElement>("[data-home-arrival-bend]");
    const homeArrivalTrainVisual = document.querySelector<SVGSVGElement>("[data-home-arrival-train-visual]");
    const homeArrivalTrainVisualPath = document.querySelector<SVGPathElement>(
      "[data-home-arrival-train-visual-path]",
    );
    const homeIntroductionRoute = document.querySelector<HTMLElement>("[data-home-introduction-route]");
    const homeIntroductionTrack = document.querySelector<HTMLElement>("[data-home-introduction-track]");
    const homeGalleryRoute = document.querySelector<HTMLElement>("[data-home-gallery]");
    const homeGalleryFirstFigure = document.querySelector<HTMLElement>(".home-gallery__figure");
    const homeSectionBreakerRoute = document.querySelector<HTMLElement>("[data-home-section-breaker-route]");
    const homeSectionBreakerStage = document.querySelector<HTMLElement>("[data-home-section-breaker-stage]");
    const homeSectionBreakerLeftTrack = document.querySelector<HTMLElement>(
      "[data-home-section-breaker-left-track]",
    );
    const homeSectionBreakerLeftBend = document.querySelector<SVGSVGElement>(
      "[data-home-section-breaker-left-bend]",
    );
    const homeSectionBreakerHorizontalTrack = document.querySelector<HTMLElement>(
      "[data-home-section-breaker-horizontal-track]",
    );
    const homeSectionBreakerRightBend = document.querySelector<SVGSVGElement>(
      "[data-home-section-breaker-right-bend]",
    );
    const homeSectionBreakerRightTrack = document.querySelector<HTMLElement>(
      "[data-home-section-breaker-right-track]",
    );
    const homeSectionBreakerStaticTrain = document.querySelector<HTMLElement>(
      "[data-home-section-breaker-static-train]",
    );
    const homeTriServerRoute = document.querySelector<HTMLElement>("[data-home-tri-server]");
    const homeTriServerTrack = document.querySelector<HTMLElement>("[data-home-tri-server-track]");
    const homeTriServerStopMarkers = homeTriServerRoute
      ? Array.from(
          homeTriServerRoute.querySelectorAll<HTMLElement>(
            "[data-home-tri-server-stop] .home-tri-server__station-marker",
          ),
        )
      : [];
    const homeTransferBreakerRoute = document.querySelector<HTMLElement>("[data-home-transfer-breaker]");
    const homeTransferBreakerStage = document.querySelector<HTMLElement>(
      "[data-home-transfer-breaker-stage]",
    );
    const homeTransferRightTrack = document.querySelector<HTMLElement>("[data-home-transfer-right-track]");
    const homeTransferRightBend = document.querySelector<SVGSVGElement>("[data-home-transfer-right-bend]");
    const homeTransferIncomingHorizontalTrack = document.querySelector<HTMLElement>(
      "[data-home-transfer-incoming-horizontal-track]",
    );
    const homeTransferOutgoingHorizontalTrack = document.querySelector<HTMLElement>(
      "[data-home-transfer-outgoing-horizontal-track]",
    );
    const homeTransferLeftBend = document.querySelector<SVGSVGElement>("[data-home-transfer-left-bend]");
    const homeTransferLeftTrack = document.querySelector<HTMLElement>("[data-home-transfer-left-track]");
    const homeTransferIncomingTrain = document.querySelector<HTMLButtonElement>(
      "[data-home-transfer-incoming-train]",
    );
    const homeTransferOutgoingTrain = document.querySelector<HTMLButtonElement>(
      "[data-home-transfer-outgoing-train]",
    );
    const homeArrivalTrainTooltip = document.querySelector<HTMLElement>("#home-arrival-train-tooltip");
    const homeJourneyPicker = document.querySelector<HTMLElement>("[data-home-journey-picker]");
    const homeJourneyMap = document.querySelector<HTMLElement>("[data-home-journey-map]");
    const homeJourneyClose = document.querySelector<HTMLButtonElement>("[data-home-journey-close]");

    if (
      homeArrivalTrain &&
      homeArrivalRoute &&
      homeArrivalHorizontal &&
      homeArrivalVertical &&
      homeArrivalBend &&
      homeArrivalTrainVisual &&
      homeArrivalTrainVisualPath &&
      homeIntroductionRoute &&
      homeIntroductionTrack &&
      homeGalleryRoute &&
      homeGalleryFirstFigure &&
      homeSectionBreakerRoute &&
      homeSectionBreakerStage &&
      homeSectionBreakerLeftTrack &&
      homeSectionBreakerLeftBend &&
      homeSectionBreakerHorizontalTrack &&
      homeSectionBreakerRightBend &&
      homeSectionBreakerRightTrack &&
      homeSectionBreakerStaticTrain &&
      homeTriServerRoute &&
      homeTriServerTrack &&
      homeTriServerStopMarkers.length > 0 &&
      homeTransferBreakerRoute &&
      homeTransferBreakerStage &&
      homeTransferRightTrack &&
      homeTransferRightBend &&
      homeTransferIncomingHorizontalTrack &&
      homeTransferOutgoingHorizontalTrack &&
      homeTransferLeftBend &&
      homeTransferLeftTrack &&
      homeTransferIncomingTrain &&
      homeTransferOutgoingTrain &&
      homeArrivalTrainTooltip &&
      homeJourneyPicker &&
      homeJourneyMap &&
      homeJourneyClose
    ) {
      /** 将一条数值限制在页面进度范围，避免 overscroll 时列车离开已绘制的线路。 */
      const clampRouteProgress = (value: number) => Math.min(Math.max(value, 0), 1);
      /** 让轨道锚点之间的过渡保留连续速度，而不是按离散 scroll 事件跳格。 */
      const interpolateRoutePosition = (start: number, end: number, progress: number) =>
        start + (end - start) * progress;
      const homeArrivalRouteStyle = getComputedStyle(homeArrivalRoute);
      const homeArrivalLineCode = homeArrivalRoute.dataset.homeArrivalLineCode ?? "";
      const homeArrivalLineColor =
        homeArrivalRoute.dataset.homeArrivalLineColor ??
        homeArrivalRouteStyle.getPropertyValue("--home-arrival-line-color").trim();
      const homeArrivalRouteTrainColor =
        homeArrivalRoute.dataset.homeArrivalTrainColor ??
        homeArrivalRouteStyle.getPropertyValue("--home-arrival-train-color").trim();
      const transferIncomingLineCode =
        homeTransferBreakerRoute.dataset.homeTransferIncomingLineCode ?? homeArrivalLineCode;
      const transferIncomingLineColor =
        homeTransferBreakerRoute.dataset.homeTransferIncomingLineColor ?? homeArrivalLineColor;
      const transferIncomingTrainColor =
        homeTransferBreakerRoute.dataset.homeTransferIncomingTrainColor ?? homeArrivalRouteTrainColor;
      const transferOutgoingLineCode =
        homeTransferBreakerRoute.dataset.homeTransferOutgoingLineCode ?? transferIncomingLineCode;
      const transferOutgoingLineColor =
        homeTransferBreakerRoute.dataset.homeTransferOutgoingLineColor ?? transferIncomingLineColor;
      const transferOutgoingTrainColor =
        homeTransferBreakerRoute.dataset.homeTransferOutgoingTrainColor ?? transferIncomingTrainColor;
      /** 同岸两班站台列车与全程列车共用一份 Tooltip；当前触发器决定弹窗贴附位置与焦点归还点。 */
      const trainTooltipTriggers = [
        homeArrivalTrain,
        homeTransferIncomingTrain,
        homeTransferOutgoingTrain,
      ] as const;
      let activeTrainTooltipTrigger: HTMLButtonElement = homeArrivalTrain;
      /** 判断事件目标是否属于任一列车入口，供焦点与点击外部关闭逻辑共用。 */
      const isTrainTooltipTrigger = (target: EventTarget | null) =>
        target instanceof Node && trainTooltipTriggers.some((trigger) => trigger.contains(target));

      /**
       * 将全页 SVG 列车与 Tooltip 锚点同步到当前线路的派生色。
       * 换乘中段使用 oklch 插值，线路代码和进度同时写入 DOM，供调试与浏览器验收读取。
       */
      const setRouteTrainAppearance = (
        trainColor: string,
        lineColor: string,
        lineCode: string,
        colorProgress = 0,
      ) => {
        homeArrivalRoute.style.setProperty("--home-route-train-color", trainColor);
        homeArrivalRoute.style.setProperty("--home-route-line-color", lineColor);
        homeArrivalTrain.dataset.routeLineCode = lineCode;
        homeArrivalTrain.dataset.routeColorProgress = colorProgress.toFixed(3);
      };

      /** 按换乘进度同时混合列车附属色与官方线路色，避免 Tooltip 展开态被旧线路色拉回。 */
      const setTransferTrainAppearance = (progress: number) => {
        const mixedProgress = clampRouteProgress(progress);
        const incomingWeight = (1 - mixedProgress) * 100;
        const trainColor = `color-mix(in oklch, ${transferIncomingTrainColor} ${incomingWeight}%, ${transferOutgoingTrainColor})`;
        const lineColor = `color-mix(in oklch, ${transferIncomingLineColor} ${incomingWeight}%, ${transferOutgoingLineColor})`;
        const lineCode =
          mixedProgress <= 0
            ? transferIncomingLineCode
            : mixedProgress >= 1
              ? transferOutgoingLineCode
              : `${transferIncomingLineCode}-${transferOutgoingLineCode}`;

        setRouteTrainAppearance(trainColor, lineColor, lineCode, mixedProgress);
      };
      /** 竖向旅程的底部锚点保留完整按钮，让最后一屏仍能打开 Tooltip。 */
      const getRouteBottomTrainCenterY = (trainHeight: number) =>
        window.innerHeight - trainHeight / 2 - 20;
      /** 三服汇接车点读取首个 Station Mark 在 section 顶边时的位置，让交接帧就是创造服停靠帧。 */
      const getTriServerEntryTrainCenterY = (trainWidth: number, trainHeight: number) => {
        const firstMarker = homeTriServerStopMarkers[0];
        const triServerTop = homeTriServerRoute.getBoundingClientRect().top + window.scrollY;
        const firstMarkerCenterY = firstMarker
          ? firstMarker.getBoundingClientRect().top +
            window.scrollY +
            firstMarker.offsetHeight / 2 -
            triServerTop
          : window.innerHeight / 2;

        return Math.min(
          getRouteBottomTrainCenterY(trainHeight),
          Math.max(trainWidth / 2 + 20, firstMarkerCenterY),
        );
      };
      /** 从相对视口坐标获得稳定的文档坐标；两段正文的边界会随字体和内容增长自动更新。 */
      const getDocumentTop = (element: HTMLElement) => element.getBoundingClientRect().top + window.scrollY;
      /** 减少动态时保留轨道关系，但列车不再随滚动更新位置。 */
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      /** 桌面读取 sticky 图片的视口位置；小屏则读取原生图片列的稳定文档间距。 */
      const desktopRouteGalleryQuery = window.matchMedia("(min-width: 1024px)");
      /** 固定顶部导航是路线图避让的第一条安全边界；未找到时仍以视口边距完成降级定位。 */
      const siteHeader = document.querySelector<HTMLElement>(".site-header");

      /**
       * 从 Gallery 首图的实时边界得到列车的共享起止中心。
       * Gallery 绘制与 Section Breaker 接车必须同时消费这组坐标，否则临界帧会生成两辆不同位置的列车。
       */
      const getGalleryTrainCenterRange = (trainHeight: number) => {
        const headerBottom = siteHeader ? Math.max(0, siteHeader.getBoundingClientRect().bottom) : 0;
        const galleryBounds = homeGalleryRoute.getBoundingClientRect();
        const galleryCardTop = desktopRouteGalleryQuery.matches
          ? Math.max(
              0,
              homeGalleryFirstFigure.getBoundingClientRect().top - Math.max(0, galleryBounds.top),
            )
          : Math.max(0, getDocumentTop(homeGalleryFirstFigure) - getDocumentTop(homeGalleryRoute));
        const startTop = Math.max(galleryCardTop, headerBottom + 12);
        const startCenterY = startTop + trainHeight / 2;
        const endCenterY = Math.max(
          startCenterY,
          galleryCardTop + homeGalleryFirstFigure.offsetHeight - trainHeight / 2 - 20,
        );

        return { startCenterY, endCenterY };
      };

      /**
       * 让操作提示只跟随列车离站的前一小段；随后淡出，把注意力交还给线路与站牌。
       * CSS variables 在桌面和小屏同步透明度与横向位移，减少动态模式则始终回到静止初态。
       */
      const updateTrainHintMotion = (routeProgress: number) => {
        const followProgress = clampRouteProgress(routeProgress / 0.1);
        const followDistance = Math.min(28, Math.max(18, window.innerWidth * 0.06));

        homeArrivalRoute.style.setProperty(
          "--home-arrival-train-hint-opacity",
          String(1 - followProgress),
        );
        homeArrivalRoute.style.setProperty(
          "--home-arrival-train-hint-shift-x",
          `${-followDistance * followProgress}px`,
        );
      };

      /** 将快选窗的坐标限制在视口安全区内，避免窄屏或短视口出现负坐标。 */
      const clampTooltipPosition = (value: number, minimum: number, maximum: number) =>
        Math.min(Math.max(value, minimum), Math.max(minimum, maximum));
      /**
       * 根据列车和快选窗的真实边界决定弹窗方向。
       * 优先将小型快选窗贴在列车的左右或上下；只有四周都无法完整容纳时才回退到导航下方的左上安全区。
       */
      const updateTrainTooltipPlacement = () => {
        const tooltipEdge = 20;
        /* 恢复原有 16px 呼吸距离，让 Tooltip 仍明显归属于当前列车，又不会与车身矩形粘成一块。 */
        const tooltipGap = 16;
        const trainBounds = activeTrainTooltipTrigger.getBoundingClientRect();
        const headerBottom = siteHeader ? Math.max(0, siteHeader.getBoundingClientRect().bottom) : 0;
        const preferredSafeTop = Math.max(tooltipEdge, headerBottom + 12);
        const tooltipStyle = window.getComputedStyle(homeArrivalTrainTooltip);
        const tooltipBorderBlockSize =
          (Number.parseFloat(tooltipStyle.borderTopWidth) || 0) +
          (Number.parseFloat(tooltipStyle.borderBottomWidth) || 0);
        const tooltipContentMaxBlockSize = Math.max(
          0,
          window.innerHeight - preferredSafeTop - tooltipEdge - tooltipBorderBlockSize,
        );

        homeArrivalTrainTooltip.style.setProperty(
          "--home-arrival-tooltip-content-max-block-size",
          `${tooltipContentMaxBlockSize}px`,
        );

        const tooltipWidth = homeArrivalTrainTooltip.offsetWidth;
        const tooltipHeight = homeArrivalTrainTooltip.offsetHeight;

        if (!tooltipWidth || !tooltipHeight) {
          return;
        }

        const safeTop = clampTooltipPosition(
          preferredSafeTop,
          tooltipEdge,
          window.innerHeight - tooltipHeight - tooltipEdge,
        );
        const safeRight = window.innerWidth - tooltipEdge;
        const safeBottom = window.innerHeight - tooltipEdge;
        const maxLeft = safeRight - tooltipWidth;
        const maxTop = safeBottom - tooltipHeight;
        const canFitVertically = maxTop >= safeTop;
        const canPlaceRight = trainBounds.right + tooltipGap + tooltipWidth <= safeRight;
        const canPlaceLeft = trainBounds.left - tooltipGap - tooltipWidth >= tooltipEdge;
        const canPlaceBelow = trainBounds.bottom + tooltipGap + tooltipHeight <= window.innerHeight - tooltipEdge;
        const canPlaceAbove = trainBounds.top - tooltipGap - tooltipHeight >= safeTop;
        let left = tooltipEdge;
        let top = safeTop;
        let placement = "corner";

        if (canFitVertically && canPlaceRight) {
          left = trainBounds.right + tooltipGap;
          top = clampTooltipPosition(trainBounds.top + trainBounds.height / 2 - tooltipHeight / 2, safeTop, maxTop);
          placement = "right";
        } else if (canFitVertically && canPlaceLeft) {
          left = trainBounds.left - tooltipGap - tooltipWidth;
          top = clampTooltipPosition(trainBounds.top + trainBounds.height / 2 - tooltipHeight / 2, safeTop, maxTop);
          placement = "left";
        } else if (canPlaceAbove) {
          left = clampTooltipPosition(trainBounds.left + trainBounds.width / 2 - tooltipWidth / 2, tooltipEdge, maxLeft);
          top = trainBounds.top - tooltipGap - tooltipHeight;
          placement = "above";
        } else if (canPlaceBelow) {
          left = clampTooltipPosition(trainBounds.left + trainBounds.width / 2 - tooltipWidth / 2, tooltipEdge, maxLeft);
          top = Math.max(safeTop, trainBounds.bottom + tooltipGap);
          placement = "below";
        }

        homeArrivalTrainTooltip.style.setProperty("--home-arrival-tooltip-left", `${left}px`);
        homeArrivalTrainTooltip.style.setProperty("--home-arrival-tooltip-top", `${top}px`);
        homeArrivalTrainTooltip.dataset.placement = placement;
      };

      /**
       * 减少动态时让列车固定在当前线路的底部安全区，不再沿路径逐帧移动。
       * 阅读线进入同岸后直接切到浦蓝线左轨与派生色，避免辅助模式退回旧三服汇位置。
       */
      const renderReducedMotionTrain = () => {
        updateTrainHintMotion(0);
        homeSectionBreakerRoute.dataset.routeEnhanced = "false";
        homeTransferBreakerRoute.dataset.routeEnhanced = "true";
        homeSectionBreakerRoute.style.setProperty("--home-section-breaker-scroll-distance", "0px");
        homeTransferBreakerRoute.style.setProperty("--home-transfer-scroll-distance", "0px");
        const trainWidth = homeArrivalTrain.offsetWidth;
        const trainHeight = homeArrivalTrain.offsetHeight;
        const transferBounds = homeTransferBreakerRoute.getBoundingClientRect();
        const isReadingTransferBreaker =
          transferBounds.top <= window.innerHeight / 2 &&
          transferBounds.bottom > window.innerHeight / 2;
        const areTransferTrainControlsActive =
          isReadingTransferBreaker && desktopRouteGalleryQuery.matches;

        homeArrivalTrain.dataset.transferControlsActive = String(areTransferTrainControlsActive);
        homeTransferIncomingTrain.disabled = !areTransferTrainControlsActive;
        homeTransferOutgoingTrain.disabled = !areTransferTrainControlsActive;

        if (!areTransferTrainControlsActive && activeTrainTooltipTrigger !== homeArrivalTrain) {
          setTrainTooltipOpen(false);
          activeTrainTooltipTrigger = homeArrivalTrain;
        }

        if (areTransferTrainControlsActive) {
          renderTransferHandoff(1);
          homeArrivalTrain.dataset.routeVisible = "true";
          homeArrivalTrain.disabled = false;
          updateTrainTooltipPlacement();
          return;
        }

        const trackBounds = (
          isReadingTransferBreaker ? homeTransferLeftTrack : homeTriServerTrack
        ).getBoundingClientRect();

        if (isReadingTransferBreaker) {
          setTransferTrainAppearance(1);
        } else {
          setRouteTrainAppearance(
            homeArrivalRouteTrainColor,
            homeArrivalLineColor,
            homeArrivalLineCode,
          );
        }

        renderViewportVerticalTrain(
          trackBounds.left + trackBounds.width / 2,
          getRouteBottomTrainCenterY(trainHeight),
          trainWidth,
          trainHeight,
          isReadingTransferBreaker ? "static-transfer" : "static",
        );
        homeArrivalTrain.dataset.routeVisible = "true";
        homeArrivalTrainVisual.dataset.routeVisible = "true";
        homeArrivalTrain.disabled = false;
        updateTrainTooltipPlacement();
      };

      /**
       * 把当前 SVG 路径中的弯曲车体同步到透明按钮与 Tooltip 锚点。
       * 所有 section 共用这一出口，避免曲线阶段与直线阶段各自维护一份定位误差。
       */
      const renderTrainOnCurrentPath = (
        journeyLength: number,
        trainTailDistance: number,
        trainWidth: number,
        trainHeight: number,
      ) => {
        const maxTrainTailDistance = Math.max(0, journeyLength - trainWidth);
        const clampedTrainTailDistance = Math.min(
          Math.max(0, trainTailDistance),
          maxTrainTailDistance,
        );
        homeArrivalTrainVisualPath.setAttribute(
          "stroke-dasharray",
          `${trainWidth} ${Math.max(1, journeyLength)}`,
        );
        homeArrivalTrainVisualPath.setAttribute("stroke-dashoffset", String(-clampedTrainTailDistance));

        const trainCenterDistance = Math.min(
          journeyLength,
          clampedTrainTailDistance + trainWidth / 2,
        );
        const trainCenter = homeArrivalTrainVisualPath.getPointAtLength(trainCenterDistance);
        homeArrivalRoute.style.setProperty("--home-route-train-x", `${trainCenter.x - trainWidth / 2}px`);
        homeArrivalRoute.style.setProperty("--home-route-train-y", `${trainCenter.y - trainHeight / 2}px`);

        if (homeArrivalTrain.dataset.tooltipOpen === "true") {
          updateTrainTooltipPlacement();
        }
      };

      /**
       * 按当前 viewport 的真实轨道准备列车测量路径。
       * 桌面保留两段 Figma Bézier，小屏只生成单一左轨；完整路径用于距离测量，只显示当前车体对应的 dash 段。
       */
      const prepareSectionBreakerTrainPath = (
        trainWidth: number,
        trainHeight: number,
        pinnedStageTop?: number,
      ) => {
        const leftTrackBounds = homeSectionBreakerLeftTrack.getBoundingClientRect();
        const leftTrackX = leftTrackBounds.left + leftTrackBounds.width / 2;

        if (!desktopRouteGalleryQuery.matches) {
          const pathStartY = leftTrackBounds.top - trainWidth;
          const pathEndY = leftTrackBounds.bottom;
          homeArrivalTrainVisualPath.setAttribute(
            "d",
            `M${leftTrackX} ${pathStartY} L${leftTrackX} ${pathEndY}`,
          );
          homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));
          const journeyLength = homeArrivalTrainVisualPath.getTotalLength();
          const maxTrainTailDistance = Math.max(0, journeyLength - trainWidth);

          return {
            journeyLength,
            maxTrainTailDistance,
            curveEntryTailDistance: maxTrainTailDistance / 2,
            leftVerticalLength: journeyLength,
            leftCurveEndDistance: Number.POSITIVE_INFINITY,
            horizontalEndDistance: Number.POSITIVE_INFINITY,
            rightCurveEndDistance: Number.POSITIVE_INFINITY,
          };
        }

        const leftBendBounds = homeSectionBreakerLeftBend.getBoundingClientRect();
        const horizontalBounds = homeSectionBreakerHorizontalTrack.getBoundingClientRect();
        const rightBendBounds = homeSectionBreakerRightBend.getBoundingClientRect();
        const rightTrackBounds = homeSectionBreakerRightTrack.getBoundingClientRect();
        const stageBounds = homeSectionBreakerStage.getBoundingClientRect();
        const leftBendPath = homeSectionBreakerLeftBend.querySelector<SVGPathElement>("path");
        const rightBendPath = homeSectionBreakerRightBend.querySelector<SVGPathElement>("path");

        if (!leftBendPath || !rightBendPath) {
          const pathStartY = leftTrackBounds.top - trainWidth;
          const pathEndY = leftTrackBounds.bottom;
          homeArrivalTrainVisualPath.setAttribute(
            "d",
            `M${leftTrackX} ${pathStartY} L${leftTrackX} ${pathEndY}`,
          );
          homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));
          const journeyLength = homeArrivalTrainVisualPath.getTotalLength();
          const maxTrainTailDistance = Math.max(0, journeyLength - trainWidth);

          return {
            journeyLength,
            maxTrainTailDistance,
            curveEntryTailDistance: maxTrainTailDistance / 2,
            leftVerticalLength: journeyLength,
            leftCurveEndDistance: Number.POSITIVE_INFINITY,
            horizontalEndDistance: Number.POSITIVE_INFINITY,
            rightCurveEndDistance: Number.POSITIVE_INFINITY,
          };
        }

        /** 测量滚动行程时把尚未 sticky 的舞台投影到视口顶端，消除当前 scrollY 对路径长度的污染。 */
        const projectStageY = (viewportY: number) =>
          pinnedStageTop === undefined
            ? viewportY
            : viewportY + pinnedStageTop - stageBounds.top;
        const leftCurveStartX = leftBendBounds.left + leftBendBounds.width * (31 / 249);
        const leftCurveStartY = projectStageY(leftBendBounds.top);
        const leftCurveEndX = leftBendBounds.right;
        const leftCurveEndY = projectStageY(
          leftBendBounds.top + leftBendBounds.height * (219 / 250),
        );
        const horizontalY = projectStageY(horizontalBounds.top + horizontalBounds.height / 2);
        const rightCurveStartX = rightBendBounds.left;
        const rightCurveStartY = projectStageY(
          rightBendBounds.top + rightBendBounds.height * (31 / 250),
        );
        const rightCurveEndX = rightBendBounds.left + rightBendBounds.width * (218 / 249);
        const rightCurveEndY = projectStageY(rightBendBounds.bottom);
        const rightTrackX = rightTrackBounds.left + rightTrackBounds.width / 2;
        // 以 Gallery 绘制的同一终点接车；若交接点低于首弯，则向上补足一个车长，保持入弯切线方向连续。
        const incomingPathStartY = getHomeSectionBreakerEntryPathStartY({
          galleryTrainTailY: getGalleryTrainCenterRange(trainHeight).endCenterY - trainWidth / 2,
          curveStartY: leftCurveStartY,
          trainLength: trainWidth,
        });
        // 解除 sticky 前让列车仍露在右轨底部；下一阶段会沿同一轴线把它平顺带到三服汇接车点。
        const rightTrackEndY = getRouteBottomTrainCenterY(trainHeight) + trainWidth / 2;
        const pathData = [
          `M${leftTrackX} ${incomingPathStartY}`,
          `L${leftCurveStartX} ${leftCurveStartY}`,
          `C${leftCurveStartX} ${projectStageY(
            leftBendBounds.top + leftBendBounds.height * (140.5 / 250),
          )} ${
            leftBendBounds.left + leftBendBounds.width * (86 / 249)
          } ${leftCurveEndY} ${leftCurveEndX} ${leftCurveEndY}`,
          `L${rightCurveStartX} ${horizontalY}`,
          `C${rightBendBounds.left + rightBendBounds.width * (163 / 249)} ${rightCurveStartY} ${
            rightBendBounds.left + rightBendBounds.width * (218 / 249)
          } ${projectStageY(
            rightBendBounds.top + rightBendBounds.height * (109.5 / 250),
          )} ${rightCurveEndX} ${rightCurveEndY}`,
          `L${rightTrackX} ${rightTrackEndY}`,
        ].join(" ");
        homeArrivalTrainVisualPath.setAttribute("d", pathData);
        homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));

        const leftVerticalLength = Math.hypot(
          leftCurveStartX - leftTrackX,
          leftCurveStartY - incomingPathStartY,
        );
        const leftCurveLength = leftBendPath.getTotalLength() * (leftBendBounds.width / 249);
        const horizontalLength = Math.hypot(
          rightCurveStartX - leftCurveEndX,
          rightCurveStartY - leftCurveEndY,
        );
        const rightCurveLength = rightBendPath.getTotalLength() * (rightBendBounds.width / 249);
        const journeyLength = homeArrivalTrainVisualPath.getTotalLength();
        const maxTrainTailDistance = Math.max(0, journeyLength - trainWidth);
        const curveEntryTailDistance = Math.max(0, leftVerticalLength - trainWidth / 2);
        const leftCurveEndDistance = leftVerticalLength + leftCurveLength;
        const horizontalEndDistance = leftCurveEndDistance + horizontalLength;
        const rightCurveEndDistance = horizontalEndDistance + rightCurveLength;

        return {
          journeyLength,
          maxTrainTailDistance,
          curveEntryTailDistance,
          leftVerticalLength,
          leftCurveEndDistance,
          horizontalEndDistance,
          rightCurveEndDistance,
        };
      };

      /**
       * 依据同岸当前 viewport 几何生成 SL 从右侧驶入、最终停靠左侧站台的路线。
       * Figma 70:2 的 BS 是另一班接续列车，因此不再用一条伪造的 S 形轨道把两线焊在一起。
       */
      const prepareTransferIncomingTrainPath = (
        trainWidth: number,
        trainHeight: number,
        pinnedStageTop?: number,
      ) => {
        const rightTrackBounds = homeTransferRightTrack.getBoundingClientRect();
        const rightBendBounds = homeTransferRightBend.getBoundingClientRect();
        const horizontalBounds = homeTransferIncomingHorizontalTrack.getBoundingClientRect();
        const incomingTrainBounds = homeTransferIncomingTrain.getBoundingClientRect();
        const stageBounds = homeTransferBreakerStage.getBoundingClientRect();
        const rightBendPath = homeTransferRightBend.querySelector<SVGPathElement>("path");
        const projectStageY = (viewportY: number) =>
          pinnedStageTop === undefined
            ? viewportY
            : viewportY + pinnedStageTop - stageBounds.top;
        const rightTrackX = rightTrackBounds.left + rightTrackBounds.width / 2;
        const rightCurveStartX =
          rightBendBounds.left + rightBendBounds.width * (218 / 249);
        const rightCurveStartY = projectStageY(rightBendBounds.top);
        const rightCurveEndX = rightBendBounds.left;
        const rightCurveEndY = projectStageY(
          rightBendBounds.top + rightBendBounds.height * (219 / 250),
        );
        const horizontalY = projectStageY(horizontalBounds.top + horizontalBounds.height / 2);
        const incomingPathStartY = getHomeSectionBreakerEntryPathStartY({
          galleryTrainTailY: getRouteBottomTrainCenterY(trainHeight) - trainWidth / 2,
          curveStartY: rightCurveStartY,
          trainLength: trainWidth,
        });
        const pathData = [
          `M${rightTrackX} ${incomingPathStartY}`,
          `L${rightCurveStartX} ${rightCurveStartY}`,
          `C${rightCurveStartX} ${projectStageY(
            rightBendBounds.top + rightBendBounds.height * (140.5 / 250),
          )} ${rightBendBounds.left + rightBendBounds.width * (163 / 249)} ${rightCurveEndY} ${rightCurveEndX} ${rightCurveEndY}`,
          `L${incomingTrainBounds.left} ${horizontalY}`,
        ].join(" ");
        homeArrivalTrainVisualPath.setAttribute("d", pathData);
        homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));

        const rightVerticalLength = Math.hypot(
          rightCurveStartX - rightTrackX,
          rightCurveStartY - incomingPathStartY,
        );
        const rightCurveLength =
          (rightBendPath?.getTotalLength() ?? 0) * (rightBendBounds.width / 249);
        const journeyLength = homeArrivalTrainVisualPath.getTotalLength();
        const maxTrainTailDistance = Math.max(0, journeyLength - trainWidth);
        const curveEntryTailDistance = Math.max(0, rightVerticalLength - trainWidth / 2);
        const rightCurveEndDistance = rightVerticalLength + rightCurveLength;

        return {
          journeyLength,
          maxTrainTailDistance,
          curveEntryTailDistance,
          rightVerticalLength,
          rightCurveEndDistance,
        };
      };

      /** SL 进站阶段保留上一节的连续列车，并在抵达蓝色站台列车时无缝交还视觉。 */
      const renderTransferIncomingTrain = (
        pathState: ReturnType<typeof prepareTransferIncomingTrainPath>,
        trainTailDistance: number,
        trainWidth: number,
        trainHeight: number,
      ) => {
        const trainCenterDistance = trainTailDistance + trainWidth / 2;

        setTransferTrainAppearance(0);
        homeArrivalTrain.dataset.routeSegment =
          trainCenterDistance < pathState.rightVerticalLength
            ? "transfer-right"
            : trainCenterDistance < pathState.rightCurveEndDistance
              ? "transfer-curve-in"
              : "transfer-incoming-platform";
        renderTrainOnCurrentPath(
          pathState.journeyLength,
          trainTailDistance,
          trainWidth,
          trainHeight,
        );
      };

      /** pinned 换乘阶段保留两班可交互列车；未主动选择时才由滚动进度建议默认线路。 */
      const renderTransferHandoff = (handoffProgress: number) => {
        const hasSelectedTransferTrain =
          homeArrivalTrain.dataset.tooltipOpen === "true" &&
          activeTrainTooltipTrigger !== homeArrivalTrain;
        const isOutgoingTrainActive = hasSelectedTransferTrain
          ? activeTrainTooltipTrigger === homeTransferOutgoingTrain
          : handoffProgress >= 0.5;
        const activeTrain = isOutgoingTrainActive
          ? homeTransferOutgoingTrain
          : homeTransferIncomingTrain;
        const activeTrainBounds = activeTrain.getBoundingClientRect();

        homeTransferBreakerRoute.dataset.activeTrain = isOutgoingTrainActive
          ? "outgoing"
          : "incoming";
        setTransferTrainAppearance(isOutgoingTrainActive ? 1 : 0);
        homeArrivalTrainVisual.dataset.routeVisible = "false";
        homeArrivalRoute.style.setProperty("--home-route-train-x", `${activeTrainBounds.left}px`);
        homeArrivalRoute.style.setProperty("--home-route-train-y", `${activeTrainBounds.top}px`);
        homeArrivalTrain.dataset.routeSegment = isOutgoingTrainActive
          ? "transfer-outgoing-platform"
          : "transfer-incoming-platform";
        updateTrainTooltipPlacement();
      };

      /** 用真实路径阈值标记列车所在轨段，再把弯曲车体和 Tooltip 锚点同步到该段。 */
      const renderSectionBreakerTrain = (
        pathState: ReturnType<typeof prepareSectionBreakerTrainPath>,
        trainTailDistance: number,
        trainWidth: number,
        trainHeight: number,
      ) => {
        const trainCenterDistance = trainTailDistance + trainWidth / 2;

        homeArrivalTrain.dataset.routeSegment = !desktopRouteGalleryQuery.matches
          ? "breaker-left"
          : trainCenterDistance < pathState.leftVerticalLength
            ? "breaker-left"
            : trainCenterDistance < pathState.leftCurveEndDistance
              ? "breaker-curve-in"
              : trainCenterDistance < pathState.horizontalEndDistance
                ? "breaker-horizontal"
                : trainCenterDistance < pathState.rightCurveEndDistance
                  ? "breaker-curve-out"
                  : "breaker-right";
        renderTrainOnCurrentPath(
          pathState.journeyLength,
          trainTailDistance,
          trainWidth,
          trainHeight,
        );
      };

      /** 在固定视口的竖轴上绘制可交互列车，给小屏直轨与 Tooltip 共享稳定命中区。 */
      const renderViewportVerticalTrain = (
        trackX: number,
        trainCenterY: number,
        trainWidth: number,
        trainHeight: number,
        routeSegment: string,
      ) => {
        const routeStartY = -trainWidth;
        const routeEndY = window.innerHeight + trainWidth;

        homeArrivalTrainVisualPath.setAttribute(
          "d",
          `M${trackX} ${routeStartY} L${trackX} ${routeEndY}`,
        );
        homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));
        const journeyLength = homeArrivalTrainVisualPath.getTotalLength();
        const trainTailDistance = trainCenterY - routeStartY - trainWidth / 2;

        homeArrivalTrain.dataset.routeSegment = routeSegment;
        renderTrainOnCurrentPath(journeyLength, trainTailDistance, trainWidth, trainHeight);
      };

      /**
       * Section Breaker 解除 sticky 后，左右章节的竖轨会在视口内首尾相接。
       * 这段把同一 SVG 车体从底部带到三服汇中线，避免隐藏一整屏后再从顶部重新生成。
       */
      const renderSectionBreakerHandoffTrain = (
        handoffProgress: number,
        trainWidth: number,
        trainHeight: number,
      ) => {
        const breakerTrackBounds = homeSectionBreakerRightTrack.getBoundingClientRect();
        const triServerTrackBounds = homeTriServerTrack.getBoundingClientRect();
        const trackX = interpolateRoutePosition(
          breakerTrackBounds.left + breakerTrackBounds.width / 2,
          triServerTrackBounds.left + triServerTrackBounds.width / 2,
          handoffProgress,
        );
        const trainCenterY = interpolateRoutePosition(
          getRouteBottomTrainCenterY(trainHeight),
          getTriServerEntryTrainCenterY(trainWidth, trainHeight),
          handoffProgress,
        );
        const routeStartY = -trainWidth;
        const routeEndY = window.innerHeight + trainWidth;

        homeArrivalTrainVisualPath.setAttribute(
          "d",
          `M${trackX} ${routeStartY} L${trackX} ${routeEndY}`,
        );
        homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));
        const journeyLength = homeArrivalTrainVisualPath.getTotalLength();
        const trainTailDistance = trainCenterY - routeStartY - trainWidth / 2;

        homeArrivalTrain.dataset.routeSegment = "section-to-tri-server";
        renderTrainOnCurrentPath(journeyLength, trainTailDistance, trainWidth, trainHeight);
      };

      /**
       * 将三个 Station Mark 转成滚动与视口坐标锚点；列车在相邻锚点之间运行，
       * 每段首尾各保留 18% 的停靠区间，让创造、大厅与生存三站都能形成可读停靠。
       */
      const getTriServerTrainCenterY = (trainWidth: number, trainHeight: number) => {
        const firstStopCenterY = getTriServerEntryTrainCenterY(trainWidth, trainHeight);
        const lastStopCenterY = getRouteBottomTrainCenterY(trainHeight);
        const lastStopIndex = Math.max(1, homeTriServerStopMarkers.length - 1);
        const stopAnchors = homeTriServerStopMarkers.map((marker, index) => {
          const centerY = interpolateRoutePosition(
            firstStopCenterY,
            lastStopCenterY,
            index / lastStopIndex,
          );

          return {
            centerY,
            scrollY: getDocumentTop(marker) + marker.offsetHeight / 2 - centerY,
          };
        });
        const firstAnchor = stopAnchors[0];
        const lastAnchor = stopAnchors.at(-1);

        if (!firstAnchor || !lastAnchor || window.scrollY <= firstAnchor.scrollY) {
          return firstAnchor?.centerY ?? firstStopCenterY;
        }

        for (let index = 0; index < stopAnchors.length - 1; index += 1) {
          const currentAnchor = stopAnchors[index];
          const nextAnchor = stopAnchors[index + 1];

          if (!currentAnchor || !nextAnchor || window.scrollY > nextAnchor.scrollY) {
            continue;
          }

          const segmentProgress = clampRouteProgress(
            (window.scrollY - currentAnchor.scrollY) /
              Math.max(1, nextAnchor.scrollY - currentAnchor.scrollY),
          );
          const dwellRatio = 0.18;
          const travelProgress = clampRouteProgress(
            (segmentProgress - dwellRatio) / (1 - dwellRatio * 2),
          );
          const easedTravelProgress = travelProgress * travelProgress * (3 - 2 * travelProgress);

          return interpolateRoutePosition(
            currentAnchor.centerY,
            nextAnchor.centerY,
            easedTravelProgress,
          );
        }

        return lastAnchor.centerY;
      };

      /** 三服汇正文沿真实竖轨运行，并在三个 Station Mark 的滚动锚点完成停靠。 */
      const renderTriServerTrain = (trainWidth: number, trainHeight: number) => {
        const trackBounds = homeTriServerTrack.getBoundingClientRect();
        const trackX = trackBounds.left + trackBounds.width / 2;

        renderViewportVerticalTrain(
          trackX,
          getTriServerTrainCenterY(trainWidth, trainHeight),
          trainWidth,
          trainHeight,
          "tri-server",
        );
      };

      /**
       * Breaker 只在桌面增加压缩后的 native-scroll 行程。
       * 测量先把舞台投影到 sticky 顶点，避免页面从顶部启动时把 section 的文档偏移误算进路径长度。
       */
      let homeSectionBreakerScrollDistance = 0;
      const measureHomeSectionBreakerScrollDistance = () => {
        if (reducedMotionQuery.matches || !desktopRouteGalleryQuery.matches) {
          homeSectionBreakerScrollDistance = 0;
        } else {
          const pathState = prepareSectionBreakerTrainPath(
            homeArrivalTrain.offsetWidth,
            homeArrivalTrain.offsetHeight,
            0,
          );
          homeSectionBreakerScrollDistance = getHomeSectionBreakerScrollDistance({
            remainingPathDistance: Math.max(
              0,
              pathState.maxTrainTailDistance - pathState.curveEntryTailDistance,
            ),
            viewportHeight: window.innerHeight,
          });
        }

        homeSectionBreakerRoute.style.setProperty(
          "--home-section-breaker-scroll-distance",
          `${homeSectionBreakerScrollDistance}px`,
        );
      };

      /** 同岸桌面为“到达 → 换乘 → 接续”保留一段受控 sticky 行程；小屏仍保持一屏自然阅读。 */
      let homeTransferBreakerScrollDistance = 0;
      const measureHomeTransferBreakerScrollDistance = () => {
        if (reducedMotionQuery.matches || !desktopRouteGalleryQuery.matches) {
          homeTransferBreakerScrollDistance = 0;
        } else {
          homeTransferBreakerScrollDistance = Math.min(760, window.innerHeight * 0.72);
        }

        homeTransferBreakerRoute.style.setProperty(
          "--home-transfer-scroll-distance",
          `${homeTransferBreakerScrollDistance}px`,
        );
      };

      /**
       * 将 SVG 列车作为 fixed overlay 贴到真实轨道的当前 viewport 位置。
       * 前段沿横轨行进，中段取自 Figma 弯轨的 Bézier，后段与下一节垂直轨道共同向下推进。
       */
      const updateRouteTrain = () => {
        if (reducedMotionQuery.matches) {
          renderReducedMotionTrain();
          return;
        }

        homeSectionBreakerRoute.dataset.routeEnhanced = "true";
        homeTransferBreakerRoute.dataset.routeEnhanced = "true";

        const arrivalTop = getDocumentTop(homeArrivalRoute);
        const introductionTop = getDocumentTop(homeIntroductionRoute);
        const introductionBottom = introductionTop + homeIntroductionRoute.offsetHeight;
        const sectionBreakerTop = getDocumentTop(homeSectionBreakerRoute);
        const sectionBreakerBottom = sectionBreakerTop + homeSectionBreakerRoute.offsetHeight;
        const triServerTop = getDocumentTop(homeTriServerRoute);
        const triServerBottom = triServerTop + homeTriServerRoute.offsetHeight;
        const transferBreakerTop = getDocumentTop(homeTransferBreakerRoute);
        const transferBreakerRevealStart = Math.max(
          triServerTop,
          transferBreakerTop - window.innerHeight,
        );
        const transferBreakerRevealLength = Math.max(
          1,
          transferBreakerTop - transferBreakerRevealStart,
        );
        const transferBreakerRevealProgress =
          (window.scrollY - transferBreakerRevealStart) / transferBreakerRevealLength;
        const transferBreakerJourneyEnd = desktopRouteGalleryQuery.matches
          ? transferBreakerTop + homeTransferBreakerScrollDistance
          : transferBreakerTop;
        /* Fragment 定位会留下不足 1px 的小数误差；同岸顶边进入容差区即视为已经到站。 */
        const transferPlatformEpsilon = 1;
        const isTransferBreakerPhase =
          window.scrollY >= transferBreakerRevealStart &&
          window.scrollY <= transferBreakerJourneyEnd + 1;
        const sectionBreakerRevealStart = Math.max(
          introductionTop,
          sectionBreakerTop - window.innerHeight,
        );
        const sectionBreakerRevealLength = Math.max(
          1,
          sectionBreakerTop - sectionBreakerRevealStart,
        );
        const sectionBreakerRevealProgress =
          (window.scrollY - sectionBreakerRevealStart) / sectionBreakerRevealLength;
        // 桌面在满屏 sticky 舞台中按真实路线距离继续行进；小屏仍随整节纵向阅读自然前进。
        const sectionBreakerJourneyEnd = desktopRouteGalleryQuery.matches
          ? sectionBreakerTop + homeSectionBreakerScrollDistance
          : sectionBreakerBottom;
        const sectionBreakerJourneyLength = Math.max(
          1,
          sectionBreakerJourneyEnd - sectionBreakerRevealStart,
        );
        const sectionBreakerProgress =
          (window.scrollY - sectionBreakerRevealStart) / sectionBreakerJourneyLength;
        const isSectionBreakerPhase =
          sectionBreakerRevealProgress >= 0 && window.scrollY < sectionBreakerJourneyEnd;
        const sectionBreakerHandoffLength = Math.max(1, triServerTop - sectionBreakerJourneyEnd);
        const sectionBreakerHandoffProgress = clampRouteProgress(
          (window.scrollY - sectionBreakerJourneyEnd) / sectionBreakerHandoffLength,
        );
        const isSectionBreakerHandoffPhase =
          window.scrollY >= sectionBreakerJourneyEnd && window.scrollY < triServerTop;
        const isTriServerPhase =
          window.scrollY >= triServerTop && window.scrollY <= triServerBottom - window.innerHeight + 1;
        const areTransferTrainControlsActive =
          desktopRouteGalleryQuery.matches &&
          window.scrollY >= transferBreakerTop - transferPlatformEpsilon &&
          window.scrollY <= transferBreakerJourneyEnd + 1;

        homeArrivalTrain.dataset.transferControlsActive = String(areTransferTrainControlsActive);
        homeTransferIncomingTrain.disabled = !areTransferTrainControlsActive;
        homeTransferOutgoingTrain.disabled = !areTransferTrainControlsActive;

        if (areTransferTrainControlsActive && activeTrainTooltipTrigger === homeArrivalTrain) {
          setTrainTooltipOpen(false);
        } else if (!areTransferTrainControlsActive && activeTrainTooltipTrigger !== homeArrivalTrain) {
          setTrainTooltipOpen(false);
          activeTrainTooltipTrigger = homeArrivalTrain;
        }

        const trainWidth = homeArrivalTrain.offsetWidth;
        const trainHeight = homeArrivalTrain.offsetHeight;
        // 曲线结束后先完整驶过站页之间的竖直过渡段，再进入下一节的竖轨。
        const curveEndProgress = 0.4;
        const introductionTrackStartProgress = 0.48;
        // 第二张 Figma 画面中，正文刚顶到视窗时列车位于竖轨中段；以该位置反推整段滚动行程。
        const introductionStartRouteProgress =
          introductionTrackStartProgress + (1 - introductionTrackStartProgress) / 2;
        // 到达画面与正文站使用不同的滚动比例：进入正文时仍精确落在 Figma 规定的竖轨中段，
        // 随后才用正文的完整高度驶向底端，避免列车在正文读到一半时提前消失。
        const arrivalJourneyLength = Math.max(1, introductionTop - arrivalTop);
        const introductionJourneyLength = Math.max(1, introductionBottom - introductionTop);
        const rawProgress =
          window.scrollY <= introductionTop
            ? ((window.scrollY - arrivalTop) / arrivalJourneyLength) * introductionStartRouteProgress
            : introductionStartRouteProgress +
              ((window.scrollY - introductionTop) / introductionJourneyLength) *
                (1 - introductionStartRouteProgress);
        updateTrainHintMotion(rawProgress);
        const horizontalBounds = homeArrivalHorizontal.getBoundingClientRect();
        // ready 状态只允许在横轨真实进入视口时出现，避免列车先于线路悬在首屏实景上。
        const isReadyTrackVisible =
          horizontalBounds.bottom > 0 && horizontalBounds.top < window.innerHeight;
        const isRouteActive =
          isTransferBreakerPhase ||
          isTriServerPhase ||
          isSectionBreakerHandoffPhase ||
          (rawProgress >= 0 && (isSectionBreakerPhase || rawProgress <= 1));
        // 到站段内保持完整主线；到站前仅在可见横轨的右端候车，离开正文轨道后才收束 overlay。
        const isRoutePrepared = isRouteActive || (rawProgress < 0 && isReadyTrackVisible);

        setRouteTrainAppearance(
          homeArrivalRouteTrainColor,
          homeArrivalLineColor,
          homeArrivalLineCode,
        );

        homeArrivalTrain.dataset.routeVisible = String(isRouteActive);
        homeArrivalTrainVisual.dataset.routeVisible = String(isRoutePrepared);
        homeArrivalTrain.disabled = !isRouteActive;

        if (!isRouteActive) {
          setTrainTooltipOpen(false);
        }

        if (!isRoutePrepared) {
          homeArrivalTrain.dataset.routeSegment = "off";
          return;
        }

        const progress = clampRouteProgress(rawProgress);
        if (rawProgress < 0) {
          // 候车列车直接取可见横轨的实时中心线，随线路从视口边缘一起进入而不会悬浮在首屏上。
          const readyCenterY = horizontalBounds.top + horizontalBounds.height / 2;
          // 从横向线段的右侧终点候车；路径向左书写，因此车体右缘会与终点严格贴齐。
          const readyPathStartX = window.innerWidth;
          homeArrivalTrainVisualPath.setAttribute(
            "d",
            `M${readyPathStartX} ${readyCenterY} H${readyPathStartX - trainWidth}`,
          );
          renderTrainOnCurrentPath(trainWidth, 0, trainWidth, trainHeight);
          homeArrivalTrain.dataset.routeSegment = "ready";
          return;
        }

        if (isTransferBreakerPhase) {
          if (desktopRouteGalleryQuery.matches) {
            if (window.scrollY < transferBreakerTop - transferPlatformEpsilon) {
              const pathState = prepareTransferIncomingTrainPath(trainWidth, trainHeight);
              const trainTailDistance = interpolateRoutePosition(
                0,
                pathState.maxTrainTailDistance,
                clampRouteProgress(transferBreakerRevealProgress),
              );

              homeTransferBreakerRoute.dataset.activeTrain = "approaching";
              renderTransferIncomingTrain(
                pathState,
                trainTailDistance,
                trainWidth,
                trainHeight,
              );
            } else {
              const handoffProgress = clampRouteProgress(
                (window.scrollY - transferBreakerTop) /
                  Math.max(1, homeTransferBreakerScrollDistance),
              );

              renderTransferHandoff(handoffProgress);
            }
          } else {
            const leftTrackBounds = homeTransferLeftTrack.getBoundingClientRect();
            const trackX = leftTrackBounds.left + leftTrackBounds.width / 2;
            const trainCenterY = getRouteBottomTrainCenterY(trainHeight);
            const trackProgress = clampRouteProgress(
              (trainCenterY - leftTrackBounds.top) / Math.max(1, leftTrackBounds.height),
            );
            const colorProgress = getHomeTrainColorTransitionProgress({
              routeProgress: trackProgress,
              transitionStart: 0.46,
              transitionEnd: 0.54,
            });

            setTransferTrainAppearance(colorProgress);
            renderViewportVerticalTrain(
              trackX,
              trainCenterY,
              trainWidth,
              trainHeight,
              colorProgress <= 0
                ? "transfer-mobile-incoming"
                : colorProgress >= 1
                  ? "transfer-mobile-outgoing"
                  : "transfer-mobile-gradient",
            );
          }
          return;
        }

        if (isTriServerPhase) {
          renderTriServerTrain(trainWidth, trainHeight);
          return;
        }

        if (isSectionBreakerHandoffPhase) {
          renderSectionBreakerHandoffTrain(
            sectionBreakerHandoffProgress,
            trainWidth,
            trainHeight,
          );
          return;
        }

        if (isSectionBreakerPhase) {
          if (desktopRouteGalleryQuery.matches) {
            const pathState = prepareSectionBreakerTrainPath(trainWidth, trainHeight);
            const pinnedProgress = clampRouteProgress(
              (window.scrollY - sectionBreakerTop) /
                Math.max(1, homeSectionBreakerScrollDistance),
            );
            const trainTailDistance =
              window.scrollY < sectionBreakerTop
                ? interpolateRoutePosition(
                    0,
                    pathState.curveEntryTailDistance,
                    clampRouteProgress(sectionBreakerRevealProgress),
                  )
                : interpolateRoutePosition(
                    pathState.curveEntryTailDistance,
                    pathState.maxTrainTailDistance,
                    pinnedProgress,
                  );

            renderSectionBreakerTrain(
              pathState,
              trainTailDistance,
              trainWidth,
              trainHeight,
            );
          } else {
            const mobileProgress = clampRouteProgress(sectionBreakerProgress);
            const leftTrackBounds = homeSectionBreakerLeftTrack.getBoundingClientRect();
            const trackX = leftTrackBounds.left + leftTrackBounds.width / 2;
            const trainCenterY = interpolateRoutePosition(
              getGalleryTrainCenterRange(trainHeight).endCenterY,
              getTriServerEntryTrainCenterY(trainWidth, trainHeight),
              mobileProgress,
            );

            renderViewportVerticalTrain(
              trackX,
              trainCenterY,
              trainWidth,
              trainHeight,
              "breaker-left",
            );
          }
          return;
        }

        const verticalBounds = homeArrivalVertical.getBoundingClientRect();
        const bendBounds = homeArrivalBend.getBoundingClientRect();
        const introductionTrackBounds = homeIntroductionTrack.getBoundingClientRect();
        const bendPath = homeArrivalBend.querySelector<SVGPathElement>("path");

        if (!bendPath) {
          return;
        }

        const horizontalY = horizontalBounds.top + horizontalBounds.height / 2;
        const curveStartX = bendBounds.right;
        const curveStartY = bendBounds.top + bendBounds.height * (31 / 250);
        const curveEndX = bendBounds.left + bendBounds.width * (31 / 249);
        const curveEndY = bendBounds.bottom;
        const verticalEndX = verticalBounds.left + verticalBounds.width / 2;
        const verticalEndY = verticalBounds.bottom;
        const introductionEndX = introductionTrackBounds.left + introductionTrackBounds.width / 2;
        const introductionEndY = introductionTrackBounds.bottom;
        // 从横向轨道右端驶入；path 从右向左书写，0% 时浅蓝列车的右缘正好贴齐终点。
        const pathStartX = horizontalBounds.right;
        const pathStartY = horizontalY;
        const pathData = [
          `M${pathStartX} ${pathStartY}`,
          `L${curveStartX} ${curveStartY}`,
          `C${bendBounds.left + bendBounds.width * (86 / 249)} ${curveStartY} ${curveEndX} ${
            bendBounds.top + bendBounds.height * (109.5 / 250)
          } ${curveEndX} ${curveEndY}`,
          `L${verticalEndX} ${verticalEndY}`,
          `L${introductionEndX} ${introductionEndY}`,
        ].join(" ");
        homeArrivalTrainVisualPath.setAttribute("d", pathData);
        homeArrivalTrainVisualPath.setAttribute("stroke-width", String(trainHeight));

        const horizontalLength = Math.hypot(curveStartX - pathStartX, curveStartY - pathStartY);
        const curveLength = bendPath.getTotalLength() * (bendBounds.width / 249);
        const verticalLength = Math.hypot(verticalEndX - curveEndX, verticalEndY - curveEndY);
        const introductionLength = Math.hypot(
          introductionEndX - verticalEndX,
          introductionEndY - verticalEndY,
        );
        const journeyLength = horizontalLength + curveLength + verticalLength + introductionLength;
        const horizontalTrainEntryLength = Math.max(0, horizontalLength - trainWidth);
        let trainTailDistance: number;

        if (progress < 0.15) {
          homeArrivalTrain.dataset.routeSegment = "horizontal";
          const segmentProgress = progress / 0.15;
          trainTailDistance = interpolateRoutePosition(0, horizontalTrainEntryLength, segmentProgress);
        } else if (progress < curveEndProgress) {
          homeArrivalTrain.dataset.routeSegment = "curve";
          const segmentProgress = (progress - 0.15) / (curveEndProgress - 0.15);
          trainTailDistance = horizontalTrainEntryLength + curveLength * segmentProgress;
        } else if (progress < introductionTrackStartProgress) {
          homeArrivalTrain.dataset.routeSegment = "vertical";
          const segmentProgress =
            (progress - curveEndProgress) / (introductionTrackStartProgress - curveEndProgress);
          trainTailDistance = horizontalTrainEntryLength + curveLength + verticalLength * segmentProgress;
        } else {
          homeArrivalTrain.dataset.routeSegment = "introduction";
          const introductionTrackStartScrollY =
            arrivalTop +
            arrivalJourneyLength * (introductionTrackStartProgress / introductionStartRouteProgress);
          const homeGalleryTop = getDocumentTop(homeGalleryRoute);
          const homeGalleryScrollRange = Math.max(1, homeGalleryRoute.offsetHeight - window.innerHeight);
          const homeGalleryProgress = clampRouteProgress(
            (window.scrollY - homeGalleryTop) / homeGalleryScrollRange,
          );
          /**
           * 列车从首图顶边开始并随 Gallery 的同一 0→1 进度走到图底；
           * 桌面读取 sticky 视口位置，小屏读取文档坐标，起点都必须避开紧凑 Header。
           */
          const { startCenterY: galleryTrainStartCenterY, endCenterY: galleryTrainEndCenterY } =
            getGalleryTrainCenterRange(trainHeight);
          const galleryTrainCenterY =
            window.scrollY < homeGalleryTop
              ? galleryTrainStartCenterY + homeGalleryTop - window.scrollY
              : interpolateRoutePosition(
                  galleryTrainStartCenterY,
                  galleryTrainEndCenterY,
                  homeGalleryProgress,
                );
          const introductionTargetCenterY = galleryTrainCenterY;
          const introductionTailDistanceBeforeStart = interpolateRoutePosition(
            0,
            introductionTargetCenterY + trainWidth / 2,
            clampRouteProgress(
              (window.scrollY - introductionTrackStartScrollY) /
                Math.max(1, introductionTop - introductionTrackStartScrollY),
            ),
          );
          const introductionTailDistance =
            window.scrollY < introductionTop
              ? introductionTailDistanceBeforeStart
              : window.scrollY - introductionTop + introductionTargetCenterY + trainWidth / 2;
          trainTailDistance =
            horizontalTrainEntryLength +
            curveLength +
            verticalLength +
            Math.min(Math.max(0, introductionTailDistance), introductionLength);
        }

        renderTrainOnCurrentPath(journeyLength, trainTailDistance, trainWidth, trainHeight);

        if (!isRouteActive) {
          homeArrivalTrain.dataset.routeSegment = "ready";
        }
      };

      /** scroll 事件本身已与浏览器绘制对齐；同一回调内更新列车，避免 overlay 再迟一帧追赶轨道。 */
      const requestRouteTrainUpdate = () => {
        updateRouteTrain();
      };

      /** 让鼠标、键盘与触屏共用同一个章节快选窗状态，视觉与辅助技术不会在一次点击后分叉。 */
      let isTrainTooltipPinned = false;
      let isTrainTooltipNavigationSuppressed = false;
      let isTrainTooltipFocusRestoreSuppressed = false;
      let trainTooltipNavigationReleaseTimer = 0;
      /** 选择同岸的具体服务列车，并让 Tooltip 线路色、锚点与可观测轨段保持一致。 */
      const activateTrainTooltipTrigger = (trigger: HTMLButtonElement) => {
        activeTrainTooltipTrigger = trigger;

        if (trigger === homeTransferIncomingTrain) {
          homeTransferBreakerRoute.dataset.activeTrain = "incoming";
          setTransferTrainAppearance(0);
          homeArrivalTrain.dataset.routeSegment = "transfer-incoming-platform";
        } else if (trigger === homeTransferOutgoingTrain) {
          homeTransferBreakerRoute.dataset.activeTrain = "outgoing";
          setTransferTrainAppearance(1);
          homeArrivalTrain.dataset.routeSegment = "transfer-outgoing-platform";
        }

        if (homeArrivalTrain.dataset.tooltipOpen === "true") {
          trainTooltipTriggers.forEach((candidate) => {
            const isActiveTrigger = candidate === trigger;

            if (candidate !== homeArrivalTrain) {
              candidate.dataset.tooltipOpen = String(isActiveTrigger);
            }
            candidate.setAttribute("aria-expanded", String(isActiveTrigger));
          });
        }

        updateTrainTooltipPlacement();
      };
      const setTrainTooltipOpen = (isOpen: boolean) => {
        if (isOpen && isTrainTooltipNavigationSuppressed) {
          return;
        }

        if (!isOpen) {
          isTrainTooltipPinned = false;
        }

        homeArrivalTrain.dataset.tooltipOpen = String(isOpen);
        homeArrivalTrain.dataset.tooltipMode = isOpen
          ? isTrainTooltipPinned
            ? "pinned"
            : "preview"
          : "closed";
        trainTooltipTriggers.forEach((trigger) => {
          const isActiveOpenTrigger = isOpen && trigger === activeTrainTooltipTrigger;

          if (trigger !== homeArrivalTrain) {
            trigger.dataset.tooltipOpen = String(isActiveOpenTrigger);
          }
          trigger.setAttribute("aria-expanded", String(isActiveOpenTrigger));
        });
        homeArrivalTrainTooltip.setAttribute("aria-hidden", String(!isOpen));

        if (isOpen) {
          window.requestAnimationFrame(updateTrainTooltipPlacement);
        }
      };
      /**
       * 快选触发平滑滚动后，列车可能从静止指针下经过并产生新的 pointerenter。
       * 在章节滚动完成前禁止这种被动重开；计时结束不会主动打开，用户需重新进入列车才会再次看到 Tooltip。
       */
      const suppressTrainTooltipDuringJourneyJump = () => {
        isTrainTooltipNavigationSuppressed = true;
        window.clearTimeout(trainTooltipNavigationReleaseTimer);
        trainTooltipNavigationReleaseTimer = window.setTimeout(
          () => {
            isTrainTooltipNavigationSuppressed = false;
            trainTooltipNavigationReleaseTimer = 0;
          },
          reducedMotionQuery.matches ? 0 : 1500,
        );
      };
      /** 同步路线图的章节高亮与上半部当前站名，滚动和点击不会显示两套位置状态。 */
      const setActiveJourneySection = (sectionId: string) => {
        const journeyLinks = Array.from(
          homeJourneyPicker.querySelectorAll<HTMLAnchorElement>("[data-home-journey-target]"),
        );
        const currentLink = journeyLinks.find((link) => link.dataset.homeJourneySectionId === sectionId);

        if (!currentLink) {
          return;
        }

        const currentStop = currentLink.closest<HTMLElement>("[data-home-journey-stop]");
        const currentLineColor = currentStop?.dataset.homeJourneyLineColor;

        if (currentLineColor) {
          homeJourneyPicker.style.setProperty("--home-journey-current-line-color", currentLineColor);
        }

        journeyLinks.forEach((link) => {
          const isCurrent = link === currentLink;
          const stop = link.closest<HTMLElement>("[data-home-journey-stop]");

          if (isCurrent) {
            link.setAttribute("aria-current", "step");
          } else {
            link.removeAttribute("aria-current");
          }

          stop?.classList.toggle("home-journey-quick-pick__stop--current", isCurrent);
        });

        const currentName = homeJourneyPicker.querySelector<HTMLElement>("[data-home-journey-current-name]");
        const sectionName = currentLink.dataset.homeJourneySectionName;

        if (currentName && sectionName) {
          currentName.textContent = sectionName;
        }

        window.requestAnimationFrame(updateTrainTooltipPlacement);
      };
      /** 判断焦点或指针是否已进入可交互路线图，避免从列车移入快选窗时意外关闭。 */
      const isInsideTrainDialog = (target: EventTarget | null) =>
        target instanceof Node && homeArrivalTrainTooltip.contains(target);
      /** 悬停先确认短暂意图，避免列车从静止指针下经过时让面板闪现。 */
      const trainTooltipHoverOpenDelay = 140;
      /** 列车与快选窗之间保留短距离移动缓冲，同时让未固定的预览及时收起。 */
      const trainTooltipHoverCloseDelay = 180;
      let pendingTrainTooltipOpen: number | undefined;
      let pendingTrainTooltipClose: number | undefined;
      const cancelTrainTooltipOpen = () => {
        if (pendingTrainTooltipOpen !== undefined) {
          window.clearTimeout(pendingTrainTooltipOpen);
          pendingTrainTooltipOpen = undefined;
        }
      };
      const cancelTrainTooltipClose = () => {
        if (pendingTrainTooltipClose !== undefined) {
          window.clearTimeout(pendingTrainTooltipClose);
          pendingTrainTooltipClose = undefined;
        }
      };
      const scheduleTrainTooltipOpen = () => {
        cancelTrainTooltipOpen();
        pendingTrainTooltipOpen = window.setTimeout(() => {
          setTrainTooltipOpen(true);
          pendingTrainTooltipOpen = undefined;
        }, trainTooltipHoverOpenDelay);
      };
      const scheduleTrainTooltipClose = () => {
        cancelTrainTooltipClose();
        pendingTrainTooltipClose = window.setTimeout(() => {
          setTrainTooltipOpen(false);
          pendingTrainTooltipClose = undefined;
        }, trainTooltipHoverCloseDelay);
      };
      /** 从面板关闭时恢复列车焦点，但跳过这一次 focus 自动预览，避免 Escape 或关闭按钮把面板重新打开。 */
      const closeTrainTooltipAndRestoreFocus = () => {
        cancelTrainTooltipOpen();
        cancelTrainTooltipClose();
        setTrainTooltipOpen(false);
        isTrainTooltipFocusRestoreSuppressed = true;
        activeTrainTooltipTrigger.focus();
        window.requestAnimationFrame(() => {
          isTrainTooltipFocusRestoreSuppressed = false;
        });
      };
      /** 细指针以悬停预览 Tooltip；粗指针则保留点击开关，避免触屏首点被 focus 事件反向关闭。 */
      const fineHoverQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
      let pendingTouchTooltipOpen: boolean | undefined;
      let pendingTrainTooltipTriggerSwitch = false;

      trainTooltipTriggers.forEach((trigger) => {
        trigger.addEventListener("pointerenter", () => {
          if (fineHoverQuery.matches) {
            activateTrainTooltipTrigger(trigger);
            cancelTrainTooltipClose();
            if (!isTrainTooltipPinned && homeArrivalTrain.dataset.tooltipOpen !== "true") {
              scheduleTrainTooltipOpen();
            }
          }
        });
        trigger.addEventListener("pointerleave", () => {
          if (fineHoverQuery.matches && !isTrainTooltipPinned) {
            cancelTrainTooltipOpen();
            scheduleTrainTooltipClose();
          }
        });
        trigger.addEventListener("focus", () => {
          activateTrainTooltipTrigger(trigger);
          cancelTrainTooltipOpen();
          cancelTrainTooltipClose();
          if (isTrainTooltipFocusRestoreSuppressed) {
            isTrainTooltipFocusRestoreSuppressed = false;
            return;
          }
          setTrainTooltipOpen(true);
        });
        trigger.addEventListener("blur", (event) => {
          if (!isInsideTrainDialog(event.relatedTarget)) {
            setTrainTooltipOpen(false);
          }
        });
        trigger.addEventListener("pointerdown", (event) => {
          pendingTrainTooltipTriggerSwitch =
            homeArrivalTrain.dataset.tooltipOpen === "true" &&
            activeTrainTooltipTrigger !== trigger;
          activateTrainTooltipTrigger(trigger);
          pendingTouchTooltipOpen =
            event.pointerType === "touch" ? homeArrivalTrain.dataset.tooltipOpen !== "true" : undefined;
        });
        trigger.addEventListener("click", () => {
          activateTrainTooltipTrigger(trigger);
          cancelTrainTooltipOpen();
          cancelTrainTooltipClose();
          if (pendingTrainTooltipTriggerSwitch) {
            isTrainTooltipPinned = true;
            setTrainTooltipOpen(true);
            pendingTrainTooltipTriggerSwitch = false;
            pendingTouchTooltipOpen = undefined;
            return;
          }
          if (pendingTouchTooltipOpen !== undefined) {
            isTrainTooltipPinned = pendingTouchTooltipOpen;
            setTrainTooltipOpen(pendingTouchTooltipOpen);
            pendingTouchTooltipOpen = undefined;
            return;
          }

          const shouldOpen = !isTrainTooltipPinned;
          isTrainTooltipPinned = shouldOpen;
          setTrainTooltipOpen(shouldOpen);
        });
        trigger.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            event.preventDefault();
            setTrainTooltipOpen(false);
          }
        });
      });
      homeArrivalTrainTooltip.addEventListener("pointerenter", () => {
        if (fineHoverQuery.matches) {
          cancelTrainTooltipOpen();
          cancelTrainTooltipClose();
        }
      });
      homeArrivalTrainTooltip.addEventListener("pointerleave", () => {
        if (fineHoverQuery.matches && !isTrainTooltipPinned) {
          scheduleTrainTooltipClose();
        }
      });
      homeArrivalTrainTooltip.addEventListener("focusin", () => {
        cancelTrainTooltipClose();
        setTrainTooltipOpen(true);
      });
      homeArrivalTrainTooltip.addEventListener("focusout", (event) => {
        if (!isTrainTooltipTrigger(event.relatedTarget) && !isInsideTrainDialog(event.relatedTarget)) {
          setTrainTooltipOpen(false);
        }
      });
      homeArrivalTrainTooltip.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          event.stopPropagation();
          closeTrainTooltipAndRestoreFocus();
        }
      });
      homeJourneyClose.addEventListener("click", closeTrainTooltipAndRestoreFocus);

      /**
       * 只允许下半路线图消费纵向滚轮；到达边界或指针停在本站栏时阻断滚动链，避免文档被带离当前列车。
       * 缩放手势继续交给浏览器，不能为了滚动隔离而禁用用户的页面缩放。
       */
      const containTrainTooltipWheel = (event: WheelEvent) => {
        if (event.ctrlKey) {
          return;
        }

        const isInsideJourneyMap = event.target instanceof Node && homeJourneyMap.contains(event.target);

        if (!isInsideJourneyMap) {
          event.preventDefault();
          return;
        }

        const isAtStart = homeJourneyMap.scrollTop <= 0;
        const isAtEnd =
          homeJourneyMap.scrollTop + homeJourneyMap.clientHeight >= homeJourneyMap.scrollHeight - 1;

        if ((event.deltaY < 0 && isAtStart) || (event.deltaY > 0 && isAtEnd)) {
          event.preventDefault();
        }
      };

      homeArrivalTrainTooltip.addEventListener("wheel", containTrainTooltipWheel, { passive: false });

      document.addEventListener("pointerdown", (event) => {
        if (
          event.target instanceof Node &&
          !isTrainTooltipTrigger(event.target) &&
          !homeArrivalTrainTooltip.contains(event.target)
        ) {
          cancelTrainTooltipOpen();
          cancelTrainTooltipClose();
          setTrainTooltipOpen(false);
        }
      });

      homeJourneyPicker.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) {
          return;
        }

        const journeyLink = event.target.closest<HTMLAnchorElement>("[data-home-journey-target]");

        if (!journeyLink || !homeJourneyPicker.contains(journeyLink)) {
          return;
        }

        const targetId = journeyLink.dataset.homeJourneyTargetId;
        const sectionId = journeyLink.dataset.homeJourneySectionId;
        const targetSection = targetId ? document.getElementById(targetId) : null;

        if (!targetId || !sectionId || !targetSection) {
          return;
        }

        event.preventDefault();
        cancelTrainTooltipOpen();
        cancelTrainTooltipClose();
        suppressTrainTooltipDuringJourneyJump();
        setActiveJourneySection(sectionId);
        /** 先让新站牌的线路色完整展开，再开始章节滚动，保留一次可感知的选择反馈。 */
        window.setTimeout(
          () => {
            setTrainTooltipOpen(false);
            targetSection.focus({ preventScroll: true });
            targetSection.scrollIntoView({
              behavior: reducedMotionQuery.matches ? "auto" : "smooth",
              block: "start",
            });
            window.history.pushState(null, "", `#${targetId}`);
          },
          reducedMotionQuery.matches ? 0 : 260,
        );
      });

      const journeyTargets = Array.from(
        homeJourneyPicker.querySelectorAll<HTMLAnchorElement>("[data-home-journey-target]"),
      )
        .map((link) => {
          const targetId = link.dataset.homeJourneyTargetId;
          const sectionId = link.dataset.homeJourneySectionId;
          const target = targetId ? document.getElementById(targetId) : null;

          return target && sectionId ? { sectionId, target } : null;
        })
        .filter((target): target is { sectionId: string; target: HTMLElement } => target !== null);

      /** 以视口中线作为统一阅读进度；新 section 越过 50% 后，Tooltip 才同步切换当前站。 */
      const updateActiveJourneySectionFromScroll = () => {
        const readingLineDocumentY = window.scrollY + window.innerHeight / 2;
        const activeJourneyTarget = journeyTargets.reduce(
          (activeTarget, candidateTarget) =>
            getDocumentTop(candidateTarget.target) <= readingLineDocumentY
              ? candidateTarget
              : activeTarget,
          journeyTargets[0],
        );

        if (activeJourneyTarget) {
          setActiveJourneySection(activeJourneyTarget.sectionId);
        }
      };

      updateActiveJourneySectionFromScroll();

      /** 快选窗会随语言、字号和窄屏换行改变高度；尺寸变化后重新选取可完整容纳它的方向。 */
      const tooltipPlacementObserver = new ResizeObserver(updateTrainTooltipPlacement);
      tooltipPlacementObserver.observe(homeArrivalTrainTooltip);

      window.addEventListener(
        "scroll",
        () => {
          cancelTrainTooltipOpen();
          cancelTrainTooltipClose();
          if (
            !isTrainTooltipPinned &&
            !isTrainTooltipTrigger(document.activeElement) &&
            !isInsideTrainDialog(document.activeElement)
          ) {
            setTrainTooltipOpen(false);
          }
          requestRouteTrainUpdate();
          updateActiveJourneySectionFromScroll();
        },
        { passive: true },
      );
      window.addEventListener("resize", () => {
        measureHomeSectionBreakerScrollDistance();
        measureHomeTransferBreakerScrollDistance();
        requestRouteTrainUpdate();
        updateActiveJourneySectionFromScroll();
        updateTrainTooltipPlacement();
      });
      /** 响应式模式或动态偏好切换后，先重算 Section 行程再绘制列车，避免沿用旧 viewport 的速度。 */
      const refreshSectionBreakerRoute = () => {
        measureHomeSectionBreakerScrollDistance();
        measureHomeTransferBreakerScrollDistance();
        requestRouteTrainUpdate();
      };
      reducedMotionQuery.addEventListener("change", refreshSectionBreakerRoute);
      desktopRouteGalleryQuery.addEventListener("change", refreshSectionBreakerRoute);
      measureHomeSectionBreakerScrollDistance();
      measureHomeTransferBreakerScrollDistance();
      requestRouteTrainUpdate();
    }
  </script>

  <section
    class="home-introduction"
    data-home-introduction-route
    aria-labelledby="home-introduction-title"
    style={`--home-introduction-line-color: var(${homeLineCssVariable});`}
  >
    <span class="home-introduction__track" data-home-introduction-track aria-hidden="true"></span>
    <div class="home-introduction__opening">
      <span class="home-introduction__branch" aria-hidden="true"></span>
      <div class="home-introduction__copy">
        <h2 id="home-introduction-title">{messages.home.introduction.title}</h2>
        <p>{messages.home.introduction.description}</p>
      </div>
    </div>
    <div
      class="home-gallery"
      data-home-gallery
      role="region"
      aria-label={messages.home.gallery.label}
    >
      <div class="home-gallery__stage" data-home-gallery-stage>
        <ol class="home-gallery__track" data-home-gallery-track>
          {
            gallerySceneImages.map((scene, index) => (
              <li
                class="home-gallery__item"
                data-home-gallery-item
                data-home-gallery-caption-visible={index === 0 ? "true" : undefined}
              >
                <figure class="home-gallery__figure">
                  <picture class="home-gallery__picture">
                    <source
                      srcset={scene.avifSrcset}
                      sizes="(max-width: 1023px) 70vw, 71.46vw"
                      type="image/avif"
                    />
                    <img
                      src={scene.webpSrc}
                      srcset={scene.webpSrcset}
                      sizes="(max-width: 1023px) 70vw, 71.46vw"
                      width={scene.width}
                      height={scene.height}
                      alt={scene.alt}
                      loading="lazy"
                      decoding="async"
                      style={`object-position: ${scene.focalPoint};`}
                    />
                  </picture>
                  <figcaption class="home-gallery__caption">
                    <span class="home-gallery__kicker">{scene.kicker}</span>
                    <span class="home-gallery__title">{scene.title}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <script>
    const homeGallery = document.querySelector<HTMLElement>("[data-home-gallery]");
    const homeGalleryStage = document.querySelector<HTMLElement>("[data-home-gallery-stage]");
    const homeGalleryTrack = document.querySelector<HTMLElement>("[data-home-gallery-track]");
    const homeGalleryItems = Array.from(
      document.querySelectorAll<HTMLElement>("[data-home-gallery-item]"),
    );

    if (homeGallery && homeGalleryStage && homeGalleryTrack && homeGalleryItems.length > 0) {
      /** Gallery 只在桌面映射横向轨道；小屏保留单一纵向阅读轴。 */
      const reducedGalleryMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const desktopGalleryQuery = window.matchMedia("(min-width: 1024px)");
      let homeGalleryScrollDistance = 0;
      /** 横轴输入静默后恢复全站 smooth；连续 wheel 期间只允许一份计时器拥有清理权。 */
      let horizontalInputReleaseTimer: number | undefined;

      /** 将滚动进度限制在首尾图片之间，避免浏览器弹性滚动把图片带出轨道。 */
      const clampHomeGalleryProgress = (value: number) => Math.min(Math.max(value, 0), 1);
      /** 获取 Gallery 在文档中的稳定起点，避免 sticky 后的 viewport 坐标参与进度计算。 */
      const getHomeGalleryDocumentTop = () => homeGallery.getBoundingClientRect().top + window.scrollY;

      /** 非受控模式按当前阅读轴取得图片中心；小屏比较纵向位置，桌面回退列表比较横向位置。 */
      const getHomeGalleryItemCenter = (item: HTMLElement) => {
        const figure = item.querySelector<HTMLElement>(".home-gallery__figure");
        const bounds = (figure ?? item).getBoundingClientRect();

        return desktopGalleryQuery.matches
          ? bounds.left + bounds.width / 2
          : bounds.top + bounds.height / 2;
      };

      /** 只标记当前焦点图片；桌面直接由等距进度取索引，小屏按视口纵向中心选择。 */
      const updateHomeGalleryActiveItem = (controlledProgress?: number) => {
        const activeItem =
          controlledProgress === undefined
            ? homeGalleryItems.reduce((closestItem, item) => {
                const viewportCenter = desktopGalleryQuery.matches
                  ? window.innerWidth / 2
                  : window.innerHeight / 2;
                const itemDistance = Math.abs(getHomeGalleryItemCenter(item) - viewportCenter);
                const closestDistance = Math.abs(getHomeGalleryItemCenter(closestItem) - viewportCenter);

                return itemDistance < closestDistance ? item : closestItem;
              })
            : homeGalleryItems[
                Math.min(
                  homeGalleryItems.length - 1,
                  Math.round(controlledProgress * (homeGalleryItems.length - 1)),
                )
              ];

        homeGalleryItems.forEach((item) => {
          if (item === activeItem) {
            item.dataset.homeGalleryCaptionVisible = "true";
          } else {
            delete item.dataset.homeGalleryCaptionVisible;
          }
        });
      };

      /** 把当前纵向阅读距离同步映射为水平位移，并公开 pinned 状态给 Header 保持稳定。 */
      const updateHomeGalleryProgress = () => {
        if (homeGallery.dataset.homeGalleryEnhanced !== "true") {
          document.documentElement.removeAttribute("data-home-gallery-pinned");
          updateHomeGalleryActiveItem();
          return;
        }

        const scrollRange = Math.max(1, homeGallery.offsetHeight - window.innerHeight);
        const galleryTop = getHomeGalleryDocumentTop();
        const progress = clampHomeGalleryProgress(
          (window.scrollY - galleryTop) / scrollRange,
        );
        const galleryBounds = homeGallery.getBoundingClientRect();
        const stageBounds = homeGalleryStage.getBoundingClientRect();
        const isGalleryPinned =
          Math.abs(stageBounds.top) <= 1 &&
          galleryBounds.top <= 0 &&
          galleryBounds.bottom >= window.innerHeight;

        document.documentElement.toggleAttribute("data-home-gallery-pinned", isGalleryPinned);
        homeGallery.style.setProperty(
          "--home-gallery-offset",
          `${-homeGalleryScrollDistance * progress}px`,
        );
        updateHomeGalleryActiveItem(progress);
      };

      /**
       * 以真实轨道宽度决定 Gallery 需要的纵向行程。
       * 无脚本或减少动态时不启用增强状态，桌面保留横向列表，小屏继续使用纵向列表。
       */
      const measureHomeGallery = () => {
        homeGalleryScrollDistance = Math.max(0, homeGalleryTrack.scrollWidth - homeGalleryStage.clientWidth);
        const shouldEnhance =
          desktopGalleryQuery.matches &&
          !reducedGalleryMotionQuery.matches &&
          homeGalleryScrollDistance > 0;

        homeGallery.style.setProperty(
          "--home-gallery-scroll-distance",
          `${homeGalleryScrollDistance}px`,
        );
        homeGallery.dataset.homeGalleryEnhanced = String(shouldEnhance);
        homeGallery.dataset.homeGalleryCaptionReady = "true";

        if (shouldEnhance) {
          // 从减少动态切回受控模式时清除用户先前的原生横向位置，避免 scrollLeft 与 transform 叠加。
          homeGalleryStage.scrollLeft = 0;
        } else {
          homeGallery.style.setProperty("--home-gallery-offset", "0px");
        }

        updateHomeGalleryProgress();
      };

      /**
       * Gallery 固定时只接管明确以横轴为主的触控板输入。
       * 直接写入滚动根节点可绕过全局 smooth 行为；纵轴主导的手势仍完整交给浏览器。
       */
      const applyHomeGalleryHorizontalProgress = (event: WheelEvent) => {
        if (
          event.ctrlKey ||
          reducedGalleryMotionQuery.matches ||
          homeGallery.dataset.homeGalleryEnhanced !== "true" ||
          Math.abs(event.deltaX) <= Math.max(0.5, Math.abs(event.deltaY))
        ) {
          return;
        }

        const galleryBounds = homeGallery.getBoundingClientRect();
        const stageBounds = homeGalleryStage.getBoundingClientRect();
        const isGalleryPinned =
          Math.abs(stageBounds.top) <= 1 &&
          galleryBounds.top <= 0 &&
          galleryBounds.bottom >= window.innerHeight;

        if (!isGalleryPinned) {
          return;
        }

        const deltaScale = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? window.innerHeight : 1;
        const scrollingElement = document.scrollingElement;

        if (!scrollingElement) {
          return;
        }

        const galleryTop = getHomeGalleryDocumentTop();
        const galleryEnd = galleryTop + Math.max(1, homeGallery.offsetHeight - window.innerHeight);
        const nextScrollTop = Math.min(
          galleryEnd,
          Math.max(galleryTop, scrollingElement.scrollTop + event.deltaX * deltaScale),
        );

        event.preventDefault();
        document.documentElement.dataset.homeGalleryHorizontalInput = "true";
        window.clearTimeout(horizontalInputReleaseTimer);
        horizontalInputReleaseTimer = window.setTimeout(() => {
          horizontalInputReleaseTimer = undefined;
          document.documentElement.removeAttribute("data-home-gallery-horizontal-input");
        }, 80);
        scrollingElement.scrollTop = nextScrollTop;
        updateHomeGalleryProgress();
      };

      const homeGalleryResizeObserver = new ResizeObserver(measureHomeGallery);
      homeGalleryResizeObserver.observe(homeGalleryStage);
      homeGalleryResizeObserver.observe(homeGalleryTrack);

      window.addEventListener("scroll", updateHomeGalleryProgress, { passive: true });
      window.addEventListener("resize", measureHomeGallery);
      homeGalleryStage.addEventListener("scroll", updateHomeGalleryProgress, { passive: true });
      homeGalleryStage.addEventListener("wheel", applyHomeGalleryHorizontalProgress, {
        passive: false,
      });
      reducedGalleryMotionQuery.addEventListener("change", measureHomeGallery);
      desktopGalleryQuery.addEventListener("change", measureHomeGallery);
      window.addEventListener("pageshow", measureHomeGallery);
      window.addEventListener("pagehide", (event) => {
        document.documentElement.removeAttribute("data-home-gallery-pinned");
        document.documentElement.removeAttribute("data-home-gallery-horizontal-input");
        window.clearTimeout(horizontalInputReleaseTimer);

        if (!event.persisted) {
          homeGalleryResizeObserver.disconnect();
        }
      });

      measureHomeGallery();
    }
  </script>

  <HomeSectionBreaker
    id={triServerJointJourneySection.id}
    locale={locale}
    primaryName={triServerJointPrimaryName}
    secondaryName={triServerJointSecondaryName}
    lineColor={`var(${homeLineCssVariable})`}
    trainColor={homeTrainColor}
    lineCode={homeLine.code}
    sequence={triServerJointJourneySection.sequence}
    linePrimaryName={homeLinePrimaryName}
    lineSecondaryName={homeLineSecondaryName}
  />
  <HomeTriServerSection locale={locale} lineColor={`var(${homeLineCssVariable})`} />
  <HomeTransferSectionBreaker
    id={sharedShoreJourneySection.id}
    locale={locale}
    primaryName={sharedShorePrimaryName}
    secondaryName={sharedShoreSecondaryName}
    incomingLine={sharedShoreIncomingLine}
    incomingSequence={sharedShoreJourneySection.transferFrom.sequence}
    outgoingLine={sharedShoreOutgoingLine}
    outgoingSequence={sharedShoreJourneySection.sequence}
    incomingTrainColor={homeTrainColor}
    outgoingTrainColor={sharedShoreOutgoingTrainColor}
    trainTooltipTriggerLabel={messages.home.arrival.trainTooltip.triggerLabel}
  />
</BaseLayout>
