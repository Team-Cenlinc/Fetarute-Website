                    />
                    <img
                      src={scene.webpSrc}
                      srcset={scene.webpSrcset}
                      sizes="(max-width: 1023px) 70vw, 71.46vw"
                      width={scene.width}
                      height={scene.height}
                      alt={scene.alt}
                      loading="lazy"
                      decoding="async"
                      style={`object-position: ${scene.focalPoint};`}
                    />
                  </picture>
                  <figcaption class="home-gallery__caption">
                    <span class="home-gallery__kicker">{scene.kicker}</span>
                    <span class="home-gallery__title">{scene.title}</span>
                  </figcaption>
                </figure>
