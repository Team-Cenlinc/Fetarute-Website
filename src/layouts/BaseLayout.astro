---
import { Font } from "astro:assets";
import SiteHeader from "@/components/SiteHeader.astro";
import LaunchSequence from "@/components/LaunchSequence.astro";
import "@/styles/global.css";
import {
  getInterfacePaletteCssVariables,
  getRailwayLineCssVariableName,
  getRailwayLineCssVariables,
  getRailwayLineTextColor,
  interfacePalette,
} from "@/data/palette";
import { railwayLineByKey } from "@/data/railway";
import { siteInfo, wayfindingPrototype } from "@/data/site";
import { defaultLocale, localeMetadata, locales, type Locale } from "@/i18n/config";
import { getLocalizedAbsoluteUrl } from "@/i18n/links";
import { getMessages } from "@/i18n/messages";

/**
 * 基础页面布局属性。
 * 所有页面都通过这里统一设置 title 和 description，避免 metadata 分散维护。
 */
export interface Props {
  /** 当前静态页面所属的公开语言，驱动文案、字体和 SEO metadata。 */
  locale: Locale;
  /** 页面标题；未提供时使用服务器名称。 */
  title?: string;
  /** 页面专属描述；未提供时使用当前语言的站点描述。 */
  description?: string;
  /** 页面专属分享图片；未提供时使用站点级横向预览卡。 */
  image?: string;
  /** 首页启用的导视启动层；其他页面保持直接可读。 */
  showLaunchSequence?: boolean;
  /** 首页的首屏实景需要贴齐视口，其他页面继续保留标准内容边距。 */
  fullBleedMain?: boolean;
  /** 当前页面在语言根目录后的稳定路径；首页传空字符串，未来独立页传路由片段。 */
  pagePath?: string;
  /** 已发布当前逻辑页面的语言，用于精确生成 hreflang 而不声明尚未翻译的页面。 */
  availableLocales?: readonly Locale[];
}

const {
  locale,
  title = siteInfo.name,
  description,
  image = siteInfo.socialImage,
  showLaunchSequence = false,
  fullBleedMain = false,
  pagePath = "",
  availableLocales = locales,
} = Astro.props;
const messages = getMessages(locale);
const pageDescription = description ?? messages.description;
const pageTitle = title === siteInfo.name ? title : `${title} | ${siteInfo.name}`;
const canonicalUrl = getLocalizedAbsoluteUrl(locale, pagePath);
const socialImageUrl = new URL(image, siteInfo.url);
const brandImageUrl = new URL(siteInfo.brandImage, siteInfo.url);
const siteHomeUrl = new URL("/", siteInfo.url).toString();
// 首页的 x-default 交给语言推断入口；未来内容页仍回落到同一内容的默认语言版本，避免误指向首页。
const xDefaultUrl = pagePath.length === 0 ? siteHomeUrl : getLocalizedAbsoluteUrl(defaultLocale, pagePath);
const languageAlternates = availableLocales.map((alternateLocale) => ({
  locale: alternateLocale,
  href: getLocalizedAbsoluteUrl(alternateLocale, pagePath),
}));

/**
 * 仅在生产环境把启动序列的已播放状态写入当前 tab。
 * 开发服务器必须在每次刷新时重新播放，方便反复调整导视节奏，而部署站仍保持一次性启动体验。
 */
const shouldPersistLaunchSeen = import.meta.env.PROD;

/**
 * 首页指示器与首页标题共享同一条线路记录。
 * 启动动画改为从全网车站库随机取站，因此不能再把它误读为这条首页主视觉线路的站序。
 * 这里将复合线路身份转换为 CSS 变量引用，避免 global.css 固定某一条线路而与配置漂移。
 */
const wayfindingLine = railwayLineByKey.get(wayfindingPrototype.homeLineKey);

if (!wayfindingLine) {
  throw new Error(`布局引用了未录入的线路 ${wayfindingPrototype.homeLineKey}。`);
}

const wayfindingLineCssVariable = getRailwayLineCssVariableName(wayfindingLine);

/**
 * 在静态 HTML 的根节点写入界面中性色、线路色与当前首页线路语义别名。
 * 浅深色媒体条件只替换无彩基础材料，线路 token 始终来自铁路领域模型以保证导视色跨主题一致。
 */
const paletteCss = `
:root {
${getInterfacePaletteCssVariables(interfacePalette.light)}
${getRailwayLineCssVariables()}
/* 首页指示器消费当前主视觉线路的语义 token，实际颜色仍由 railway.ts 的线路变量提供。 */
--color-home-line: var(${wayfindingLineCssVariable});
/* 无脚本时选区回退到首页主视觉线路；运行时会在每次新的文字选择动作开始前替换这对 token。 */
--color-selection: var(${wayfindingLineCssVariable});
/* 选区文字前景按回退线路的亮度配对，避免深色线路与浅色线路在任一外观下失去可读性。 */
--color-selection-text: ${getRailwayLineTextColor(wayfindingLine.color)};
}

@media (prefers-color-scheme: dark) {
  :root:not([data-appearance]) {
${getInterfacePaletteCssVariables(interfacePalette.dark)}
  }
}

html[data-appearance="light"] {
${getInterfacePaletteCssVariables(interfacePalette.light)}
}

html[data-appearance="dark"] {
${getInterfacePaletteCssVariables(interfacePalette.dark)}
}
`;

/**
 * 搜索引擎和 AI 工具使用的站点与页面结构化数据。
 * WebSite 固定指向站点根而不是当前语言页面，WebPage 再描述当前 canonical，从而避免每个翻译页都被误报成不同的网站实体。
 */
const pageStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteHomeUrl}#organization`,
      name: siteInfo.name,
      url: siteHomeUrl,
      logo: {
        "@type": "ImageObject",
        url: brandImageUrl,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteHomeUrl}#website`,
      name: siteInfo.name,
      url: siteHomeUrl,
      description: messages.description,
      publisher: { "@id": `${siteHomeUrl}#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: localeMetadata[locale].languageTag,
      isPartOf: { "@id": `${siteHomeUrl}#website` },
      primaryImageOfPage: socialImageUrl,
    },
  ],
};
---

<!doctype html>
<html lang={localeMetadata[locale].languageTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={siteInfo.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={interfacePalette.light.canvas} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={interfacePalette.dark.canvas} media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalUrl} />
    {
      languageAlternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={localeMetadata[alternate.locale].languageTag}
          href={alternate.href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png"
      sizes="96x96"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-dark-96x96.png"
      sizes="96x96"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMetadata[locale].openGraphLocale} />
    {
      availableLocales
        .filter((alternateLocale) => alternateLocale !== locale)
        .map((alternateLocale) => (
          <meta
            property="og:locale:alternate"
            content={localeMetadata[alternateLocale].openGraphLocale}
          />
        ))
    }
    <meta property="og:site_name" content={siteInfo.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={messages.socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={messages.socialImageAlt} />

    <Font cssVariable="--font-fetarute-display" preload={[{ weight: "100 900", style: "normal" }]} />
    {
      locale === "zh-Hans" ? (
        <Font cssVariable="--font-fetarute-sans-sc" preload={[{ weight: "100 900", style: "normal" }]} />
      ) : (
        <Font cssVariable="--font-fetarute-sans-sc" />
      )
    }
    {
      locale === "zh-Hant" ? (
        <Font cssVariable="--font-fetarute-sans-tc" preload={[{ weight: "100 900", style: "normal" }]} />
      ) : (
        <Font cssVariable="--font-fetarute-sans-tc" />
      )
    }
    <Font cssVariable="--font-fetarute-sans-jp" />
    <Font cssVariable="--font-fetarute-display-italic" />
    <style is:global set:html={paletteCss}></style>
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        // 在首帧读取用户已选外观，避免服务台的手动设置先以系统主题闪现一次。
        const appearanceStorageKey = "fetarute.appearance";

        try {
          const storedAppearance = window.localStorage.getItem(appearanceStorageKey);

          if (storedAppearance === "light" || storedAppearance === "dark") {
            document.documentElement.dataset.appearance = storedAppearance;
          }
        } catch {
          // 隐私模式或被禁用的存储不影响系统主题的默认可用性。
        }
      })();
    </script>
    {
      showLaunchSequence && (
        <script is:inline define:vars={{ shouldPersistLaunchSeen }}>
          (() => {
            // 生产环境中此标记只在当前 tab 会话内生效；开发环境不读写它，确保刷新即可重看动画。
            const launchSessionKey = "fetarute.launch.seen";
            // 动态偏好不依赖存储：用户要求减弱动态时，首屏必须立即可用且不短暂挂出启动层。
            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // 深链的目的地优先于开场仪式；先跳过启动层，避免初始 hash 在正文布局尚未稳定时被重置到首屏。
            if (window.location.hash.length > 1) {
              document.documentElement.dataset.launchSkipped = "true";
              return;
            }

            if (prefersReducedMotion) {
              document.documentElement.dataset.launchSkipped = "true";
              return;
            }

            try {
              if (!shouldPersistLaunchSeen) {
                // 清除之前在生产预览或旧开发页面留下的状态，避免它干扰本地调试。
                window.sessionStorage.removeItem(launchSessionKey);
              }

              const hasSeenLaunch =
                shouldPersistLaunchSeen && window.sessionStorage.getItem(launchSessionKey) === "true";

              if (hasSeenLaunch) {
                document.documentElement.dataset.launchSkipped = "true";
                if (shouldPersistLaunchSeen) {
                  window.sessionStorage.setItem(launchSessionKey, "true");
                }
              } else {
                if (shouldPersistLaunchSeen) {
                  window.sessionStorage.setItem(launchSessionKey, "true");
                }
                document.documentElement.dataset.launching = "true";
              }
            } catch {
              // 无法访问会话存储时优先保留可用的启动体验，不让存储策略阻断首页内容。
              document.documentElement.dataset.launching = "true";
            }
          })();
        </script>
      )
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(pageStructuredData)}
    ></script>
  </head>
  <body>
    {showLaunchSequence && <LaunchSequence locale={locale} />}
    <SiteHeader locale={locale} />
    <!-- 首页叙事遮罩在 main 之外接收焦点；这样它锁定正文时仍能作为独立的可操作层淡出到第一站。 -->
    <slot name="overlay" />
    <main class:list={{ "main--full-bleed": fullBleedMain }}>
      <slot />
    </main>
    <script>
      import { setupImageDragGuard } from "@/lib/image-drag-guard";
      import { setupSelectionLineController } from "@/lib/selection-line-controller";

      setupImageDragGuard();
      setupSelectionLineController();
    </script>
  </body>
</html>
