{
  "name": "fetarute-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "sync": "ASTRO_TELEMETRY_DISABLED=1 astro sync",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "NODE_OPTIONS=--experimental-strip-types prettier --write .",
    "format:check": "NODE_OPTIONS=--experimental-strip-types prettier --check .",
    "font:extract": "NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/extract-cjk.ts",
    "font:subset:sc": "NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/build-subsets.ts sc",
    "font:subset:tc": "NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/build-subsets.ts tc",
    "font:subset:jp": "NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/build-subsets.ts jp",
    "font:subset:display": "NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/build-subsets.ts display",
    "font:subset:display-italic": "NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/build-subsets.ts display-italic",
    "font:subset": "npm run font:extract && NODE_OPTIONS=--experimental-strip-types node scripts/font-subset/build-subsets.ts",
    "avatar:cache": "NODE_OPTIONS=--experimental-strip-types node scripts/cache-minecraft-avatars.ts",
    "social-card:build": "NODE_OPTIONS=--experimental-strip-types node scripts/generate-social-card.ts",
    "landing-reflections:generate": "NODE_OPTIONS=--experimental-strip-types node scripts/generate-home-landing-reflection-colors.ts",
    "build:with-fonts": "npm run font:subset && npm run build",
    "test:discovery": "NODE_OPTIONS=--experimental-strip-types node --test test/discovery.test.ts",
    "test:document": "NODE_OPTIONS=--experimental-strip-types node --test test/document-details.test.ts",
    "test:static": "NODE_OPTIONS=--experimental-strip-types node --test test/static-output.test.ts test/discovery-output.test.ts",
    "build": "npm run social-card:build && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "test:home": "NODE_OPTIONS=--experimental-strip-types node --test test/home-tri-server-media.test.ts test/home-image-output.test.ts test/home-landing.test.ts test/home-route-train.test.ts test/home-route-viewport.test.ts test/home-journey.test.ts test/home-community.test.ts test/home-departure-gate.test.ts test/site-header.test.ts",
    "check": "npm run format:check && npm run typecheck && npm run test:discovery && npm run test:document && npm run test:home && npm run build && npm run test:static",
    "precommit:check": "npm run font:subset && git diff --exit-code -- scripts/font-subset/chars.txt src/assets/fonts && npm run check",
    "prepare": "husky"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "^6.0.3"
  }
}
